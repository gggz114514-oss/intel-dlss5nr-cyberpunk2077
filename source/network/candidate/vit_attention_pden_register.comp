#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x=256) in;
#include "vit_common.glsl"
#include "register_handoff.glsl"

// M19 ViT P/den register handoff, distinguished from the failed
// direct-complete package (slow 33.68%) and built on the retained-KV parent
// (S29, 8 sites): the proven sk/sv caches, the Q fragment reuse across key
// chunks and the whole launch/dispatch/push/binding ABI are kept unchanged.
//
// What is removed: the sp[4096] P shared bridge and the den[64] shared cell
// (16512 -> 8192 shared bytes). P never touches memory; the denominator is
// reduced in-lane from the P fragments.
//
// Ownership merge (the one structural change): P for a 16-query block was
// consumed by BOTH SGs of a pair (dims dg=0..15 and 16..31 of the context).
// Registers cannot share across SGs, so the score SG now computes the P
// fragments and the FULL 32-dim context (ctx0..ctx3); the partner SG only
// helps fill sk/sv and retires through the same barriers. PV MMA count per
// chunk is unchanged (4 dim fragments x 4 key pairs); score MMA count is
// unchanged; sk/sv fill work is unchanged.
//
// Preserved contracts, verified line-by-line against the parent:
//   - S^T = K.Q^T orientation and both score MMAs per 8-key block.
//   - MC->MH narrowing before exp; vit_exp per half component.
//   - The original 64-key half den tree: per query, part[d] = j-sequential
//     sum of (P[16j+d]+P[16j+d+8]); even=((p0+p2)+p4)+p6; odd likewise;
//     total=even+odd; den += total per key chunk. On the sealed CH map a
//     lane holds one query column and one key parity, and ph0[ci]+ph1[ci]
//     IS the original (d,d+8) pair, so the tree is reproduced in-lane with
//     one shuffleXor(16) exchange of the odd partial.
//   - Padding keys keep their exp(0) contribution inside the den tree and
//     are zeroed in the P fragment only after den, exactly like the parent's
//     post-den sp zeroing; the pad subtraction (p0.y-p0.x)*vit_exp(0) and
//     the reciprocal 1/max(den,6.198883056640625e-05) stay once per query
//     AFTER all chunks, applied to the context numerator (PV order intact:
//     P is unnormalized into PV; reciprocal position unchanged).
//   - Debug: lg (fp32, dbgf) and ph (half, dbg, AFTER exp like the parent) at
//     the parent addresses via component stores; den/inv debug at the parent
//     per-query address qg+lane with the parent's per-query liveness gate.
//
// v2 fixes vs v1 (GPU numeric gate FAIL 2bc68965/cb1617c4, both deterministic):
//   1. inverse fragment fetch source lane (lane%16)*2 -> lane%16 (the only
//      numeric root cause; 30/32 lanes fetched a wrong or dead-lane inverse).
//   2. den/inv debug address qg+(lane>>1) -> qg+lane + per-query gate.
//   3. debug exponentials stored before exp -> stored after exp (parent order).
// The den tree, the padding exp(0) handling and nrh_join_rows_to_B were
// verified elementwise against the parent on the sealed maps and are untouched.
//
// v3 (M05 merge) vs v2: ONLY the exponent transform form changes. The scalar
// vit_exp loop over ph0/ph1 in the score loop is replaced by four paired
// vit_exp2(f16vec2) calls per kb step (merged from
// c5-alusupply/vit-attention-m05-expair-v1; vit_exp2 added to vit_common.glsl
// verbatim). This resolves the pass conflict with the C5 M05 candidate (both
// replace the same 8 vit-attention passes; the final composite can take one
// core only). Everything else is byte-identical to v2:
//   - 64-key original half den tree (part[c], even/odd, shuffleXor(16));
//   - padding exp(0) subtraction stays a SCALAR vit_exp(0.0) once per query
//     after all chunks (line "precise float16_t pad=...");
//   - den tree order and the v2 inverse fragment lane mapping (lane%16);
//   - nrh_join_rows_to_B, PV order, debug order (ph stored AFTER exp), ABI.
// Bit identity of the paired form is re-derived for the v2 lane layout in
// vit_common.glsl and the merge report; the paired transform is elementwise
// per half component, so the sealed CH map (row=l/16+2*ci, col=l%16) does not
// affect the per-element result.
//
// Barrier budget: parent 5 WG barriers per 64-key chunk + 2 extra; here 2 per
// chunk (sk/sv publication, sk/sv WAR retirement) and none at the end.
#define MH coopmat<float16_t,gl_ScopeSubgroup,8,16,gl_MatrixUseAccumulator>

// Retained proven K/V cache (parent contract); sp[4096] and den[64] are gone.
shared float16_t sk[2048],sv[2048];

void main() {
    uint tid=gl_LocalInvocationID.x,sg=gl_SubgroupID,lane=gl_SubgroupInvocationID;
    uint q0=gl_WorkGroupID.x*64u,h=gl_WorkGroupID.y;
    uint qg=(sg/2u)*16u,dg=(sg%2u)*16u;
    bool score_owner=(sg%2u)==0u;
    // Q fragments: B operands, loaded once per score SG, reused across every
    // key chunk (the retained-KV contract; also the M19 Q/scale reuse basis).
    MB qf0=MB(0.0),qf1=MB(0.0);
    if(score_owner && q0+qg<pc.p0.x) {
        coopMatLoad(qf0,qkv,pc.p6.x+(q0+qg)*3072u+h*32u,3072u,CM);
        coopMatLoad(qf1,qkv,pc.p6.x+(q0+qg)*3072u+h*32u+16u,3072u,CM);
    }
    // Full 32-dim context on the score SG (see ownership merge above).
    MC ctx0=MC(0.0),ctx1=MC(0.0),ctx2=MC(0.0),ctx3=MC(0.0);
    // In-lane denominator: query qg+(lane>>1), key parity lane/16; only even
    // lanes carry the authoritative total after the odd-partial exchange.
    float16_t den=float16_t(0.0);
    for(uint j0=0u;j0<pc.p0.y;j0+=64u) {
        // sk/sv cache fill: unchanged addresses, unchanged zero padding.
        for(uint e=tid;e<2048u;e+=256u) {
            uint t=j0+e/32u,d=h*32u+e%32u;
            sk[e]=t<pc.p0.x ? qkv[pc.p6.x+t*3072u+1024u+d] : float16_t(0.0);
            sv[e]=t<pc.p0.x ? qkv[pc.p6.x+t*3072u+2048u+d] : float16_t(0.0);
        }
        barrier();
        if(score_owner) {
            // Four 16-key blocks; each block = two 8-key score fragments.
            // part[c] is the parent's part[d] for d = lane/16 + 2c; the first
            // pair is assigned directly (no zero add), exactly like the tree.
            precise float16_t part[4];
            bool first=true;
            for(uint kb=0u;kb<64u;kb+=16u) {
                MC lg0=MC(0.0),lg1=MC(0.0);
                {
                    MA kf0,kf1;
                    coopMatLoad(kf0,sk,kb*32u,32u,RM);
                    coopMatLoad(kf1,sk,kb*32u+16u,32u,RM);
                    lg0=coopMatMulAdd(kf0,qf0,lg0);
                    lg0=coopMatMulAdd(kf1,qf1,lg0);
                }
                {
                    MA kf0,kf1;
                    coopMatLoad(kf0,sk,(kb+8u)*32u,32u,RM);
                    coopMatLoad(kf1,sk,(kb+8u)*32u+16u,32u,RM);
                    lg1=coopMatMulAdd(kf0,qf0,lg1);
                    lg1=coopMatMulAdd(kf1,qf1,lg1);
                }
                // MC->MH narrowing and exp: narrowing identical to the parent.
                // M05 merge (from c5-alusupply/vit-attention-m05-expair-v1): the
                // scalar vit_exp loop is replaced by paired vit_exp2 calls —
                // MH holds 4 components per lane, two elementwise pairs per
                // fragment, 4 paired calls per kb step replacing 8 scalar ones.
                // Bit-identical per element (see vit_common.glsl); the den tree,
                // padding handling and all other contracts are untouched.
                MH ph0=MH(lg0),ph1=MH(lg1);
                if(pc.p0.w!=0u && q0+qg<pc.p0.x) {
                    uint at=(h*pc.p0.x+q0+qg)*pc.p0.y+j0+kb;
                    for(uint ci=0u;ci<lg0.length();++ci) {
                        uvec2 rc=nrh_coord_C(ci);
                        dbgf[pc.p6.z/2u+pc.p3.z+at+rc.y*pc.p0.y+rc.x]=lg0[ci];
                        dbgf[pc.p6.z/2u+pc.p3.z+at+8u+rc.y*pc.p0.y+rc.x]=lg1[ci];
                    }
                }
                // M05 paired exponent transform: same values per element as the
                // scalar loops they replace (bit-identical, CH/CH lane map
                // irrelevant — the transform is elementwise per half component).
                {f16vec2 e01=vit_exp2(f16vec2(ph0[0],ph0[1]));ph0[0]=e01.x;ph0[1]=e01.y;
                 f16vec2 e23=vit_exp2(f16vec2(ph0[2],ph0[3]));ph0[2]=e23.x;ph0[3]=e23.y;
                 f16vec2 f01=vit_exp2(f16vec2(ph1[0],ph1[1]));ph1[0]=f01.x;ph1[1]=f01.y;
                 f16vec2 f23=vit_exp2(f16vec2(ph1[2],ph1[3]));ph1[2]=f23.x;ph1[3]=f23.y;}
                // Debug exponentials AFTER exp, exactly like the parent (v1
                // stored the pre-exp values here).
                if(pc.p0.w!=0u && q0+qg<pc.p0.x) {
                    uint at=(h*pc.p0.x+q0+qg)*pc.p0.y+j0+kb;
                    for(uint ci=0u;ci<ph0.length();++ci) {
                        uvec2 rc=nrh_coord_CH(ci);
                        dbg[pc.p6.z+pc.p3.w+at+rc.y*pc.p0.y+rc.x]=ph0[ci];
                        dbg[pc.p6.z+pc.p3.w+at+8u+rc.y*pc.p0.y+rc.x]=ph1[ci];
                    }
                }
                // Denominator: this 16-key block contributes, per query and
                // key parity d, the original pair (P[kb+d]+P[kb+8+d]).
                // Sealed CH map: lane l, comp ci -> (row=l/16+2*ci, col=l%16),
                // so ph0[ci]+ph1[ci] is exactly that pair for key row l/16+2ci.
                for(uint ci=0u;ci<4u;++ci) {
                    precise float16_t pair=ph0[ci]+ph1[ci];
                    part[ci]=first ? pair : part[ci]+pair;
                }
                first=false;
                // Padding keys: keep exp(0) inside den (subtract once at the
                // end), zero only the P fragment before PV, like the parent.
                for(uint ci=0u;ci<ph0.length();++ci) {
                    if(j0+kb+lane/16u+2u*ci>=pc.p0.x) ph0[ci]=float16_t(0.0);
                    if(j0+kb+8u+lane/16u+2u*ci>=pc.p0.x) ph1[ci]=float16_t(0.0);
                }
                // P^T as the B operand with no memory in between.
                NRH_B pf=nrh_join_rows_to_B(ph0,ph1);
                // PV: four dim fragments, K order kb=0,16,32,48 unchanged.
                MA vf0,vf1,vf2,vf3;
                coopMatLoad(vf0,sv,kb*32u+0u,32u,CM);
                coopMatLoad(vf1,sv,kb*32u+8u,32u,CM);
                coopMatLoad(vf2,sv,kb*32u+16u,32u,CM);
                coopMatLoad(vf3,sv,kb*32u+24u,32u,CM);
                ctx0=coopMatMulAdd(vf0,pf,ctx0);
                ctx1=coopMatMulAdd(vf1,pf,ctx1);
                ctx2=coopMatMulAdd(vf2,pf,ctx2);
                ctx3=coopMatMulAdd(vf3,pf,ctx3);
            }
            // Original even/odd tree: this lane's parity partials are
            // part[0..3] for d = lane/16 + 2c; exchange the other parity's
            // total once and add, even first.
            precise float16_t mine=((part[0]+part[1])+part[2])+part[3];
            f16vec2 ex=unpackFloat2x16(subgroupShuffleXor(packFloat2x16(f16vec2(mine,mine)),16u));
            precise float16_t total=(lane/16u==0u) ? mine+ex.x : ex.x+mine;
            if(lane/16u==0u) den=den+total;
        }
        // WAR: next chunk's sk/sv fill must wait for this chunk's reads.
        barrier();
    }
    if(score_owner && q0+qg<pc.p0.x) {
        // Once per query: padding subtraction, original reciprocal, debug.
        // Lane l<16 holds query qg+l (sealed CH col = l%16), so the debug
        // address is qg+lane, gated per query exactly like the parent's
        // q0+tid<pc.p0.x (v1 wrote qg+(lane>>1): 16 lanes onto 8 colliding
        // addresses, queries 8..15 never written).
        if(lane/16u==0u) {
            precise float16_t pad=float16_t(float(pc.p0.y-pc.p0.x)*float(vit_exp(float16_t(0.0))));
            den=den-pad;
            precise float16_t inv=float16_t(1.0/max(float(den),6.198883056640625e-05));
            uint at=h*pc.p0.x+q0+qg+lane;
            if(pc.p0.w!=0u && q0+qg+lane<pc.p0.x) { dbg[pc.p6.z+pc.p4.x+at]=den; dbg[pc.p6.z+pc.p4.z+at]=inv; }
            den=inv;
        }
        // Inverse as an MH fragment: comp ci of lane l must be inv[qg+l%16]
        // (the parent coopMatLoad(den,qg,0,RM) column map). On the sealed CH
        // map col = lane%16, so lane m (m<16) holds query qg+m's reciprocal
        // and the source lane is exactly lane%16 (v1 fetched (lane%16)*2,
        // which reads query 2m for m<8 and a den==0 dead lane -> inv=16132
        // for m>=8; 30 of 32 lanes were wrong).
        uint inv_bits=packFloat2x16(f16vec2(den,den));
        f16vec2 iw=unpackFloat2x16(subgroupShuffle(inv_bits,lane%16u));
        MH inverse;
        for(uint ci=0u;ci<inverse.length();++ci) inverse[ci]=iw.x;
        MH num0=MH(ctx0),num1=MH(ctx1),num2=MH(ctx2),num3=MH(ctx3);
        if(pc.p0.w!=0u) {
            uint at=pc.p6.z+pc.p4.y+(q0+qg)*1024u+h*32u;
            for(uint ci=0u;ci<num0.length();++ci) {
                uvec2 rc=nrh_coord_CH(ci);
                dbg[at+rc.y*1024u+0u+rc.x]=num0[ci];
                dbg[at+rc.y*1024u+8u+rc.x]=num1[ci];
                dbg[at+rc.y*1024u+16u+rc.x]=num2[ci];
                dbg[at+rc.y*1024u+24u+rc.x]=num3[ci];
            }
        }
        precise MH out0=num0*inverse;
        precise MH out1=num1*inverse;
        precise MH out2=num2*inverse;
        precise MH out3=num3*inverse;
        uint at=pc.p6.y+(q0+qg)*1024u+h*32u;
        coopMatStore(out0,context,at,1024u,CM);
        coopMatStore(out1,context,at+8u,1024u,CM);
        coopMatStore(out2,context,at+16u,1024u,CM);
        coopMatStore(out3,context,at+24u,1024u,CM);
    }
}
