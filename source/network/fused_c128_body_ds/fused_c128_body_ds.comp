// F3-C128 fused candidate (f3-c128-fused-half-patch-v1, netorg acceleration 2026-10-16).
// Base: the bound pass-49 body c128_d4_full.comp (sha256 66435c26161b9008, byte-identical raw compile)
// verbatim, plus the pass-50 downsample epilogue inlined at the end.
// Body geometry 22x13x1, shift (-1,-1), token geometry, global stores and
// push words 0..20/27/30/31 are preserved; the DS fields use words
// 21..26/28..29, which the bound body SPV never reads.
// Weight contract: the bound pass-50 kernel ds-f19-paired.spv loads the 16x16
// blocked form woff = whalf + ((n/16)*(K/16) + k/16)*256, stride 16.
// C128 D4 directA+WOtileB+cooperative seed/output: original seed-before-K math and two-accumulator ownership.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;
// diagnostics: NR_D4_SEED_ONLY / NR_D4_MMA_ONLY isolate the two O components
#ifndef NR_D4_MODE
#define NR_D4_MODE 0   // 0 = full, 1 = seed only, 2 = mma only
#endif
shared float16_t nrf_pair[2048u];
shared float16_t nrf_mean[2048u];
shared float16_t nrf_stage[1024u];
#include "c64_c128_common.glsl"

layout(set = 0, binding = 6) buffer YBuf { float16_t gY[]; };
layout(set = 0, binding = 7) buffer TBuf { float16_t gT[]; };
layout(set = 0, binding = 8) buffer DsWeightBuf { float16_t nrf_w[]; };
layout(set = 0, binding = 9) buffer DsOutBuf { float16_t nrf_o[]; };

#define MAT_H coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>

void nr_body_stage() {
    const uint t_local = gl_LocalInvocationID.x;
    const uint sg = t_local / 32u;
    const uint lane = t_local % 32u;
    const uint wx = (pc.p1.z != 0) ? uint(pc.p2.x) : gl_WorkGroupID.x;
    const uint wy = (pc.p1.z != 0) ? uint(pc.p2.y) : gl_WorkGroupID.y;
    const uint w = wy * uint(pc.p1.x) + wx;
    const bool debug = pc.p1.w != 0;
    const uint wo = uint(pc.p4.x);
    const uint ars = uint(pc.p4.z);   // p4.y is rs (used by D2) — ars is p4.z

    if (debug) {
        for (uint e = t_local; e < 8192u; e += 256u) {
            dbg[212992u + e] = gT[w * 8192u + e];
            dbg[81920u + e] = gY[w * 8192u + e];
        }
        barrier();
    }

    for (uint j = 0u; j < 4u; ++j) {
        uint m0 = (sg / 4u + 2u * j) * 8u;
        uint n0 = (sg % 4u) * 32u;
        MAT_C acc0;
        {
            MAT_H seed;
            coopMatLoad(seed, gY, (w * 64u + m0) * 128u + n0, 128u, LROW);
            MAT_H scale;
            coopMatLoad(scale, pack, ars + n0, 0u, LROW);
            seed = seed * scale;
#if NR_D4_MODE == 2
            acc0 = MAT_C(0.0);
#else
            acc0 = MAT_C(seed);
#endif
        }
        MAT_C acc1;
        {
            MAT_H seed;
            coopMatLoad(seed, gY, (w * 64u + m0) * 128u + (n0 + 16u), 128u, LROW);
            MAT_H scale;
            coopMatLoad(scale, pack, ars + (n0 + 16u), 0u, LROW);
            seed = seed * scale;
#if NR_D4_MODE == 2
            acc1 = MAT_C(0.0);
#else
            acc1 = MAT_C(seed);
#endif
        }
        for (uint ki = 0u; ki < 8u; ++ki) {
            uint k0 = ki * 16u;
            MAT_A a;  coopMatLoad(a, gT, (w * 64u + m0) * 128u + k0, 128u, LROW);
            MAT_B b0; coopMatLoad(b0, pack, wo + (n0 / 16u) * 2048u + (k0 / 16u) * 256u, 16u, LCOL);
            MAT_B b1; coopMatLoad(b1, pack, wo + ((n0 + 16u) / 16u) * 2048u + (k0 / 16u) * 256u,
                                  16u, LCOL);
#if NR_D4_MODE != 1
            acc0 = coopMatMulAdd(a, b0, acc0);
            acc1 = coopMatMulAdd(a, b1, acc1);
#endif
        }
        {
            MAT_H narrowed = MAT_H(acc0);
            if (debug)
                coopMatStore(narrowed, dbg, 221184u + m0 * 128u + n0, 128u, LROW);
            bool oob;
            uint addr = c128_img_half_index(m0, n0, wx, wy, oob);
            if (!oob)
                coopMatStore(narrowed, imgout, addr, 16u, LROW);
            coopMatStore(narrowed, nrf_pair, (sg * 2u + 0u) * 128u, 16u, LROW);
        }
        {
            MAT_H narrowed = MAT_H(acc1);
            if (debug)
                coopMatStore(narrowed, dbg, 221184u + m0 * 128u + (n0 + 16u), 128u, LROW);
            bool oob;
            uint addr = c128_img_half_index(m0, (n0 + 16u), wx, wy, oob);
            if (!oob)
                coopMatStore(narrowed, imgout, addr, 16u, LROW);
            coopMatStore(narrowed, nrf_pair, (sg * 2u + 1u) * 128u, 16u, LROW);
        }

        // ---- F3-C128 fused epilogue: this j's 2x2 mean --------------------
        // subgroup (R = sg>>2, n0 = (sg%4)*32) owns 32 channels of the fragment
        // whose eight rows are the tile slots 8R + r; j fixes the tile
        // (sx1, sy1) = (j&1, j>>1), so dy = R and the pooled pixel reads rows
        // 2dx + {0,1,4,5} of the fragment pair.
        subgroupBarrier();
        {
            const uint ch  = lane & 15u;
            const uint acc = lane >> 4u;          // fragment channels n0/n0+16
            const uint R   = sg >> 2u;            // slot half == pooled row in tile
            const uint sx1 = j & 1u;
            const uint sy1 = j >> 1u;
            const uint kk  = (sg % 4u) * 32u + acc * 16u + ch;
            const uint base = (sg * 2u + acc) * 128u;
            const int  tx = 2 * int(wx) + pc.p0.z + int(sx1);
            const int  ty = 2 * int(wy) + pc.p0.w + int(sy1);
            const bool tile_ok = (tx >= 0) && (ty >= 0) &&
                                 (tx < pc.p0.x) && (ty < pc.p0.y);
            for (uint dx = 0u; dx < 2u; ++dx) {
                const uint r0 = 2u * dx;
                const uint px = 4u * wx - 2u + 2u * sx1 + dx;
                const int  py = 4 * int(wy) - 2 + 2 * int(sy1) + int(R);
                const uint ly = 2u * sy1 + R;
                const uint lx = 2u * sx1 + dx;
                precise float16_t v = float16_t(0);
                if (tile_ok && px < uint(pc.p7.x) && py >= 0 &&
                    uint(py) < uint(pc.p7.y) && uint(py) < uint(pc.p5.z)) {
                    precise float16_t a  = nrf_pair[base + r0 * 16u + ch];
                    precise float16_t b  = nrf_pair[base + (r0 + 1u) * 16u + ch];
                    precise float16_t cc = nrf_pair[base + (r0 + 4u) * 16u + ch];
                    precise float16_t dd = nrf_pair[base + (r0 + 5u) * 16u + ch];
                    precise float16_t top = a + b;
                    precise float16_t bottom = cc + dd;
                    precise float16_t sum = top + bottom;
                    v = sum * float16_t(0.25);
                }
                nrf_mean[(4u * ly + lx) * uint(pc.p6.x) + kk] = v;
            }
        }
        subgroupBarrier();
    }
}

// ---------------------------------------------------------------------------
// F3-C128 fusion scratch.
//   nrf_pair  : this iteration's two body fragments per subgroup (2 x 128 halfs).
//   nrf_mean  : the pooled tile, [16 slots][K] with stride K.
//   nrf_stage : the projection fragment staging (one 8x16 fragment per subgroup).
// The address helper is a verbatim copy of ioport_common.glsl io_at().
// ---------------------------------------------------------------------------

uint nrf_ds_at(uint px,uint py,uint c,uint W,uint H,uint C,uint layout_id) {
    if(layout_id==2u)return (py*W+px)*C+c;
    if(layout_id==3u) {
        uint sub=(c&1u)|((c>>3u&1u)<<1u)|((c>>1u&1u)<<2u)|((c>>2u&1u)<<3u);
        return (c/16u)*(W*H*16u)+(py*W+px)*16u+sub;
    }
    uint t=layout_id==1u?py*W+px:((py/4u)*(W/4u)+px/4u)*16u+4u*(py%4u)+px%4u;
    return ((t/16u)*(C/16u)+c/16u)*256u+(t%16u)*16u+c%16u;
}

// the parent DS's own output write pattern (lane%16 = channel, lane/16 = pixel),
// with the address computed per element: the fused workgroup owns a 4x4 pooled
// patch, so the parent's eight-raster-token M8 fragment is not reproducible, and
// the elements outside the 84x48 view are skipped exactly as the parent DS
// writes only that view.
void nrf_write_group(uint group, int px0i, int py0i, uint OW, uint OH, uint N,
                     uint obase, uint sg, uint lane) {
    for (uint i = lane; i < 128u; i += 32u) {
        uint m = i >> 4u, c = i & 15u;
        int px = px0i + int(m & 3u);
        int py = py0i + int(m >> 2u);
        if (px < 0 || py < 0 || uint(px) >= OW || uint(py) >= OH) continue;
        nrf_o[obase + nrf_ds_at(uint(px), uint(py), group * 16u + c, OW, OH, N, 0u)] =
            nrf_stage[sg * 128u + i];
    }
}

void main() {
    nr_body_stage();
    barrier();
    const uint tid  = gl_LocalInvocationID.x;
    const uint sg   = tid / 32u;
    const uint lane = tid % 32u;
    const uint wx = (pc.p1.z != 0u) ? uint(pc.p2.x) : gl_WorkGroupID.x;
    const uint wy = (pc.p1.z != 0u) ? uint(pc.p2.y) : gl_WorkGroupID.y;
    const uint OW = uint(pc.p5.y), OH = uint(pc.p5.z), N = uint(pc.p5.w), K = uint(pc.p6.x);
    const uint whalf = uint(pc.p6.y), obase = uint(pc.p6.z);
    const uint sy = sg & 1u;                 // pooled row half
    const uint cb = sg >> 1u;                // 64-output-channel group (4 groups)
    const uint rowbase = 8u * sy;
    const int  px0 = 4 * int(wx) - 2;
    const int  py0 = 4 * int(wy) - 2 + 2 * int(sy);
    {
        const uint nb0 = cb * 4u;                 // four output-channel blocks of 16
        coopmat<float,gl_ScopeSubgroup,8,16,gl_MatrixUseAccumulator> acc0 =
            coopmat<float,gl_ScopeSubgroup,8,16,gl_MatrixUseAccumulator>(0.0);
        coopmat<float,gl_ScopeSubgroup,8,16,gl_MatrixUseAccumulator> acc1 =
            coopmat<float,gl_ScopeSubgroup,8,16,gl_MatrixUseAccumulator>(0.0);
        coopmat<float,gl_ScopeSubgroup,8,16,gl_MatrixUseAccumulator> acc2 =
            coopmat<float,gl_ScopeSubgroup,8,16,gl_MatrixUseAccumulator>(0.0);
        coopmat<float,gl_ScopeSubgroup,8,16,gl_MatrixUseAccumulator> acc3 =
            coopmat<float,gl_ScopeSubgroup,8,16,gl_MatrixUseAccumulator>(0.0);
        for (uint k = 0u; k < K; k += 16u) {
            coopmat<float16_t,gl_ScopeSubgroup,8,16,gl_MatrixUseA> aa;
            coopMatLoad(aa, nrf_mean, rowbase * K + k, K, gl_CooperativeMatrixLayoutRowMajor);
            coopmat<float16_t,gl_ScopeSubgroup,16,16,gl_MatrixUseB> bb;
            coopMatLoad(bb, nrf_w, whalf + ((nb0 + 0u) * (K / 16u) + k / 16u) * 256u, 16u,
                        gl_CooperativeMatrixLayoutColumnMajor);
            acc0 = coopMatMulAdd(aa, bb, acc0);
            coopMatLoad(bb, nrf_w, whalf + ((nb0 + 1u) * (K / 16u) + k / 16u) * 256u, 16u,
                        gl_CooperativeMatrixLayoutColumnMajor);
            acc1 = coopMatMulAdd(aa, bb, acc1);
            coopMatLoad(bb, nrf_w, whalf + ((nb0 + 2u) * (K / 16u) + k / 16u) * 256u, 16u,
                        gl_CooperativeMatrixLayoutColumnMajor);
            acc2 = coopMatMulAdd(aa, bb, acc2);
            coopMatLoad(bb, nrf_w, whalf + ((nb0 + 3u) * (K / 16u) + k / 16u) * 256u, 16u,
                        gl_CooperativeMatrixLayoutColumnMajor);
            acc3 = coopMatMulAdd(aa, bb, acc3);
        }
        {
            MAT_H h = MAT_H(acc0);
            coopMatStore(h, nrf_stage, sg * 128u, 16u, gl_CooperativeMatrixLayoutRowMajor);
        }
        subgroupBarrier();
        nrf_write_group(nb0 + 0u, px0, py0, OW, OH, N, obase, sg, lane);
        subgroupBarrier();
        {
            MAT_H h = MAT_H(acc1);
            coopMatStore(h, nrf_stage, sg * 128u, 16u, gl_CooperativeMatrixLayoutRowMajor);
        }
        subgroupBarrier();
        nrf_write_group(nb0 + 1u, px0, py0, OW, OH, N, obase, sg, lane);
        subgroupBarrier();
        {
            MAT_H h = MAT_H(acc2);
            coopMatStore(h, nrf_stage, sg * 128u, 16u, gl_CooperativeMatrixLayoutRowMajor);
        }
        subgroupBarrier();
        nrf_write_group(nb0 + 2u, px0, py0, OW, OH, N, obase, sg, lane);
        subgroupBarrier();
        {
            MAT_H h = MAT_H(acc3);
            coopMatStore(h, nrf_stage, sg * 128u, 16u, gl_CooperativeMatrixLayoutRowMajor);
        }
        subgroupBarrier();
        nrf_write_group(nb0 + 3u, px0, py0, OW, OH, N, obase, sg, lane);
        subgroupBarrier();
    }
}
