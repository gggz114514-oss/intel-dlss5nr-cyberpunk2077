#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x=256) in;
#include "split16_common.glsl"
// Fragment epilogue: one half narrowing of the FP32 accumulator after the
// whole K loop (the same shape S20 uses).
#define MH coopmat<float16_t,gl_ScopeSubgroup,8,16,gl_MatrixUseAccumulator>
// KIND 0 ffwd residual, 1 attention projection, 2 projection+pool,
// 3 finalhead, 4 projection+outview. 24,576 bytes shared (pool staging included).
#ifndef KIND
#define KIND 0
#endif
// F12-A: sx deleted; the K16 A fragments load the predecessor tiled layout directly
uint token_at(uint s) {
#if KIND==1 || KIND==2 || KIND==4
    return spatial_token(gl_WorkGroupID.x,s);
#else
    return gl_WorkGroupID.x*16u+s;
#endif
}
// parent KIND3 address: block token -> (Px,Py) in the 4x4 tile -> canonical
// raster row index.  Kept verbatim from the parent (v4 fix: tile alone collapses
// the 16 slots of a tile onto one pixel).
void gh_store(uint t,uint c,float16_t v) {
    uint tile=t/16u,slot=t%16u;
    uint Px=(tile%uint(pc.p7.x/4u))*4u+slot%4u;
    uint Py=(tile/uint(pc.p7.x/4u))*4u+slot/4u;
    gh[(Py*pc.p7.x+Px)*1024u+c]=v;
}
void main() {
    uint lid=gl_LocalInvocationID.x,sg=lid/32u,lane=lid%32u,ng=gl_WorkGroupID.y;
    // F12-A: sx staging loop and WG barrier deleted
    uint m0=sg/4u*8u,n0=(sg%4u)*32u,base=ng*128u+n0;
#if KIND==0
    uint wb=uint(pc.p2.w),rs=uint(pc.p3.x);
#elif KIND==3
    uint wb=uint(pc.p4.z),rs=0u;
#else
    uint wb=uint(pc.p3.z),rs=uint(pc.p3.w);
#endif
    MC acc0=MC(0.0),acc1=MC(0.0);
#if KIND!=3
    for(uint side=0u;side<2u;side++) {
        for(uint e=lane;e<128u;e+=32u) {
            uint t=token_at(m0+e/16u),c=base+side*16u+e%16u;
#if KIND==0
            precise float16_t seed=input_value(t,c)*weights[rs+c];
#else
            precise float16_t seed=gy[tiled(t,c,512u)]*weights[rs+c];
#endif
            scratch[sg*128u+e]=float(seed);
        }
        subgroupMemoryBarrierShared();subgroupBarrier();
        if(side==0u) coopMatLoad(acc0,scratch,sg*128u,16u,ROW);
        else coopMatLoad(acc1,scratch,sg*128u,16u,ROW);
        subgroupMemoryBarrierShared();subgroupBarrier();
    }
#endif
    for(uint k=0u;k<512u;k+=16u) {
        MA a;MB b0,b1;
        coopMatLoad(a,gp,tiled(token_at(m0),k,512u),16u,ROW);  // F12-A: standard K16 load of the predecessor tiled layout
        coopMatLoad(b0,weights,wb+base*512u+k,512u,COL);
        coopMatLoad(b1,weights,wb+(base+16u)*512u+k,512u,COL);
        acc0=coopMatMulAdd(a,b0,acc0);acc1=coopMatMulAdd(a,b1,acc1);
    }
    // NR_EPI_FRAGMENT (B580), KIND3: one MH narrowing per side, then the four
    // literal components are written per SG lane to the original canonical raster
    // address.  Intel sealed CH map: lane lv, component i -> (row = 2*i + (lv>>4),
    // col = lv&15); rows are tokens (token_at(m0+row)), cols are the global
    // channels base+16*side+col.  No dynamic coopmat index, no fixed stride: the
    // M8 fragment spans two 4-pixel rows, so each component keeps the parent's
    // block-token -> Px/Py -> canonical raster conversion (gh_store).
    for(uint side=0u;side<2u;side++) {
        MH h;
        if(side==0u) h=MH(acc0); else h=MH(acc1);
        uint lv=gl_SubgroupInvocationID;
        uint rp=lv>>4u;
        uint c=base+16u*side+(lv&15u);
        gh_store(token_at(m0+0u+rp),c,h[0]);
        gh_store(token_at(m0+2u+rp),c,h[1]);
        gh_store(token_at(m0+4u+rp),c,h[2]);
        gh_store(token_at(m0+6u+rp),c,h[3]);
    }
}
