// C128 D4 directA+WOtileB+cooperative seed/output: original seed-before-K math and two-accumulator ownership.
// n06-f06-output candidate: 2x2 M/N register blocking. One weight pair (b0,b1) is loaded once
// and consumed by two *adjacent* 8-row M blocks, so
//   - the pair's A reads sweep one contiguous 16x128 half token slab
//     (second M block = first + 8 rows = +1024 halves = +2048 B),
//   - the pair's two narrowed output tiles complete one 256-half image store block
//     (s=0..7 and s=8..15 of the same (tx,ty,channel-block)),
//   - the weight pair is one n-block base with a constant +2048 half (+4096 B) offset.
// Per-output K accumulation order, seed-before-K math, half rounding points, store domain,
// grid and bindings are unchanged.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;
// diagnostics: NR_D4_SEED_ONLY / NR_D4_MMA_ONLY isolate the two O components
#ifndef NR_D4_MODE
#define NR_D4_MODE 0   // 0 = full, 1 = seed only, 2 = mma only
#endif
#include "c64_c128_common.glsl"

layout(set = 0, binding = 6) buffer YBuf { float16_t gY[]; };
layout(set = 0, binding = 7) buffer TBuf { float16_t gT[]; };

#define MAT_H coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>

void main() {
    const uint t_local = gl_LocalInvocationID.x;
    const uint sg = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const uint wx = (pc.p1.z != 0) ? uint(pc.p2.x) : gl_WorkGroupID.x;
    const uint wy = (pc.p1.z != 0) ? uint(pc.p2.y) : gl_WorkGroupID.y;
    const uint w = wy * uint(pc.p1.x) + wx;
    const bool debug = pc.p1.w != 0;
    const uint wo = uint(pc.p4.x);
    const uint ars = uint(pc.p4.z);   // p4.y is rs (used by D2) — ars is p4.z

    if (debug) {
        for (uint e = t_local; e < 8192u; e += 256u) {
            dbg[212992u + e] = gT[w * 8192u + e];
            dbg[81920u + e] = gY[w * 8192u + e];
        }
        barrier();
    }

    const uint n0 = (sg % 4u) * 32u;
    MAT_H scale0, scale1;
    float16_t gain_scale0=pack[(ars + n0)+(lane & 15u)];
    for(int component=0;component<scale0.length();++component) scale0[component]=gain_scale0;
    float16_t gain_scale1=pack[(ars + (n0 + 16u))+(lane & 15u)];
    for(int component=0;component<scale1.length();++component) scale1[component]=gain_scale1;
    // 2x2 blocking over (2 adjacent M blocks) x (2 weight n-blocks).
    // sg/4 selects the 32-token half, jp selects one 16-token pair inside it.
    for (uint jp = 0u; jp < 2u; ++jp) {
        uint m0 = (sg / 4u) * 32u + 16u * jp;      // first M block (8 rows), 16-aligned
        uint aBase = (w * 64u + m0) * 128u;        // contiguous 16x128 half slab for the pair
        uint bBase = wo + (n0 / 16u) * 2048u;      // weight n-block base; n-block+1 = +2048
        MAT_C acc00, acc01;
        {
            MAT_H seed;
            coopMatLoad(seed, gY, aBase + n0, 128u, LROW);
            seed = seed * scale0;
#if NR_D4_MODE == 2
            acc00 = MAT_C(0.0);
#else
            acc00 = MAT_C(seed);
#endif
        }
        {
            MAT_H seed;
            coopMatLoad(seed, gY, aBase + (n0 + 16u), 128u, LROW);
            seed = seed * scale1;
#if NR_D4_MODE == 2
            acc01 = MAT_C(0.0);
#else
            acc01 = MAT_C(seed);
#endif
        }
        MAT_C acc10, acc11;
        {
            MAT_H seed;
            coopMatLoad(seed, gY, aBase + 1024u + n0, 128u, LROW);
            seed = seed * scale0;
#if NR_D4_MODE == 2
            acc10 = MAT_C(0.0);
#else
            acc10 = MAT_C(seed);
#endif
        }
        {
            MAT_H seed;
            coopMatLoad(seed, gY, aBase + 1024u + (n0 + 16u), 128u, LROW);
            seed = seed * scale1;
#if NR_D4_MODE == 2
            acc11 = MAT_C(0.0);
#else
            acc11 = MAT_C(seed);
#endif
        }
        for (uint ki = 0u; ki < 8u; ++ki) {
            uint k0 = ki * 16u;
            MAT_A a0;  coopMatLoad(a0, gT, aBase + k0, 128u, LROW);
            MAT_A a1;  coopMatLoad(a1, gT, aBase + 1024u + k0, 128u, LROW);
            MAT_B b0; coopMatLoad(b0, pack, bBase + (k0 / 16u) * 256u, 16u, LCOL);
            MAT_B b1; coopMatLoad(b1, pack, bBase + 2048u + (k0 / 16u) * 256u,
                                  16u, LCOL);
#if NR_D4_MODE != 1
            // Each weight tile is retired after two consecutive DPAS (b0 then b1):
            // the return window of b1 must not wait for the last user of b0.
            acc00 = coopMatMulAdd(a0, b0, acc00);
            acc10 = coopMatMulAdd(a1, b0, acc10);
            acc01 = coopMatMulAdd(a0, b1, acc01);
            acc11 = coopMatMulAdd(a1, b1, acc11);
#endif
        }
        {
            MAT_H narrowed = MAT_H(acc00);
            if (debug)
                coopMatStore(narrowed, dbg, 221184u + m0 * 128u + n0, 128u, LROW);
            bool oob;
            uint addr = c128_img_half_index(m0, n0, wx, wy, oob);
            if (!oob)
                coopMatStore(narrowed, imgout, addr, 16u, LROW);
        }
        {
            MAT_H narrowed = MAT_H(acc01);
            if (debug)
                coopMatStore(narrowed, dbg, 221184u + m0 * 128u + (n0 + 16u), 128u, LROW);
            bool oob;
            uint addr = c128_img_half_index(m0, (n0 + 16u), wx, wy, oob);
            if (!oob)
                coopMatStore(narrowed, imgout, addr, 16u, LROW);
        }
        {
            MAT_H narrowed = MAT_H(acc10);
            if (debug)
                coopMatStore(narrowed, dbg, 221184u + (m0 + 8u) * 128u + n0, 128u, LROW);
            bool oob;
            uint addr = c128_img_half_index(m0 + 8u, n0, wx, wy, oob);
            if (!oob)
                coopMatStore(narrowed, imgout, addr, 16u, LROW);
        }
        {
            MAT_H narrowed = MAT_H(acc11);
            if (debug)
                coopMatStore(narrowed, dbg, 221184u + (m0 + 8u) * 128u + (n0 + 16u), 128u, LROW);
            bool oob;
            uint addr = c128_img_half_index(m0 + 8u, (n0 + 16u), wx, wy, oob);
            if (!oob)
                coopMatStore(narrowed, imgout, addr, 16u, LROW);
        }
    }
}
