// Full contract transport:existing Mpair;new WCtileB/cooperative half seed;original K/rounding.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;
#include "b3_03_swin_c256_d2_common.glsl"

layout(set = 0, binding = 5) buffer MBuf { float16_t gM[]; };
layout(set = 0, binding = 6) buffer YBuf { float16_t gY[]; };

shared float16_t shM[16384];
#define MAT_H coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>

void main() {
    const uint t_local = gl_LocalInvocationID.x;
    const uint sg = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const uint wx = (pc.p1.z != 0) ? uint(pc.p2.x) : gl_WorkGroupID.x;
    const uint wy = (pc.p1.z != 0) ? uint(pc.p2.y) : gl_WorkGroupID.y;
    const uint w = wy * uint(pc.p1.x) + wx;
    const bool debug = pc.p1.w != 0;
    const uint rs = uint(pc.p4.y);   // valid rs halves (base already +8)

    for (uint e = t_local; e < 16384u; e += 256u)
        shM[e] = gM[w * 16384u + e];
    barrier();

    const uint wc = uint(pc.p3.z);
    for (uint r = 0u; r < 4u; ++r) {
        uint mA = (sg / 8u + 2u * r) * 8u;
        uint mB = mA + 8u;
        uint n0 = (sg % 8u) * 32u;
        const uint bbase0 = wc + (n0 / 16u) * 4096u;
        const uint bbase1 = wc + ((n0 + 16u) / 16u) * 4096u;
        const uint abaseA = mA * 256u;
        const uint abaseB = mB * 256u;
        MAT_C accA0;
        {
            bool oob;
            uint addr = c256_img_half_index(mA, n0, wx, wy, oob);
            MAT_H seed;
            if (oob) seed = MAT_H(float16_t(0.0));
            else coopMatLoad(seed, imgin, addr, 16u, LROW);
            MAT_H scale;
            coopMatLoad(scale, pack, rs + n0, 0u, LROW);
            seed = seed * scale;
            accA0 = MAT_C(seed);
        }
        MAT_C accA1;
        {
            bool oob;
            uint addr = c256_img_half_index(mA, (n0 + 16u), wx, wy, oob);
            MAT_H seed;
            if (oob) seed = MAT_H(float16_t(0.0));
            else coopMatLoad(seed, imgin, addr, 16u, LROW);
            MAT_H scale;
            coopMatLoad(scale, pack, rs + (n0 + 16u), 0u, LROW);
            seed = seed * scale;
            accA1 = MAT_C(seed);
        }
        MAT_C accB0;
        {
            bool oob;
            uint addr = c256_img_half_index(mB, n0, wx, wy, oob);
            MAT_H seed;
            if (oob) seed = MAT_H(float16_t(0.0));
            else coopMatLoad(seed, imgin, addr, 16u, LROW);
            MAT_H scale;
            coopMatLoad(scale, pack, rs + n0, 0u, LROW);
            seed = seed * scale;
            accB0 = MAT_C(seed);
        }
        MAT_C accB1;
        {
            bool oob;
            uint addr = c256_img_half_index(mB, (n0 + 16u), wx, wy, oob);
            MAT_H seed;
            if (oob) seed = MAT_H(float16_t(0.0));
            else coopMatLoad(seed, imgin, addr, 16u, LROW);
            MAT_H scale;
            coopMatLoad(scale, pack, rs + (n0 + 16u), 0u, LROW);
            seed = seed * scale;
            accB1 = MAT_C(seed);
        }
        for (uint ki = 0u; ki < 16u; ++ki) {
            uint k0 = ki * 16u;
            MAT_B wb0; coopMatLoad(wb0, pack, bbase0 + ki * 256u, 16u, LCOL);
            MAT_B wb1; coopMatLoad(wb1, pack, bbase1 + ki * 256u, 16u, LCOL);
            MAT_A a; coopMatLoad(a, shM, abaseA + k0, 256u, LROW);
            accA0 = coopMatMulAdd(a, wb0, accA0);
            accA1 = coopMatMulAdd(a, wb1, accA1);
            coopMatLoad(a, shM, abaseB + k0, 256u, LROW);
            accB0 = coopMatMulAdd(a, wb0, accB0);
            accB1 = coopMatMulAdd(a, wb1, accB1);
        }
        {
            MAT_H narrowed = MAT_H(accA0);
            coopMatStore(narrowed, gY, (w * 64u + mA) * 256u + n0, 256u, LROW);
            if (debug)
                coopMatStore(narrowed, dbg, 163840u + mA * 256u + n0, 256u, LROW);
        }
        {
            MAT_H narrowed = MAT_H(accA1);
            coopMatStore(narrowed, gY, (w * 64u + mA) * 256u + (n0 + 16u), 256u, LROW);
            if (debug)
                coopMatStore(narrowed, dbg, 163840u + mA * 256u + (n0 + 16u), 256u, LROW);
        }
        {
            MAT_H narrowed = MAT_H(accB0);
            coopMatStore(narrowed, gY, (w * 64u + mB) * 256u + n0, 256u, LROW);
            if (debug)
                coopMatStore(narrowed, dbg, 163840u + mB * 256u + n0, 256u, LROW);
        }
        {
            MAT_H narrowed = MAT_H(accB1);
            coopMatStore(narrowed, gY, (w * 64u + mB) * 256u + (n0 + 16u), 256u, LROW);
            if (debug)
                coopMatStore(narrowed, dbg, 163840u + mB * 256u + (n0 + 16u), 256u, LROW);
        }
    }
}
