// Block30 qT producer: one element per invocation, same rounding rule as the
// existing qX producer (int8(clamp(roundEven(float(half)*inv),-127,127))).
// T is in the tiled layout; qT keeps the identical flat prefix (1056 tokens =
// 66*16, so tiled indices for t<1056 are exactly the first 540672 elements).
#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_8bit_storage : require
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer In { float16_t gt[]; };
layout(set = 0, binding = 1) buffer Out { int8_t qt[]; };
layout(push_constant) uniform PC {
    uint n;
    float inv;
    uint base;
    uint pad;
} pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    float v = float(gt[pc.base + i]);
    qt[i] = int8_t(clamp(roundEven(v * pc.inv), -127.0, 127.0));
}
