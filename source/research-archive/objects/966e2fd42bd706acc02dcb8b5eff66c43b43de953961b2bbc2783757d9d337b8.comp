// block56_swin_body_2 (F18 C128 contract) - n24-s5-gm-fold CANDIDATE (consumer side).
//
// Parent: fullnet-mechanism-transfer-20261026/contract-scale-fragments/family/
//         c128/candidate.comp  (spv ffde3c3d2379…, PASS ordinal 194)
// Only the two gM A-fragment loads changed (address step + row stride). The
// seeds, the weight loads, the dpas order, the epilogue narrowing, the gY and
// debug stores and the push-constant ABI are byte-identical to the parent.
//
// FOLDED gM LAYOUT (must match candidate-193.comp exactly):
//   element (w, t, c)   w<264 window, t<64 token, c<128 channel
//     ->  w*8192 + (t/8)*1024 + (c/16)*128 + (t%8)*16 + (c%16)
//   Tile (w, tr, tc) base = w*8192 + tr*1024 + tc*128 halves; inside the tile
//   the 8x16 halves are row-major with row stride 16 halves (32 B), so one A
//   tile is a single contiguous 256 B run.
//
//   With mA, mB multiples of 8 and k0 = 16*ki:
//     folded(A) = w*8192 + (mA/8)*1024 + (k0/16)*128 = (w*64+mA)*128 + k0*8
//   so abaseA/abaseB keep their parent value and only the k term changes
//   (k0 -> k0*8) together with the row stride (128 -> 16).  Fragment element
//   (i,j) therefore still receives gM element (w, mA+i, k0+j): the load is the
//   same 8x16 tile of the same logical matrix, only fetched as one block.
//
// Full contract transport:existing Mpair;new WCtileB/cooperative half seed;original K/rounding.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;
#include "b3_03_swin_c128_d2_common.glsl"

layout(set = 0, binding = 5) buffer MBuf { float16_t gM[]; };
layout(set = 0, binding = 6) buffer YBuf { float16_t gY[]; };

#define MAT_H coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>

void main() {
    const uint t_local = gl_LocalInvocationID.x;
    const uint sg = t_local / 32u;
    const uint lane = t_local % 32u;
    const uint wx = (pc.p1.z != 0) ? uint(pc.p2.x) : gl_WorkGroupID.x;
    const uint wy = (pc.p1.z != 0) ? uint(pc.p2.y) : gl_WorkGroupID.y;
    const uint w = wy * uint(pc.p1.x) + wx;
    const bool debug = pc.p1.w != 0;
    const uint rs = uint(pc.p4.y);   // valid rs halves (base already +8)

    const uint wc = uint(pc.p3.z);
    const uint n0 = (sg % 4u) * 32u;
    MAT_H scale0, scale1;
    float16_t gain0=pack[rs+n0+(lane & 15u)];
    float16_t gain1=pack[rs+n0+16u+(lane & 15u)];
    for(int ci=0;ci<scale0.length();++ci) { scale0[ci]=gain0; scale1[ci]=gain1; }
    for (uint r = 0u; r < 2u; ++r) {
        uint mA = (sg / 4u + 4u * r) * 8u;
        uint mB = mA + 16u;
        const uint bbase0 = wc + (n0 / 16u) * 2048u;
        const uint bbase1 = wc + ((n0 + 16u) / 16u) * 2048u;
        const uint abaseA = (w * 64u + mA) * 128u;
        const uint abaseB = (w * 64u + mB) * 128u;
        MAT_C accA0;
        {
            bool oob;
            uint addr = c128_img_half_index(mA, n0, wx, wy, oob);
            MAT_H seed;
            if (oob) seed = MAT_H(float16_t(0.0));
            else coopMatLoad(seed, imgin, addr, 16u, LROW);
            seed = seed * scale0;
            accA0 = MAT_C(seed);
        }
        MAT_C accA1;
        {
            bool oob;
            uint addr = c128_img_half_index(mA, (n0 + 16u), wx, wy, oob);
            MAT_H seed;
            if (oob) seed = MAT_H(float16_t(0.0));
            else coopMatLoad(seed, imgin, addr, 16u, LROW);
            seed = seed * scale1;
            accA1 = MAT_C(seed);
        }
        MAT_C accB0;
        {
            bool oob;
            uint addr = c128_img_half_index(mB, n0, wx, wy, oob);
            MAT_H seed;
            if (oob) seed = MAT_H(float16_t(0.0));
            else coopMatLoad(seed, imgin, addr, 16u, LROW);
            seed = seed * scale0;
            accB0 = MAT_C(seed);
        }
        MAT_C accB1;
        {
            bool oob;
            uint addr = c128_img_half_index(mB, (n0 + 16u), wx, wy, oob);
            MAT_H seed;
            if (oob) seed = MAT_H(float16_t(0.0));
            else coopMatLoad(seed, imgin, addr, 16u, LROW);
            seed = seed * scale1;
            accB1 = MAT_C(seed);
        }
        for (uint ki = 0u; ki < 8u; ++ki) {
            uint k0 = ki * 16u;
            MAT_B wb0; coopMatLoad(wb0, pack, bbase0 + ki * 256u, 16u, LCOL);
            MAT_B wb1; coopMatLoad(wb1, pack, bbase1 + ki * 256u, 16u, LCOL);
            MAT_A a; coopMatLoad(a, gM, abaseA + k0 * 8u, 16u, LROW);
            accA0 = coopMatMulAdd(a, wb0, accA0);
            accA1 = coopMatMulAdd(a, wb1, accA1);
            coopMatLoad(a, gM, abaseB + k0 * 8u, 16u, LROW);
            accB0 = coopMatMulAdd(a, wb0, accB0);
            accB1 = coopMatMulAdd(a, wb1, accB1);
        }
        {
            MAT_H narrowed = MAT_H(accA0);
            coopMatStore(narrowed, gY, (w * 64u + mA) * 128u + n0, 128u, LROW);
            if (debug)
                coopMatStore(narrowed, dbg, 81920u + mA * 128u + n0, 128u, LROW);
        }
        {
            MAT_H narrowed = MAT_H(accA1);
            coopMatStore(narrowed, gY, (w * 64u + mA) * 128u + (n0 + 16u), 128u, LROW);
            if (debug)
                coopMatStore(narrowed, dbg, 81920u + mA * 128u + (n0 + 16u), 128u, LROW);
        }
        {
            MAT_H narrowed = MAT_H(accB0);
            coopMatStore(narrowed, gY, (w * 64u + mB) * 128u + n0, 128u, LROW);
            if (debug)
                coopMatStore(narrowed, dbg, 81920u + mB * 128u + n0, 128u, LROW);
        }
        {
            MAT_H narrowed = MAT_H(accB1);
            coopMatStore(narrowed, gY, (w * 64u + mB) * 128u + (n0 + 16u), 128u, LROW);
            if (debug)
                coopMatStore(narrowed, dbg, 81920u + mB * 128u + (n0 + 16u), 128u, LROW);
        }
    }
}
