    uint tw = rw / 4u;
    uint x = (t / 16u % tw) * 4u + t % 4u;
    uint y = (t / 16u / tw) * 4u + t % 16u / 4u;
    uint p = (c / 16u) * rw * rh + y * rw + x;
    uint sc = p / (pc.W * pc.H) * 16u + c % 16u;
    uint pixel = p % (pc.W * pc.H);
