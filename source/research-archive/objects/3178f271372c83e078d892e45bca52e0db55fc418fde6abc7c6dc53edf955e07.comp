#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x=256) in;
#include "pilot_common.glsl"
void finish(ACC a,uint m,uint n,uint seedBase,bool oob,uint w,float s,float rs) {
    dumpdot(a,40960u,m,n,128u);
    MF f=MF(a);
    MQ seed;
    if(oob)seed=MQ(QT(0));
    else coopMatLoad(seed,gx,seedBase+n*8u,8u,COL);
    MF seedf=MF(seed);
    for(int i=0;i<f.length();++i) {
        precise float realv=f[i]*s;
        precise float residual=seedf[i]*rs;
        precise float result=realv+residual;
        f[i]=result;
    }
    // Existing D3 attention consumes this same FP16 ABI. Internal FFN mid is
    // native INT8 in C, and there is no separate dequant/repack dispatch.
    MH h=MH(f);
    coopMatStore(h,gy,(w*64u+m)*128u+n,128u,ROW);
}
void main() {
    uint sg=gl_LocalInvocationID.x/32u,wx=gl_WorkGroupID.x,wy=gl_WorkGroupID.y;
    uint w=wy*uint(pc.p1.x)+wx;
    const uint n0=(sg%4u)*32u;
    const float cScale0=nr_scale_column(656u+n0);
    const float cScale1=nr_scale_column(656u+n0+16u);
    const float rsf0=nr_scale_column(784u+n0);
    const float rsf1=nr_scale_column(784u+n0+16u);
    const float rs0=rsf0,rs1=rsf1;
    for(uint r=0u;r<2u;++r) {
        uint m0=(sg/4u+4u*r)*8u,m1=m0+16u,n=(sg%4u)*32u;
        bool oob0,oob1;uint base0=input_addr(m0,0u,wx,wy,oob0),base1=input_addr(m1,0u,wx,wy,oob1);
        ACC a0=ACC(ZERO),a1=ACC(ZERO),b0=ACC(ZERO),b1=ACC(ZERO);
        for(uint k=0u;k<128u;k+=KS) {
            MA x;MB v0,v1;
            coopMatLoad(v0,qw,81920u+n*128u+k,128u,COL);
            coopMatLoad(v1,qw,81920u+(n+16u)*128u+k,128u,COL);
            coopMatLoad(x,gm,mid_addr(w,m0,k),8u,COL);
            a0=coopMatMulAdd(x,v0,a0);a1=coopMatMulAdd(x,v1,a1);
            coopMatLoad(x,gm,mid_addr(w,m1,k),8u,COL);
            b0=coopMatMulAdd(x,v0,b0);b1=coopMatMulAdd(x,v1,b1);
        }
        finish(a0,m0,n,base0,oob0,w,cScale0,rs0);finish(a1,m0,n+16u,base0,oob0,w,cScale1,rs1);
        finish(b0,m1,n,base1,oob1,w,cScale0,rs0);finish(b1,m1,n+16u,base1,oob1,w,cScale1,rs1);
    }
}
