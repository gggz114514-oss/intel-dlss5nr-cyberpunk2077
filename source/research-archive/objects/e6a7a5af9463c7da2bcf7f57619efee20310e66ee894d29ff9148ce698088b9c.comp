// c128_d4_qx.comp — C128 body_4 (D4) plus a fused qX epilogue for the next
// block's INT8 FFN body1.
//
// Parent: candidates/amd-map-20261015/s1-output-complete/c128/full/c128_d4_full.comp
// (source SHA 66435c26161b9008cad6a8cf47d35a65d1aa83dd01a6c840d572d6a74bea4d95).
// This copy changes ONLY the epilogue: the original half store and the whole
// seed/MMA tree are untouched, so the FP16 output is bit-identical to the parent.
//
// Added: after the original half store of each 8x16 block, quantise the same
// final narrowed half value once and store the int8 codes to the consumer's qX
// buffer.  qX is the C128 layout used by pilot_common.input_addr():
//     ((ty*42 + tx)*16 + slot)*128 + c
// For one 8-row block (m0 is 8-aligned, so all 8 tokens share one 16-slot tile)
// that is an affine block  base + i*128 + j,  i.e. exactly what a row-major
// coopMatStore with stride 128 writes.  OOB windows are not stored; the INT8
// consumer substitutes zeros for them with the identical oob test.
//
// Cost (E = elements of this pass's output domain): +1 int8 global store per
// element, +1 scale read per workgroup, +1 elementwise mul/RNE/clamp per element.
// No extra dispatch, no extra half read, no change to the FP16 output.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_8bit_storage : require

layout(local_size_x = 256) in;
// diagnostics: NR_D4_SEED_ONLY / NR_D4_MMA_ONLY isolate the two O components
#ifndef NR_D4_MODE
#define NR_D4_MODE 0   // 0 = full, 1 = seed only, 2 = mma only
#endif
#include "c64_c128_common.glsl"

layout(set = 0, binding = 6) buffer YBuf { float16_t gY[]; };
layout(set = 0, binding = 7) buffer TBuf { float16_t gT[]; };
// fused qX epilogue: [0]=sX, [1]=invX (inverse source of truth is the pack,
// written by the offline builder; the kernel only reads invX).
layout(set = 0, binding = 8) writeonly buffer QxOut { int8_t qxout[]; };
layout(set = 0, binding = 9) readonly buffer QxSc { float qxsc[]; };

#define MAT_H coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>
#define MAT_Q coopmat<int8_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>

// qX element index for window token t and channel c (same tx/ty derivation as
// c128_img_half_index; only the final layout differs).
uint c128_qx_index(uint t, uint c, uint wx, uint wy, out bool oob) {
    uint q = t >> 4u, s = t & 15u;
    int tx = 2 * int(wx) + pc.p0.z + int(q & 1u);
    int ty = 2 * int(wy) + pc.p0.w + int(q >> 1u);
    oob = (tx < 0 || ty < 0 || tx >= pc.p0.x || ty >= pc.p0.y);
    uint stx = uint(clamp(tx, 0, pc.p0.x - 1));
    uint sty = uint(clamp(ty, 0, pc.p0.y - 1));
    return (((sty * uint(pc.p0.x) + stx) * 16u + s) * 128u + c);
}

float qx_code(float v, float inv) {
    precise float scaled = v * inv;
    return clamp(roundEven(scaled), -127.0, 127.0);
}

// One writer per element: the value is the already-narrowed final half, exactly
// the value the original store writes to imgout.
void store_qx(MAT_H h, uint t, uint c, uint wx, uint wy, float invX) {
    bool oob;
    uint addr = c128_qx_index(t, c, wx, wy, oob);
    if (oob) return;
    MAT_C f = MAT_C(h);
    for (int i = 0; i < f.length(); ++i) f[i] = qx_code(f[i], invX);
    MAT_Q q = MAT_Q(f);
    coopMatStore(q, qxout, addr, 128u, LROW);
}

void main() {
    const uint t_local = gl_LocalInvocationID.x;
    const uint sg = t_local / 32u;
    const uint wx = (pc.p1.z != 0) ? uint(pc.p2.x) : gl_WorkGroupID.x;
    const uint wy = (pc.p1.z != 0) ? uint(pc.p2.y) : gl_WorkGroupID.y;
    const uint w = wy * uint(pc.p1.x) + wx;
    const bool debug = pc.p1.w != 0;
    const uint wo = uint(pc.p4.x);
    const uint ars = uint(pc.p4.z);   // p4.y is rs (used by D2) — ars is p4.z
    const float invX = qxsc[1];

    if (debug) {
        for (uint e = t_local; e < 8192u; e += 256u) {
            dbg[212992u + e] = gT[w * 8192u + e];
            dbg[81920u + e] = gY[w * 8192u + e];
        }
        barrier();
    }

    for (uint j = 0u; j < 4u; ++j) {
        uint m0 = (sg / 4u + 2u * j) * 8u;
        uint n0 = (sg % 4u) * 32u;
        MAT_C acc0;
        {
            MAT_H seed;
            coopMatLoad(seed, gY, (w * 64u + m0) * 128u + n0, 128u, LROW);
            MAT_H scale;
            coopMatLoad(scale, pack, ars + n0, 0u, LROW);
            seed = seed * scale;
#if NR_D4_MODE == 2
            acc0 = MAT_C(0.0);
#else
            acc0 = MAT_C(seed);
#endif
        }
        MAT_C acc1;
        {
            MAT_H seed;
            coopMatLoad(seed, gY, (w * 64u + m0) * 128u + (n0 + 16u), 128u, LROW);
            MAT_H scale;
            coopMatLoad(scale, pack, ars + (n0 + 16u), 0u, LROW);
            seed = seed * scale;
#if NR_D4_MODE == 2
            acc1 = MAT_C(0.0);
#else
            acc1 = MAT_C(seed);
#endif
        }
        for (uint ki = 0u; ki < 8u; ++ki) {
            uint k0 = ki * 16u;
            MAT_A a;  coopMatLoad(a, gT, (w * 64u + m0) * 128u + k0, 128u, LROW);
            MAT_B b0; coopMatLoad(b0, pack, wo + (n0 / 16u) * 2048u + (k0 / 16u) * 256u, 16u, LCOL);
            MAT_B b1; coopMatLoad(b1, pack, wo + ((n0 + 16u) / 16u) * 2048u + (k0 / 16u) * 256u,
                                  16u, LCOL);
#if NR_D4_MODE != 1
            acc0 = coopMatMulAdd(a, b0, acc0);
            acc1 = coopMatMulAdd(a, b1, acc1);
#endif
        }
        {
            MAT_H narrowed = MAT_H(acc0);
            if (debug)
                coopMatStore(narrowed, dbg, 221184u + m0 * 128u + n0, 128u, LROW);
            bool oob;
            uint addr = c128_img_half_index(m0, n0, wx, wy, oob);
            if (!oob) {
                coopMatStore(narrowed, imgout, addr, 16u, LROW);
                store_qx(narrowed, m0, n0, wx, wy, invX);
            }
        }
        {
            MAT_H narrowed = MAT_H(acc1);
            if (debug)
                coopMatStore(narrowed, dbg, 221184u + m0 * 128u + (n0 + 16u), 128u, LROW);
            bool oob;
            uint addr = c128_img_half_index(m0, (n0 + 16u), wx, wy, oob);
            if (!oob) {
                coopMatStore(narrowed, imgout, addr, 16u, LROW);
                store_qx(narrowed, m0, n0 + 16u, wx, wy, invX);
            }
        }
    }
}
