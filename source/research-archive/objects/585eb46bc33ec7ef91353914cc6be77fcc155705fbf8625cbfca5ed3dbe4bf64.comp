// n23-f05-shape probe P3 (negative control): an 8x32 accumulator fed by a 16x16 B
// fragment must be rejected -- otherwise the probe's "compiles" result proves nothing
// about shape matching.
#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require

layout(local_size_x = 32) in;
layout(set = 0, binding = 0) buffer InBuf  { float16_t inbuf[]; };
layout(set = 0, binding = 1) buffer OutBuf { float16_t outbuf[]; };

#define P_A coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseA>
#define P_B16 coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB>
#define P_C coopmat<float, gl_ScopeSubgroup, 8, 32, gl_MatrixUseAccumulator>

void main() {
    P_A a; coopMatLoad(a, inbuf, 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
    P_B16 b; coopMatLoad(b, inbuf, 0u, 16u, gl_CooperativeMatrixLayoutColumnMajor);
    P_C c = P_C(0.0);
    c = coopMatMulAdd(a, b, c);
    coopMatStore(c, outbuf, 0u, 32u, gl_CooperativeMatrixLayoutRowMajor);
}
