// C128 D4 C-producer variant: attention output projection (WO) in signed INT8,
// INT32 accumulate, dequantisation folded once into the parent's FP32 accumulator,
// and the parent's (2,128,8) int8 qX store kept byte-for-byte.
//
// Card r07-c128-cproducer. Parent: producer_quant.comp from
// candidates/codex-sol-int8-pilot-20261018/v6-m8col-20261019/source (block 9) and
// candidates/codex-sol-int8-nextblock11-20261019/v3-m8col-scale-repair/source (block 10),
// both compiled with -DNATIVE=1 and reproduced byte-identically by this card.
//
// Unchanged from the parent (deliberately):
//   * push-constant ABI, 32 words, every field read the same way (wo = p4.x is now
//     unused because the int8 WO pack is its own buffer, so the whole matrix starts at 0);
//   * the seed  H(Y)*pack[ars+n]  and its FP32 accumulator;
//   * ONE narrowing point: the qX quantiser is still fed the *unrounded FP32* accumulator
//     (the parent's contract for this variant; no half image exists in this arm);
//   * emit_quant()'s address  (((ty*tiles_x+tx)*2 + (slot>>3))*128 + n)*8 + (slot&7),
//     LCOL stride 8  ->  the (2,128,8) qX layout the next block's D1/D2 read;
//   * the cold debug path (binding 4) and NR_D4_MODE diagnostics.
//
// Replaced: the two FP16 cooperative-matrix multiplies.  A is quantised in-kernel from the
// same half gT tile (per window amax, exactly the scheme R07's nine C128 positions use),
// B is a static int8 pack with per-output-channel scales, accumulation is INT32.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;
// diagnostics: NR_D4_SEED_ONLY / NR_D4_MMA_ONLY isolate the two O components
#ifndef NR_D4_MODE
#define NR_D4_MODE 0   // 0 = full, 1 = seed only, 2 = mma only
#endif
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_8bit_storage : require
#if NATIVE
#define OUTPUT_Q int8_t
#else
#define OUTPUT_Q float16_t
#endif
// This arm has no half output at all (the parent's imgout is int8 in production), so a
// NATIVE=0 build would silently declare a half array in place of the qX buffer.  Refuse.
#if !NATIVE
#error "c128_cproducer_wo_i8.comp must be built with -DNATIVE=1 (int8 qX store, no half image)"
#endif
#include "producer_common.glsl"

layout(set = 0, binding = 6) buffer YBuf { float16_t gY[]; };
layout(set = 0, binding = 7) buffer TBuf { float16_t gT[]; };

#define MAT_H coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>
// R07-C128: signed int8 A/B, INT32 accumulate, K32 steps instead of K16.
#define I8A   coopmat<int8_t, gl_ScopeSubgroup, 8, 32, gl_MatrixUseA>
#define I8B   coopmat<int8_t, gl_ScopeSubgroup, 32, 16, gl_MatrixUseB>
#define I8C   coopmat<int, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>

layout(set=0,binding=8) readonly buffer ChainScales { float chain_sc[]; };
// R07-C128: static INT8 WO tile, 8 output-channel groups x 4 K32 tiles x 512 B,
// element (n,k) at (n/16)*2048 + (k/32)*512 + (n%16)*32 + (k%32).
layout(set=0,binding=9) readonly buffer Wo8Buf { int8_t gWo8[]; };
// R07-C128: per output channel scale (128 f32 = amax_k|W[n][k]| / 127).
layout(set=0,binding=10) readonly buffer WoScaleBuf { float gWosc[]; };

#define OUT_Q coopmat<OUTPUT_Q,gl_ScopeSubgroup,8,16,gl_MatrixUseAccumulator>

// 64 tokens x 128 channels of int8 activation codes, staged so one 8x32 K32 A fragment is
// a column-major stride-32 view: ((t>>5)*128 + k)*32 + (t&31).  8 KiB per workgroup.
shared int8_t sT8[8192];
shared float shMax[256];
shared float shScale[2];

// Original output site: direct FP32 accumulator quantization, no tensor repack.
void emit_quant(MAT_C raw,uint m,uint n,uint wx,uint wy,float invX) {
    uint tile=m>>4u,slot=m&15u;
    int tx=2*int(wx)+pc.p0.z+int(tile&1u),ty=2*int(wy)+pc.p0.w+int(tile>>1u);
    if(tx<0||ty<0||tx>=pc.p0.x||ty>=pc.p0.y)return;
    MAT_C f=raw;
    for(int i=0;i<f.length();++i){precise float code=f[i]*invX;f[i]=clamp(roundEven(code),-127.0,127.0);}
    OUT_Q q=OUT_Q(f);
    uint addr=(((uint(ty)*uint(pc.p0.x)+uint(tx))*2u+(slot>>3u))*128u+n)*8u+(slot&7u);
    coopMatStore(q,imgout,addr,8u,LCOL);
}
void main() {
    const uint t_local = gl_LocalInvocationID.x;
    const uint sg = t_local / 32u;
    const uint lane = t_local % 32u;
    const uint wx = (pc.p1.z != 0) ? uint(pc.p2.x) : gl_WorkGroupID.x;
    const uint wy = (pc.p1.z != 0) ? uint(pc.p2.y) : gl_WorkGroupID.y;
    const uint w = wy * uint(pc.p1.x) + wx;
    const bool debug = pc.p1.w != 0;
    const float invX=chain_sc[1];
    const uint ars = uint(pc.p4.z);   // p4.y is rs (used by D2) — ars is p4.z
    // p4.x (wo, the FP16 WO half offset) is intentionally NOT read any more: the int8 WO
    // pack is a dedicated buffer holding exactly this block's 128x128 matrix at offset 0.

    if (debug) {
        for (uint e = t_local; e < 8192u; e += 256u) {
            dbg[212992u + e] = gT[w * 8192u + e];
            dbg[81920u + e] = gY[w * 8192u + e];
        }
        barrier();
    }

    // ---- INT8 activation quantiser (one window = one workgroup = 64 tokens) -------
    {
        float amax = 0.0;
        for (uint e = t_local; e < 8192u; e += 256u)
            amax = max(amax, abs(float(gT[w * 8192u + e])));
        shMax[t_local] = amax;
    }
    barrier();
    if (t_local == 0u) {
        float m = 0.0;
        for (uint i = 0u; i < 256u; ++i) m = max(m, shMax[i]);
        shScale[0] = (m > 0.0) ? 127.0 / m : 0.0;   // invC
        shScale[1] = (m > 0.0) ? m / 127.0 : 0.0;   // sC (dequant)
    }
    barrier();
    const float invC = shScale[0];
    const float sC = shScale[1];
    for (uint e = t_local; e < 8192u; e += 256u) {
        const uint t = e >> 7u;          // 0..63 token
        const uint k = e & 127u;         // 0..127 channel
        sT8[((t >> 5u) * 128u + k) * 32u + (t & 31u)] =
            int8_t(clamp(roundEven(float(gT[w * 8192u + e]) * invC), -127.0, 127.0));
    }
    barrier();

    for (uint j = 0u; j < 4u; ++j) {
        uint m0 = (sg / 4u + 2u * j) * 8u;
        uint n0 = (sg % 4u) * 32u;
        MAT_C acc0;
        {
            MAT_H seed;
            coopMatLoad(seed, gY, (w * 64u + m0) * 128u + n0, 128u, LROW);
            MAT_H scale;
            coopMatLoad(scale, pack, ars + n0, 0u, LROW);
            seed = seed * scale;
#if NR_D4_MODE == 2
            acc0 = MAT_C(0.0);
#else
            acc0 = MAT_C(seed);
#endif
        }
        MAT_C acc1;
        {
            MAT_H seed;
            coopMatLoad(seed, gY, (w * 64u + m0) * 128u + (n0 + 16u), 128u, LROW);
            MAT_H scale;
            coopMatLoad(scale, pack, ars + (n0 + 16u), 0u, LROW);
            seed = seed * scale;
#if NR_D4_MODE == 2
            acc1 = MAT_C(0.0);
#else
            acc1 = MAT_C(seed);
#endif
        }
        // INT8 K32: same k order (ascending, 32 at a time), same accumulator pair,
        // INT32 instead of FP32.
        I8C iacc0 = I8C(0), iacc1 = I8C(0);
        for (uint ki = 0u; ki < 4u; ++ki) {
            const uint k0 = ki * 32u;
            I8B b0, b1;
            coopMatLoad(b0, gWo8, (n0 / 16u) * 2048u + ki * 512u, 32u, LCOL);
            coopMatLoad(b1, gWo8, ((n0 + 16u) / 16u) * 2048u + ki * 512u, 32u, LCOL);
            I8A a;
            coopMatLoad(a, sT8, (m0 / 32u) * 4096u + k0 * 32u + (m0 % 32u), 32u, LCOL);
#if NR_D4_MODE != 1
            iacc0 = coopMatMulAdd(a, b0, iacc0);
            iacc1 = coopMatMulAdd(a, b1, iacc1);
#endif
        }
        // one dequant product (sC * sWosc[n]) folded into the parent's FP32 accumulator,
        // so the seed add and the qX quantiser see exactly one FP32 value each.
        {
            MAT_C wsc0, wsc1;
            coopMatLoad(wsc0, gWosc, n0, 0u, LROW);
            coopMatLoad(wsc1, gWosc, n0 + 16u, 0u, LROW);
            wsc0 = wsc0 * MAT_C(sC);
            wsc1 = wsc1 * MAT_C(sC);
            acc0 = acc0 + MAT_C(iacc0) * wsc0;
            acc1 = acc1 + MAT_C(iacc1) * wsc1;
        }
        {
            if (debug) {
                MAT_H narrowed = MAT_H(acc0);
                coopMatStore(narrowed, dbg, 221184u + m0 * 128u + n0, 128u, LROW);
            }
            emit_quant(acc0,m0,n0,wx,wy,invX);
        }
        {
            if (debug) {
                MAT_H narrowed = MAT_H(acc1);
                coopMatStore(narrowed, dbg, 221184u + m0 * 128u + (n0 + 16u), 128u, LROW);
            }
            emit_quant(acc1,m0,(n0 + 16u),wx,wy,invX);
        }
    }
}
