// c64_d2.comp — C64 body2 INT8: contract (K=64,N=64) + residual seed.
//
// Private family copy for VK-INT8-ZCODE-COVERAGE-FIRST-EXECUTION-V2 工单 B2.
// Replaces the FP16 contract-c64-full.spv math:
//   parent : Y_half = half( f32(acc) * csc[n] + f32(X_half) * rs_fp16[n] )
//   here   : Y_half = half( f32(int32acc) * (sM*sWc[n]) + f32(qX) * (sX*rs[n]) )
// The seed is the same X tensor that d1 consumed (int8 codes + sX), so no
// second dequantised FP16 copy is materialised, and no extra producer runs.
//
//   grid = window grid, z = 1
//   M    int8 window-major (w*64+m)*64+c   (written by d1)
//   Y    half window-major (w*64+m)*64+c   (same ABI the parent attention reads)
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x = 256) in;
#include "c64_int8_common.glsl"
layout(set=0,binding=8) readonly buffer OriginalInput {float16_t originalX[];};

void finish(ACC a, uint m, uint n, uint base, bool oob, uint w, MF s, MF rs) {
    dumpdot(a, 40960u, m, n, 128u);
    MF f = MF(a);
    MH seed;
    if (oob) seed = MH(float16_t(0));
    else {
        uint tile=base/1024u, slot=(base%1024u)/64u;
        coopMatLoad(seed, originalX, tile*1024u+(n/16u)*256u+slot*16u, 16u, ROW);
    }
    MH seedScale = MH(rs);
    MH roundedSeed = seed * seedScale;
    MF seedf = MF(roundedSeed);
    for (int i = 0; i < f.length(); ++i) {
        precise float realv = f[i] * s[i];
        precise float residual = seedf[i];
        precise float result = realv + residual;
        f[i] = result;
    }
    // Existing D3 attention consumes this same FP16 ABI.
    MH h = MH(f);
    coopMatStore(h, gy, (w * 64u + m) * 64u + n, 64u, ROW);
}

void main() {
    uint sg = gl_LocalInvocationID.x / 32u, wx = gl_WorkGroupID.x, wy = gl_WorkGroupID.y;
    uint w = wy * uint(pc.p1.x) + wx;
    const uint n = (sg & 1u) * 32u;
    const uint r0 = sg >> 1u;
    const uint m0 = r0 * 8u, m1 = m0 + 32u;

    MF cScale0, cScale1, rsf0, rsf1;
    coopMatLoad(cScale0, sc, SC_CONTRACT + n, 0u, ROW);
    coopMatLoad(cScale1, sc, SC_CONTRACT + n + 16u, 0u, ROW);
    coopMatLoad(rsf0, sc, 464u + n, 0u, ROW);
    coopMatLoad(rsf1, sc, 464u + n + 16u, 0u, ROW);

    bool oob0, oob1;
    uint base0 = qx_addr(m0, 0u, wx, wy, oob0);
    uint base1 = qx_addr(m1, 0u, wx, wy, oob1);

    ACC a0 = ACC(ZERO), a1 = ACC(ZERO), b0 = ACC(ZERO), b1 = ACC(ZERO);
    for (uint k = 0u; k < 64u; k += KS) {
        MA x; MB v0, v1;
        coopMatLoad(v0, qw, 24576u + n * 64u + k, 64u, COL);
        coopMatLoad(v1, qw, 24576u + (n + 16u) * 64u + k, 64u, COL);
        coopMatLoad(x, gm, (w * 64u + m0) * 64u + k, 64u, ROW);
        a0 = coopMatMulAdd(x, v0, a0); a1 = coopMatMulAdd(x, v1, a1);
        coopMatLoad(x, gm, (w * 64u + m1) * 64u + k, 64u, ROW);
        b0 = coopMatMulAdd(x, v0, b0); b1 = coopMatMulAdd(x, v1, b1);
    }
    finish(a0, m0, n, base0, oob0, w, cScale0, rsf0);
    finish(a1, m0, n + 16u, base0, oob0, w, cScale1, rsf1);
    finish(b0, m1, n, base1, oob1, w, cScale0, rsf0);
    finish(b1, m1, n + 16u, base1, oob1, w, cScale1, rsf1);
}
