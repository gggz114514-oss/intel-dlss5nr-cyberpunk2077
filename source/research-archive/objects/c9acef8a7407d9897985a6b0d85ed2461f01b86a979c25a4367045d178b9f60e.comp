#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_8bit_storage : require
// vit32-v2 qX producer template, instantiated for VIT block31: ONE dispatch per
// frame converts the expand A operand (X = block30_out, FP16) into the int8 codes
// the INT8 expand reads.
//
// Why this dispatch exists: v1 quantised X inside the expand kernel itself, but that
// kernel's grid tiles the N dimension (gy=128), so every gy workgroup re-quantised and
// re-wrote the same A tile - measured +1.19 ms and +5.7M SEND on pass 116 versus 80 us
// for the FP16 parent, with the INT8 MMA itself 2x faster when staging was removed
// (probe vit32-probe-nostage-001: 42.7 us).  Hoisting the conversion to a single
// producer removes the 128x duplication and the in-kernel barrier; the codes and the
// destination bytes are identical to v1 (equivalence proof in VIT32-V2 evidence).
//
// Layout: qX[row*K + k] into binding 4 (int8 view, VIT_A8) at VIT_A_SCRATCH, the same
// region and addressing the expand A load uses (RowMajor stride K).
// Scale: invX = ws[8] = 127/absmax(block30_out), packed with the block weights.
layout(local_size_x=256) in;
#define VIT_W8 1
#define VIT_A8 1
#define VIT_T8 0
#include "vit_common.glsl"
// same constant as vit_nb04_mpair.glsl VIT_A_SCRATCH (the expand A region)
#define VIT_A_SCRATCH 1179648u

void main() {
    uint row=gl_WorkGroupID.x;
    if(row>=pc.p0.x) return;
    const uint K=1024u;
    uint k0=gl_LocalInvocationID.x*4u;
    // S08: per-input-channel static inverse instead of the single ws[8].
    for(uint j=0u;j<4u;++j) {
        uint k=k0+j;
        aHidden[VIT_A_SCRATCH+row*K+k]=int8_t(vit_code(float(x[pc.p5.x+row*K+k]),cinv_x[k]));
    }
}
