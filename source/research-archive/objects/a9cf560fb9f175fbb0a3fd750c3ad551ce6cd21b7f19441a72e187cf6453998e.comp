// c256_b15_qx_producer_eq.comp — S06 block15 one-time qX for the first early
// C256 block, with per-input-channel power-of-two equalisation.
//
// Parent identity (unchanged structure, same push ABI, same dispatch):
//   candidates/codex-sol-int8-long-008-20261019/c256-early-15-22-v1/source/
//   c256_early_qx_producer.comp
//   spv sha256 36707a220903a6bb7fff3669fa5ae158da6ff76003c5f133e70f326c81ab007d
//
// The only functional change is the inverse step: the parent read scal[0]
// (one global 127/absmaxX), this shader reads a per-input-channel table from
// the pack's formerly-unused 2,944 B pad at byte 373,888:
//     invx_tab[c] = (1/sX) / D[c],  D[c] = 2^k  (power of two)  ->  1,024 B
// so code = int8(clamp(RNE(f32(X[c]) * invx_tab[c]), -127, 127)).
// The compensating factor D[c] is folded into the expand weight column c by the
// pack builder (We'[n,c] = We[n,c]*D[c], then per-output-channel sWe'[n]);
// the residual branch reads the original half image and is untouched.
//
// Each thread owns exactly one input channel: local_size_x = 256 = C_IN and
// c = gl_LocalInvocationID.x for every one of the 16 slot iterations, so the
// table load is hoisted out of the loop (one uniform f32 load per thread, no
// shared-memory staging, no extra dispatch, no extra buffer).
#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_8bit_storage : require
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer In { float16_t gx[]; };
layout(set = 0, binding = 1) buffer Pack {
    int8_t d_pad0[372736];   //   0        weights + scale vectors (untouched)
    float  d_sc[32];         //   372,736  scal[]: [0]=127/absmaxX (global, kept for ABI)
    int8_t d_rs[1024];       //   372,864  rs[256] (contract residual taps)
    float  d_invx[256];      //   373,888  1/sX / D[c]   <-- new per-channel table
    int8_t d_pad2[1920];     //   374,912  -> qx at 376,832
    int8_t d_qx[];           //   376,832  canonical 32-channel-group qX
};
layout(push_constant) uniform PC {
    ivec4 p0;   // tiles_x, tiles_y, shift_x, shift_y
    ivec4 p1;
} pc;
void main() {
    const uint c = gl_LocalInvocationID.x;          // == input channel, always
    const uint tile = gl_WorkGroupID.y * uint(pc.p0.x) + gl_WorkGroupID.x;
    const float inv = d_invx[c];                    // hoisted: one load per thread
    for (uint i = 0u; i < 16u; ++i) {
        const uint s = i;
        uint in_idx = ((tile * 16u + c / 16u) * 256u) + s * 16u + c % 16u;
        uint out_idx = ((tile * 8u + c / 32u) * 16u + s) * 32u + c % 32u;
        float v = float(gx[in_idx]);
        d_qx[out_idx] = int8_t(clamp(roundEven(v * inv), -127.0, 127.0));
    }
}
