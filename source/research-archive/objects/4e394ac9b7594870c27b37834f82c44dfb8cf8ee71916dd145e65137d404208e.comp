// C256 D4 cooperative seed/output;original A/B layout: original seed-before-K math and two-accumulator ownership.
// n06d: shT is kept (same 32 KiB Workgroup array, still ONE 32 KiB global read, NOT segmented);
// only the ORDER of the publish changes: it now writes the consumer tile order
// shT[(j*16+ki)*128 + dr*16 + dc], i.e. every 8x16 A tile is 128 contiguous halves (256 B).
// The A read therefore uses stride 16 (contiguous tile) instead of stride 256 (8 rows 512 B apart).
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;
// diagnostics: NR_D4_SEED_ONLY / NR_D4_MMA_ONLY isolate the two O components
#ifndef NR_D4_MODE
#define NR_D4_MODE 0   // 0 = full, 1 = seed only, 2 = mma only
#endif
#include "c256_common.glsl"

layout(set = 0, binding = 6) buffer YBuf { float16_t gY[]; };
layout(set = 0, binding = 7) buffer TBuf { float16_t gT[]; };

shared float16_t shT[16384];
#define MAT_H coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>

void main() {
    const uint t_local = gl_LocalInvocationID.x;
    const uint sg = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const uint wx = (pc.p1.z != 0) ? uint(pc.p2.x) : gl_WorkGroupID.x;
    const uint wy = (pc.p1.z != 0) ? uint(pc.p2.y) : gl_WorkGroupID.y;
    const uint w = wy * uint(pc.p1.x) + wx;
    const bool debug = pc.p1.w != 0;
    const uint wo = uint(pc.p4.x);
    const uint ars = uint(pc.p4.z);   // p4.y is rs (used by D2) — ars is p4.z

    // Publish shT in CONSUMER TILE ORDER (n06d). One 32 KiB global read, as before.
    // q = t*8 + dr enumerates the 1024 tile rows (128 A tiles x 8 rows of 16 halves);
    // destination offset of q is exactly q*16 halves, i.e. 32 B per lane, warp-contiguous,
    // so the destination run for a warp is 1024 contiguous bytes.
    // Source of tile row q is gT row (8*(t/16)+dr) at column 16*(t%16); both operands of the
    // copy are 16 contiguous halves, so the value of every element is exactly the parent's
    // shT[(8*(t/16)+dr)*256 + 16*(t%16) + dc] == gT[w*16384 + ((8*(t/16)+dr)*256 + 16*(t%16) + dc)].
    for (uint q = t_local; q < 1024u; q += 256u) {
        const uint t  = q >> 3u;                    // tile index = j*16 + ki
        const uint dr = q & 7u;                     // row inside the 8x16 tile
        const uint src = (((t >> 4u) * 8u + dr) << 8u) + ((t & 15u) << 4u);
        const uint dst = q << 4u;
        for (uint dc = 0u; dc < 16u; ++dc)
            shT[dst + dc] = gT[w * 16384u + src + dc];
    }
    barrier();
    if (debug) {
        // debug dump keeps the parent's linear (row-major) element order: element e = r*256+c
        // now lives at tile(r/8, c/16)*128 + (r%8)*16 + (c%16). dbg content is byte-identical.
        for (uint e = t_local; e < 16384u; e += 256u) {
            const uint r = e >> 8u, c = e & 255u;
            const uint idx = (((r >> 3u) * 16u + (c >> 4u)) << 7u) + ((r & 7u) << 4u) + (c & 15u);
            dbg[425984u + e] = shT[idx];
        }
        barrier();
    }

    const uint n0 = (sg % 8u) * 32u;
    MAT_H scale0, scale1;
    float16_t gain_scale0=pack[(ars + n0)+(lane & 15u)];
    for(int component=0;component<scale0.length();++component) scale0[component]=gain_scale0;
    float16_t gain_scale1=pack[(ars + (n0 + 16u))+(lane & 15u)];
    for(int component=0;component<scale1.length();++component) scale1[component]=gain_scale1;
    for (uint j = 0u; j < 8u; ++j) {
        uint m0 = (sg / 8u + 1u * j) * 8u;
        MAT_C acc0;
        {
            MAT_H seed;
            coopMatLoad(seed, gY, (w * 64u + m0) * 256u + n0, 256u, LROW);
            seed = seed * scale0;
#if NR_D4_MODE == 2
            acc0 = MAT_C(0.0);
#else
            acc0 = MAT_C(seed);
#endif
        }
        MAT_C acc1;
        {
            MAT_H seed;
            coopMatLoad(seed, gY, (w * 64u + m0) * 256u + (n0 + 16u), 256u, LROW);
            seed = seed * scale1;
#if NR_D4_MODE == 2
            acc1 = MAT_C(0.0);
#else
            acc1 = MAT_C(seed);
#endif
        }
        for (uint ki = 0u; ki < 16u; ++ki) {
            uint k0 = ki * 16u;
            // tile (j,ki) is 128 contiguous halves at ((m0/8)*16 + k0/16)*128, stride 16
            MAT_A a;  coopMatLoad(a, shT, (((m0 >> 3u) * 16u + (k0 >> 4u)) << 7u), 16u, LROW);
            MAT_B b0; coopMatLoad(b0, pack, wo + (n0 / 16u) * 4096u + (k0 / 16u) * 256u, 16u, LCOL);
            MAT_B b1; coopMatLoad(b1, pack, wo + ((n0 + 16u) / 16u) * 4096u + (k0 / 16u) * 256u,
                                  16u, LCOL);
#if NR_D4_MODE != 1
            acc0 = coopMatMulAdd(a, b0, acc0);
            acc1 = coopMatMulAdd(a, b1, acc1);
#endif
        }
        {
            MAT_H narrowed = MAT_H(acc0);
            if (debug)
                coopMatStore(narrowed, dbg, 442368u + m0 * 256u + n0, 256u, LROW);
            bool oob;
            uint addr = c256_img_half_index(m0, n0, wx, wy, oob);
            if (!oob)
                coopMatStore(narrowed, imgout, addr, 16u, LROW);
        }
        {
            MAT_H narrowed = MAT_H(acc1);
            if (debug)
                coopMatStore(narrowed, dbg, 442368u + m0 * 256u + (n0 + 16u), 256u, LROW);
            bool oob;
            uint addr = c256_img_half_index(m0, (n0 + 16u), wx, wy, oob);
            if (!oob)
                coopMatStore(narrowed, imgout, addr, 16u, LROW);
        }
    }
}
