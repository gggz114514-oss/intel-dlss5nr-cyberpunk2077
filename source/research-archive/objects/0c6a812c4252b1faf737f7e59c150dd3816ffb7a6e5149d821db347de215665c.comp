// c3x_pre_c256_int8_qx.comp — block48 body_1 dispatch A (FP16 ioport
// projection + blend) with the one-time qX production for block48's expand.
//
// Parent identity: candidates/amd-netorg-t3d-20261018/c256-canonical-only-v1/
// source/c3x_pre_c256.comp (byte-exact reproduction recorded in evidence/
// parent-repro). The projection and blend math is unchanged; only binding 12
// changes from the retired float16 staging buffer to the block48 INT8 buffer,
// whose qX region is written in the same blend loop (one write per valid
// pixel/channel). No extra dispatch and no extra projection.
//
// v2 FIX (2026-10-19, main agent): v1 read invX from byte 360,448, which is ew[0]
// (=sX*sWe[0], ~3e-4), not the inverse step. Every code became 0 (arm
// c256-int8-diag-001: all eight qX/qA regions zero, M zero). The scalars live at
// 372,736 (C256_SCAL_OFF), so the int8 view now ends its padding exactly there.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_8bit_storage : require

layout(local_size_x = 256) in;
#include "c256_common.glsl"

layout(set = 0, binding = 8) buffer Nr3Pack { float16_t pw[]; };
layout(set = 0, binding = 9) buffer Nr3Skip { float16_t sk[]; };
layout(set = 0, binding = 10) buffer Nr3BlendOut { float16_t blout[]; };
layout(set = 0, binding = 11) buffer Nr3ProjIn { float16_t x47[]; };
// block48 native-INT8 buffer (int8 view; weights/scales first, qX tail)
layout(set = 0, binding = 12) buffer C3XQ {
    int8_t d_pad0[372736];      //  0        weights + per-channel factors (unchanged)
    float  d_sc[32];            //  372,736  scal[]: [0]=127/absmaxX, [1]=127/absmaxA, [2]=127/absmaxM
    int8_t d_pad1[3968];        //  372,864  rs[256] and padding
    int8_t d_qx[];              //  376,832  canonical 32-channel-group qX
};

shared float16_t nr3_gbuf[4096u];

#define MAT_H coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>

// ioport_common.glsl io_at, layout 0 (spatial 4x4 tiles, 16 channels).
uint nr3_io_at0(uint px, uint py, uint c, uint W, uint C) {
    uint t = ((py / 4u) * (W / 4u) + px / 4u) * 16u + 4u * (py % 4u) + px % 4u;
    return ((t / 16u) * (C / 16u) + c / 16u) * 256u + (t % 16u) * 16u + c % 16u;
}

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint sg = tid / 32u;
    const uint wx = (pc.p1.z != 0) ? uint(pc.p2.x) : gl_WorkGroupID.x;
    const uint wy = (pc.p1.z != 0) ? uint(pc.p2.y) : gl_WorkGroupID.y;
    // z is the 32-token half only; the head index is gone because this dispatch
    // always produces all 256 projection channels.
    const uint half3 = gl_WorkGroupID.z % 2u;
    const uint t0 = half3 * 32u;
    const float invX = d_sc[0];

    // ---- gather 8 rows × 512 channels, then the same projection ----
    {
        for (uint e = tid; e < 4096u; e += 256u) {
            const uint s3 = e / pc.p5.x, k3 = e % pc.p5.x;
            const int px3 = 4 * int(wx) + int(s3 % 4u);
            const int py3 = 4 * int(wy) + 2 * int(half3) + int(s3 / 4u);
            // combo-v2 conflict resolution: C2 layout0-unify-l2-v4 re-anchors the
            // block47_out edge to layout0 (writer = C2 chain, reader push p2.x 1->0
            // in the 275 graph); the fused reader follows the writer.
            nr3_gbuf[e] = x47[nr3_io_at0(uint(px3), uint(py3), k3, uint(pc.p6.z), pc.p5.x)];
        }
        barrier();
        const uint n0 = sg * 32u;
        const uint wbase = pc.p4.y + (n0 / 16u) * (pc.p5.x / 16u) * 256u;
        MAT_C acc0 = MAT_C(0.0), acc1 = MAT_C(0.0);
        for (uint kc = 0u; kc < pc.p5.x; kc += 16u) {
            MAT_A a; MAT_B b0, b1;
            coopMatLoad(a, nr3_gbuf, kc, pc.p5.x, LROW);
            coopMatLoad(b0, pw, wbase + (kc / 16u) * 256u, 16u, LCOL);
            coopMatLoad(b1, pw, wbase + (pc.p5.x / 16u) * 256u + (kc / 16u) * 256u, 16u, LCOL);
            acc0 = coopMatMulAdd(a, b0, acc0);
            acc1 = coopMatMulAdd(a, b1, acc1);
        }
        barrier();
        { MAT_H h = MAT_H(acc0); coopMatStore(h, nr3_gbuf, sg * 32u, 256u, LROW); }
        { MAT_H h = MAT_H(acc1); coopMatStore(h, nr3_gbuf, sg * 32u + 16u, 256u, LROW); }
    }
    barrier();

    // ---- blend: one value per token/channel, published once (canonical only) ----
    for (uint i = tid; i < 4096u; i += 256u) {
        const uint t3 = i / 128u, cp3 = i % 128u, c3 = cp3 * 2u;
        const uint tg3 = t0 + t3, q3 = tg3 >> 4u, s3 = tg3 & 15u;
        const int tx3 = 2 * int(wx) + pc.p0.z + int(q3 & 1u);
        const int ty3 = 2 * int(wy) + pc.p0.w + int(q3 >> 1u);
        const bool oob3 = (tx3 < 0 || ty3 < 0 || tx3 >= int(pc.p0.x) || ty3 >= int(pc.p0.y));
        if (oob3) continue;   // canonical copy holds no out-of-bounds tiles
        const uint px3 = uint(4 * tx3 + int(s3 % 4u)), py3 = uint(4 * ty3 + int(s3 / 4u));
        const uint cx3 = px3 >> 1u, cy3 = py3 >> 1u;
        const uint ps3 = (cy3 - (4u * wy + 2u * half3)) * 4u + (cx3 - 4u * wx);
        precise f16vec2 main_scaled = f16vec2(nr3_gbuf[ps3 * 256u + c3], nr3_gbuf[ps3 * 256u + c3 + 1u]);
        if (pc.p5.w == 1u) main_scaled = main_scaled * f16vec2(pw[pc.p5.z + pc.p5.y + c3], pw[pc.p5.z + pc.p5.y + c3 + 1u]);
        const f16vec2 skip_gain = f16vec2(pw[pc.p5.z + c3], pw[pc.p5.z + c3 + 1u]);
        const uint sa3 = pc.p4.z + nr3_io_at0(px3, py3, c3, pc.p6.x, pc.p5.y);
        const f16vec2 skip_input = f16vec2(sk[sa3], sk[sa3 + 1u]);
        precise f16vec2 skip_v = skip_input * skip_gain;
        precise f16vec2 value = main_scaled + skip_v;
        // The canonical store is the parent's statement, byte for byte: the
        // contract seed reader's input is unchanged.
        const uint ba3 = nr3_io_at0(px3, py3, c3, pc.p0.x * 4u, pc.p5.y);
        blout[ba3] = value.x; blout[ba3 + 1u] = value.y;
        // qX for block48's expand: same value, one code per element, written
        // once in this loop. c3 is even, so c3 and c3+1 never cross a 32-group.
        const uint tile3 = uint(ty3) * uint(pc.p0.x) + uint(tx3);
        const uint qb3 = ((tile3 * 8u + (c3 / 32u)) * 16u + s3) * 32u + (c3 % 32u);
        precise float q0 = float(value.x) * invX;
        precise float q1 = float(value.y) * invX;
        d_qx[qb3] = int8_t(clamp(roundEven(q0), -127.0, 127.0));
        d_qx[qb3 + 1u] = int8_t(clamp(roundEven(q1), -127.0, 127.0));
    }
}
