// New identity: original half S4 norm tree in QKV fragments, 102-derived.
// c128 D3 attention, ownership-reblocked variant (T2, 2026-10-18).
//
// Parent: candidates/amd-map-20261015/s3-c128-attention-complete/source/c128_attention_complete_fp16.comp
// (deployed SPV attention-c128-complete.spv, sha 35574d4d9cd64a08...).
//
// Same method as the gated c64-ownership-v1, but this is an INDEPENDENT identity:
// its own SPV, its own plan, its own four gates, its own double parent and its own
// counters.  It is not layered on the C64 candidate and the two are never mixed in
// one plan.
//
// WHAT CHANGED
//   shPhase[4096] (8192 B) is deleted.  Each score subgroup now owns 16 queries and
//   all 64 keys, the score is computed transposed (S^T = K.Q^T), the sealed C128
//   balanced denominator tree is reduced in lane with one subgroupShuffleXor(16),
//   and P^T becomes the PV B operand through the existing, hardware-verified
//   nrh_join_rows_to_B.  Shared goes 20,992 -> 12,800 B.
//
// THE ONE STRUCTURAL DIFFERENCE FROM THE PARENT'S CONTEXT STAGE, AND WHY IT IS SAFE
//   The parent computes ctx^T = P . V^T with A = P rows (query, key) and B = V
//   (feature, key): element (query m, feature n) = sum_k P[m][k] * V[n][k].
//   The new kernel computes the same output as (feature n, query m) with A = V^T
//   (feature, key) and B = P^T (key, query): element (n, m) = sum_k V[n][k] * P[m][k].
//   The products are the same two FP16 operands in the other order (FP16 multiply is
//   commutative and exact), and the K accumulation order j = 0,1,2,3 is unchanged, so
//   every element is bit-identical; only the store changes from RowMajor [query]
//   [feature] to ColumnMajor [feature][query] of the same canonical addresses.
//
// WHAT IS PRESERVED
//   * the QKV projection verbatim (K = 128, eight K16 steps, one A fragment for all six
//     accumulators, per-head weight offsets, the transposed V store);
//   * the norm owner pass (c128_norm_sum32, one thread per token) and the in-place scale
//     pass with the parent's exact expression `qkv * (half(shNorm[t]) * sh)`;
//   * FP32 accumulation for every MMA and exactly one MC->MH narrowing per output tile;
//     the one in-flight block per key block is narrowed immediately, so no FP32
//     accumulator array is held live;
//   * the sealed C128 probability tree term for term:
//       t_j[c] = P[16j+c] + P[16j+c+8]; part[c] = ((t0+t1)+t2)+t3
//       even = (part[0]+part[2])+(part[4]+part[6]); odd likewise; s = even+odd
//       inv = half(1.0 / max(float(s), 6.103515625e-05)); P := half(P*inv)
//   * the PV K order and the canonical gT address (w*64+query)*128 + 32*h + dim;
//   * the same logical MMA work: 64 score + 64 context MMAs per workgroup;
//   * every debug echo at the parent address, transposed where the accumulator
//     orientation changed.
//
// COST, RECORDED
//   + 4 of 8 subgroups idle during score and PV; not converted to ALU or ms, not free.
//   + GEN instructions rise (the in-lane tree, the reciprocal broadcast, four joins);
//     the native scratch/instruction reading is collected for this identity, not assumed.
//   - 8192 B of workgroup memory and three workgroup barriers are gone.

#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;
#include "nb03_swin_c128_common.glsl"
#include "register_handoff.glsl"

layout(set = 0, binding = 6) buffer YBuf { float16_t gY[]; };
layout(set = 0, binding = 7) buffer TBuf { float16_t gT[]; };

// N36-F05 arena shrink (2026-10-28): two 4096 B planes per head instead of three.
//   per-head base = (sg/4)*4096 half:  Q at +0, K at +2048, V reuses Q at +0.
//   Three 4096 B planes x two heads = 24576 B was the whole residency constraint;
//   two planes x two heads = 16384 B is the measured 2 -> 4 resident step.
//   V is a pure function of gY and the V weight tiles, so its projection moves to
//   after the last Q read and stores into the retired Q plane.  Q/K/V values, the
//   K accumulation order, every rounding point and every layout stride are unchanged.
shared float16_t qkv[12288];

#define MAT_H coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>

// One 8-key block of S^T = K.Q^T for 16 queries: rows = keys kb..kb+7, cols = queries.
MAT_H c128_score_block(uint kb, uint qg, uint h) {
    const bool debug = pc.p1.w != 0;
    MAT_C acc = MAT_C(float16_t(0.0));
    for (uint ki = 0u; ki < 2u; ++ki) {
        MAT_A a; coopMatLoad(a, qkv, ((gl_SubgroupID / 4u) * 4096u) + 2048u + (kb / 8u * 2u + ki) * 128u, 8u, LCOL); // K rows
        MAT_B b; coopMatLoad(b, qkv, ((gl_SubgroupID / 4u) * 4096u) + 0u + (qg * 32u + ki * 16u), 32u, LCOL);     // Q^T
        acc = coopMatMulAdd(a, b, acc);
    }
    if (debug) coopMatStore(acc, dbgf, 65536u + h * 4096u + qg * 64u + kb, 64u, LCOL);
    {
        MAT_C bias;
        coopMatLoad(bias, auxf, uint(pc.p4.w) + uint(h) * 4096u + qg * 64u + kb, 64u, LCOL);
        for (int ci = 0; ci < acc.length(); ++ci) {
            precise float biased = acc[ci] + bias[ci];
            acc[ci] = biased;
        }
        MAT_H values = MAT_H(acc);
        if (debug) coopMatStore(values, dbg, 163840u + h * 4096u + qg * 64u + kb, 64u, LCOL);
        for (int ci = 0; ci < values.length(); ++ci)
            values[ci] = c128_exp_h(values[ci]);
        if (debug) coopMatStore(values, dbg, 180224u + h * 4096u + qg * 64u + kb, 64u, LCOL);
        return values;
    }
}


// Intel CH layout: (row,col)=(2*component+lane/16,lane%16).
// Keep the existing S4 half tree, including each square/add rounding.
// Every tree node has one owner: cols 0..15 first pairs, 0..7/0..3/0..1/0
// for xor8/4/2/1. All lanes execute every shuffle before the owner condition,
// so inactive arithmetic owners can still supply the next gather. The final
// norm is computed only in col0 then broadcast to the sixteen dim consumers.
// This removes duplicate logical adds. It does NOT prove fewer SIMD issue
// slots: predication/branches/flattening and exact native cost remain unmeasured.
f16vec2 nr_norm_component(f16vec2 x0, f16vec2 x1, uint lane) {
    f16vec2 sq0=x0*x0, sq1=x1*x1;
    f16vec2 v=sq0+sq1;
    f16vec2 other=unpackFloat2x16(subgroupShuffleXor(packFloat2x16(v),8u));
    if((lane&15u)<8u) v=v+other;
    other=unpackFloat2x16(subgroupShuffleXor(packFloat2x16(v),4u));
    if((lane&15u)<4u) v=v+other;
    other=unpackFloat2x16(subgroupShuffleXor(packFloat2x16(v),2u));
    if((lane&15u)<2u) v=v+other;
    other=unpackFloat2x16(subgroupShuffleXor(packFloat2x16(v),1u));
    if((lane&15u)==0u) v=v+other;
    // Only col 0 evaluates the reciprocal norm; all sixteen columns receive
    // that result. Two independent token rows are present in each component.
    f16vec2 n=f16vec2(0.0);
    if((lane&15u)==0u) n=f16vec2(float16_t(inversesqrt(max(float(v.x),float(float16_t(0.000062))))),
                               float16_t(inversesqrt(max(float(v.y),float(float16_t(0.000062))))));
    return unpackFloat2x16(subgroupShuffle(packFloat2x16(n),lane&16u));
}

void nr_norm_qk_pair(inout MAT_H q0, inout MAT_H q1, inout MAT_H k0, inout MAT_H k1, float16_t scale, uint lane) {
    { f16vec2 n=nr_norm_component(f16vec2(q0[0],k0[0]),f16vec2(q1[0],k1[0]),lane); q0[0]=float16_t(q0[0]*(n.x*scale)); q1[0]=float16_t(q1[0]*(n.x*scale)); k0[0]=float16_t(k0[0]*n.y); k1[0]=float16_t(k1[0]*n.y); }
    { f16vec2 n=nr_norm_component(f16vec2(q0[1],k0[1]),f16vec2(q1[1],k1[1]),lane); q0[1]=float16_t(q0[1]*(n.x*scale)); q1[1]=float16_t(q1[1]*(n.x*scale)); k0[1]=float16_t(k0[1]*n.y); k1[1]=float16_t(k1[1]*n.y); }
    { f16vec2 n=nr_norm_component(f16vec2(q0[2],k0[2]),f16vec2(q1[2],k1[2]),lane); q0[2]=float16_t(q0[2]*(n.x*scale)); q1[2]=float16_t(q1[2]*(n.x*scale)); k0[2]=float16_t(k0[2]*n.y); k1[2]=float16_t(k1[2]*n.y); }
    { f16vec2 n=nr_norm_component(f16vec2(q0[3],k0[3]),f16vec2(q1[3],k1[3]),lane); q0[3]=float16_t(q0[3]*(n.x*scale)); q1[3]=float16_t(q1[3]*(n.x*scale)); k0[3]=float16_t(k0[3]*n.y); k1[3]=float16_t(k1[3]*n.y); }
}
void main() {
    const uint t_local = gl_LocalInvocationID.x;
    const uint sg = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const uint wx = (pc.p1.z != 0) ? uint(pc.p2.x) : gl_WorkGroupID.x;
    const uint wy = (pc.p1.z != 0) ? uint(pc.p2.y) : gl_WorkGroupID.y;
    const uint h = gl_WorkGroupID.z * 2u + sg / 4u;
    const uint w = wy * uint(pc.p1.x) + wx;
    const bool debug = pc.p1.w != 0;
    const uint wq = uint(pc.p3.w);

    // D2 writes all canonical window slots, including image-OOB tokens.
    // One head echoes the same complete Y debug view; no shared publication needed.
    if (debug && h == 0u) {
        for (uint e = t_local; e < 8192u; e += 256u)
            dbg[81920u + e] = gY[w * 8192u + e];
    }

    // AN6: one standard direct-Y A fragment feeds the four Q/K fragments.
    // N36: the two V fragments leave this loop and are rebuilt after the score
    // phase, where they can reuse the Q plane (see the V block below).
    for(uint row_phase=0u;row_phase<2u;++row_phase) {
    {
        uint m0 = (sg % 4u) * 8u + row_phase * 32u;
        MAT_C accQ0 = MAT_C(float16_t(0.0));
        MAT_C accQ1 = MAT_C(float16_t(0.0));
        MAT_C accK0 = MAT_C(float16_t(0.0));
        MAT_C accK1 = MAT_C(float16_t(0.0));
        for (uint ki = 0u; ki < 8u; ++ki) {
            uint k0 = ki * 16u;
            MAT_A a; coopMatLoad(a, gY, (w * 64u + m0) * 128u + k0, 128u, LROW);
            {
                MAT_B b0, b1;
                coopMatLoad(b0, pack, wq + (((96u * h + 0u) / 16u) * 8u + ki) * 256u, 16u, LCOL);
                coopMatLoad(b1, pack, wq + (((96u * h + 16u) / 16u) * 8u + ki) * 256u, 16u, LCOL);
                accQ0 = coopMatMulAdd(a, b0, accQ0);
                accQ1 = coopMatMulAdd(a, b1, accQ1);
            }
            {
                MAT_B b0, b1;
                coopMatLoad(b0, pack, wq + (((96u * h + 32u) / 16u) * 8u + ki) * 256u, 16u, LCOL);
                coopMatLoad(b1, pack, wq + (((96u * h + 48u) / 16u) * 8u + ki) * 256u, 16u, LCOL);
                accK0 = coopMatMulAdd(a, b0, accK0);
                accK1 = coopMatMulAdd(a, b1, accK1);
            }
        }
        MAT_H q0=MAT_H(accQ0),q1=MAT_H(accQ1);
        MAT_H k0=MAT_H(accK0),k1=MAT_H(accK1);
        if(debug) { coopMatStore(q0,dbg,90112u+m0*128u+32u*h,128u,LROW); coopMatStore(q1,dbg,90112u+m0*128u+32u*h+16u,128u,LROW); }
        if(debug) { coopMatStore(k0,dbg,98304u+m0*128u+32u*h,128u,LROW); coopMatStore(k1,dbg,98304u+m0*128u+32u*h+16u,128u,LROW); }
        nr_norm_qk_pair(q0,q1,k0,k1,float16_t(auxf[uint(pc.p5.x)+h]),lane);
        coopMatStore(q0,qkv,((gl_SubgroupID / 4u) * 4096u) + 0u+m0*32u,32u,LROW);
        coopMatStore(q1,qkv,((gl_SubgroupID / 4u) * 4096u) + 0u+m0*32u+16u,32u,LROW);
        if(debug) { coopMatStore(q0,dbg,114688u+m0*128u+32u*h,128u,LROW); coopMatStore(q1,dbg,114688u+m0*128u+32u*h+16u,128u,LROW); }
        coopMatStore(k0,qkv,((gl_SubgroupID / 4u) * 4096u) + 2048u+(m0/8u*2u+0u)*128u,8u,LCOL);
        coopMatStore(k1,qkv,((gl_SubgroupID / 4u) * 4096u) + 2048u+(m0/8u*2u+1u)*128u,8u,LCOL);
        if(debug) { coopMatStore(k0,dbg,122880u+m0*128u+32u*h,128u,LROW); coopMatStore(k1,dbg,122880u+m0*128u+32u*h+16u,128u,LROW); }
    }
    } // row_phase values retire before next phase
    barrier();

    // Q/K are normalized by their original projection owners before publication.
    // The existing barrier above publishes Q and K to every score/PV subgroup.
    // N36: the raw V debug echo moves with V (it now runs after the V publication
    // barrier below); same loop bounds, same destination, same values.

    // ---- score + denominator + PV, all in registers, four query-block owners ----
    { // every subgroup owns one query block
        const uint qg = (sg % 4u) * 16u;   // this subgroup owns queries qg..qg+15
        MAT_H p00 = c128_score_block(0u, qg, h);
        MAT_H p01 = c128_score_block(8u, qg, h);
        MAT_H p10 = c128_score_block(16u, qg, h);
        MAT_H p11 = c128_score_block(24u, qg, h);
        MAT_H p20 = c128_score_block(32u, qg, h);
        MAT_H p21 = c128_score_block(40u, qg, h);
        MAT_H p30 = c128_score_block(48u, qg, h);
        MAT_H p31 = c128_score_block(56u, qg, h);

        // Sealed C128 tree, rebuilt in lane (same derivation as c64-ownership-v1).
        precise float16_t part[4];
        part[0] = p00[0] + p01[0];
        part[1] = p00[1] + p01[1];
        part[2] = p00[2] + p01[2];
        part[3] = p00[3] + p01[3];
        part[0] = part[0] + (p10[0] + p11[0]);
        part[1] = part[1] + (p10[1] + p11[1]);
        part[2] = part[2] + (p10[2] + p11[2]);
        part[3] = part[3] + (p10[3] + p11[3]);
        part[0] = part[0] + (p20[0] + p21[0]);
        part[1] = part[1] + (p20[1] + p21[1]);
        part[2] = part[2] + (p20[2] + p21[2]);
        part[3] = part[3] + (p20[3] + p21[3]);
        part[0] = part[0] + (p30[0] + p31[0]);
        part[1] = part[1] + (p30[1] + p31[1]);
        part[2] = part[2] + (p30[2] + p31[2]);
        part[3] = part[3] + (p30[3] + p31[3]);
        precise float16_t mine = (part[0] + part[1]) + (part[2] + part[3]);
        f16vec2 ex = unpackFloat2x16(subgroupShuffleXor(packFloat2x16(f16vec2(mine, mine)), 16u));
        precise float16_t s = (lane / 16u == 0u) ? mine + ex.x : ex.x + mine;
        precise float16_t inv = float16_t(1.0 / max(float(s), 6.103515625e-05));
        // Both halves compute identically ordered low+high sum and identical inverse.
        precise float16_t ivq = inv;
        p00[0] = float16_t(p00[0] * ivq); p00[1] = float16_t(p00[1] * ivq);
        p00[2] = float16_t(p00[2] * ivq); p00[3] = float16_t(p00[3] * ivq);
        p01[0] = float16_t(p01[0] * ivq); p01[1] = float16_t(p01[1] * ivq);
        p01[2] = float16_t(p01[2] * ivq); p01[3] = float16_t(p01[3] * ivq);
        p10[0] = float16_t(p10[0] * ivq); p10[1] = float16_t(p10[1] * ivq);
        p10[2] = float16_t(p10[2] * ivq); p10[3] = float16_t(p10[3] * ivq);
        p11[0] = float16_t(p11[0] * ivq); p11[1] = float16_t(p11[1] * ivq);
        p11[2] = float16_t(p11[2] * ivq); p11[3] = float16_t(p11[3] * ivq);
        p20[0] = float16_t(p20[0] * ivq); p20[1] = float16_t(p20[1] * ivq);
        p20[2] = float16_t(p20[2] * ivq); p20[3] = float16_t(p20[3] * ivq);
        p21[0] = float16_t(p21[0] * ivq); p21[1] = float16_t(p21[1] * ivq);
        p21[2] = float16_t(p21[2] * ivq); p21[3] = float16_t(p21[3] * ivq);
        p30[0] = float16_t(p30[0] * ivq); p30[1] = float16_t(p30[1] * ivq);
        p30[2] = float16_t(p30[2] * ivq); p30[3] = float16_t(p30[3] * ivq);
        p31[0] = float16_t(p31[0] * ivq); p31[1] = float16_t(p31[1] * ivq);
        p31[2] = float16_t(p31[2] * ivq); p31[3] = float16_t(p31[3] * ivq);
        if (debug) {
            coopMatStore(p00, dbg, 196608u + h * 4096u + qg * 64u + 0u, 64u, LCOL);
            coopMatStore(p01, dbg, 196608u + h * 4096u + qg * 64u + 8u, 64u, LCOL);
            coopMatStore(p10, dbg, 196608u + h * 4096u + qg * 64u + 16u, 64u, LCOL);
            coopMatStore(p11, dbg, 196608u + h * 4096u + qg * 64u + 24u, 64u, LCOL);
            coopMatStore(p20, dbg, 196608u + h * 4096u + qg * 64u + 32u, 64u, LCOL);
            coopMatStore(p21, dbg, 196608u + h * 4096u + qg * 64u + 40u, 64u, LCOL);
            coopMatStore(p30, dbg, 196608u + h * 4096u + qg * 64u + 48u, 64u, LCOL);
            coopMatStore(p31, dbg, 196608u + h * 4096u + qg * 64u + 56u, 64u, LCOL);
        }

        // ---- N36: V projection, relocated after the last Q/K read ----
        // The V projection reads only gY and the V weight tiles: not Q, not K, not S,
        // not P, not den.  Executing it here means every Q read of this workgroup has
        // already been issued, so the Q plane is retired and V can be stored into it.
        // Token ownership moves from {8t, 8t+32} to {16t, 16t+8}: this subgroup's V
        // store footprint is then exactly the 512 half of Q it read itself
        // (queries qg..qg+15 = 16t..16t+15), which is why the Q-read -> V-write WAR
        // needs only the workgroup barrier below and not a cross-owner protocol.
        // Unchanged: the 8 k-steps in the same order, the same A rows per token, the
        // same V weight tiles, one MC->MH narrowing per output tile.
        barrier();
        {
            const uint vt = (sg % 4u) * 16u;
            MAT_C accV0a = MAT_C(float16_t(0.0));
            MAT_C accV1a = MAT_C(float16_t(0.0));
            MAT_C accV0b = MAT_C(float16_t(0.0));
            MAT_C accV1b = MAT_C(float16_t(0.0));
            for (uint ki = 0u; ki < 8u; ++ki) {
                uint k0 = ki * 16u;
                MAT_A a0; coopMatLoad(a0, gY, (w * 64u + vt) * 128u + k0, 128u, LROW);
                MAT_A a1; coopMatLoad(a1, gY, (w * 64u + vt + 8u) * 128u + k0, 128u, LROW);
                MAT_B b0, b1;
                coopMatLoad(b0, pack, wq + (((96u * h + 64u) / 16u) * 8u + ki) * 256u, 16u, LCOL);
                coopMatLoad(b1, pack, wq + (((96u * h + 80u) / 16u) * 8u + ki) * 256u, 16u, LCOL);
                accV0a = coopMatMulAdd(a0, b0, accV0a);
                accV1a = coopMatMulAdd(a0, b1, accV1a);
                accV0b = coopMatMulAdd(a1, b0, accV0b);
                accV1b = coopMatMulAdd(a1, b1, accV1b);
            }
            MAT_H narrowed = MAT_H(accV0a);
            coopMatStore(narrowed, qkv, ((gl_SubgroupID / 4u) * 4096u) + 0u + vt * 32u, 32u, LROW);
            narrowed = MAT_H(accV1a);
            coopMatStore(narrowed, qkv, ((gl_SubgroupID / 4u) * 4096u) + 0u + vt * 32u + 16u, 32u, LROW);
            narrowed = MAT_H(accV0b);
            coopMatStore(narrowed, qkv, ((gl_SubgroupID / 4u) * 4096u) + 0u + (vt + 8u) * 32u, 32u, LROW);
            narrowed = MAT_H(accV1b);
            coopMatStore(narrowed, qkv, ((gl_SubgroupID / 4u) * 4096u) + 0u + (vt + 8u) * 32u + 16u, 32u, LROW);
        }
        // V is published to the three other query-block owners here.
        barrier();
        if(debug) {
            for(uint e=t_local;e<2048u;e+=256u) {
                uint dst=(e/32u)*128u+32u*h+e%32u;
                dbg[106496u+dst]=qkv[((gl_SubgroupID / 4u) * 4096u) + 0u + e];
            }
        }

        // ---- PV: (feature, query) = V^T . P^T, K order j = 0,1,2,3 unchanged ----
        MAT_C c0 = MAT_C(float16_t(0.0));
        MAT_C c1 = MAT_C(float16_t(0.0));
        MAT_C c2 = MAT_C(float16_t(0.0));
        MAT_C c3 = MAT_C(float16_t(0.0));
        {
            NRH_B b = nrh_join_rows_to_B(p00, p01);
            MAT_A a;
            coopMatLoad(a, qkv, ((gl_SubgroupID / 4u) * 4096u) + 0u + 0u * 32u + 0u, 32u, LCOL);
            c0 = coopMatMulAdd(a, b, c0);
            coopMatLoad(a, qkv, ((gl_SubgroupID / 4u) * 4096u) + 0u + 0u * 32u + 8u, 32u, LCOL);
            c1 = coopMatMulAdd(a, b, c1);
            coopMatLoad(a, qkv, ((gl_SubgroupID / 4u) * 4096u) + 0u + 0u * 32u + 16u, 32u, LCOL);
            c2 = coopMatMulAdd(a, b, c2);
            coopMatLoad(a, qkv, ((gl_SubgroupID / 4u) * 4096u) + 0u + 0u * 32u + 24u, 32u, LCOL);
            c3 = coopMatMulAdd(a, b, c3);
        }
        {
            NRH_B b = nrh_join_rows_to_B(p10, p11);
            MAT_A a;
            coopMatLoad(a, qkv, ((gl_SubgroupID / 4u) * 4096u) + 0u + 16u * 32u + 0u, 32u, LCOL);
            c0 = coopMatMulAdd(a, b, c0);
            coopMatLoad(a, qkv, ((gl_SubgroupID / 4u) * 4096u) + 0u + 16u * 32u + 8u, 32u, LCOL);
            c1 = coopMatMulAdd(a, b, c1);
            coopMatLoad(a, qkv, ((gl_SubgroupID / 4u) * 4096u) + 0u + 16u * 32u + 16u, 32u, LCOL);
            c2 = coopMatMulAdd(a, b, c2);
            coopMatLoad(a, qkv, ((gl_SubgroupID / 4u) * 4096u) + 0u + 16u * 32u + 24u, 32u, LCOL);
            c3 = coopMatMulAdd(a, b, c3);
        }
        {
            NRH_B b = nrh_join_rows_to_B(p20, p21);
            MAT_A a;
            coopMatLoad(a, qkv, ((gl_SubgroupID / 4u) * 4096u) + 0u + 32u * 32u + 0u, 32u, LCOL);
            c0 = coopMatMulAdd(a, b, c0);
            coopMatLoad(a, qkv, ((gl_SubgroupID / 4u) * 4096u) + 0u + 32u * 32u + 8u, 32u, LCOL);
            c1 = coopMatMulAdd(a, b, c1);
            coopMatLoad(a, qkv, ((gl_SubgroupID / 4u) * 4096u) + 0u + 32u * 32u + 16u, 32u, LCOL);
            c2 = coopMatMulAdd(a, b, c2);
            coopMatLoad(a, qkv, ((gl_SubgroupID / 4u) * 4096u) + 0u + 32u * 32u + 24u, 32u, LCOL);
            c3 = coopMatMulAdd(a, b, c3);
        }
        {
            NRH_B b = nrh_join_rows_to_B(p30, p31);
            MAT_A a;
            coopMatLoad(a, qkv, ((gl_SubgroupID / 4u) * 4096u) + 0u + 48u * 32u + 0u, 32u, LCOL);
            c0 = coopMatMulAdd(a, b, c0);
            coopMatLoad(a, qkv, ((gl_SubgroupID / 4u) * 4096u) + 0u + 48u * 32u + 8u, 32u, LCOL);
            c1 = coopMatMulAdd(a, b, c1);
            coopMatLoad(a, qkv, ((gl_SubgroupID / 4u) * 4096u) + 0u + 48u * 32u + 16u, 32u, LCOL);
            c2 = coopMatMulAdd(a, b, c2);
            coopMatLoad(a, qkv, ((gl_SubgroupID / 4u) * 4096u) + 0u + 48u * 32u + 24u, 32u, LCOL);
            c3 = coopMatMulAdd(a, b, c3);
        }
        // Canonical T: gT[(w*64+query)*128 + 32*h + dim], one narrowing per tile.
        MAT_H n0 = MAT_H(c0);
        MAT_H n1 = MAT_H(c1);
        MAT_H n2 = MAT_H(c2);
        MAT_H n3 = MAT_H(c3);
        coopMatStore(n0, gT, (w * 64u + qg) * 128u + 32u * h + 0u, 128u, LCOL);
        coopMatStore(n1, gT, (w * 64u + qg) * 128u + 32u * h + 8u, 128u, LCOL);
        coopMatStore(n2, gT, (w * 64u + qg) * 128u + 32u * h + 16u, 128u, LCOL);
        coopMatStore(n3, gT, (w * 64u + qg) * 128u + 32u * h + 24u, 128u, LCOL);
        if (debug) {
            coopMatStore(n0, dbg, 212992u + qg * 128u + 32u * h + 0u, 128u, LCOL);
            coopMatStore(n1, dbg, 212992u + qg * 128u + 32u * h + 8u, 128u, LCOL);
            coopMatStore(n2, dbg, 212992u + qg * 128u + 32u * h + 16u, 128u, LCOL);
            coopMatStore(n3, dbg, 212992u + qg * 128u + 32u * h + 24u, 128u, LCOL);
        }
    }
