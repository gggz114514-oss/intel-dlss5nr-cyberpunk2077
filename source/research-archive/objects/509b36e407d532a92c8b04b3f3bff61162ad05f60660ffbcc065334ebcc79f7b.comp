// n23-f05-shape probe P1: half accumulator 8x32 + 16x32 B fragment.
// Purpose: does glslang 16.5.0 accept coopmat<float16_t, Subgroup, 8, 32, Accumulator>
// and a matching 8x16 A / 16x32 B MMA, and does the SPIR-V pass the CPU validator?
#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require

layout(local_size_x = 32) in;

layout(set = 0, binding = 0) buffer InBuf  { float16_t inbuf[]; };
layout(set = 0, binding = 1) buffer OutBuf { float16_t outbuf[]; };

#define P_A coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseA>
#define P_B coopmat<float16_t, gl_ScopeSubgroup, 16, 32, gl_MatrixUseB>
#define P_C coopmat<float16_t, gl_ScopeSubgroup, 8, 32, gl_MatrixUseAccumulator>

void main() {
    P_A a; coopMatLoad(a, inbuf, 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
    P_B b; coopMatLoad(b, inbuf, 0u, 32u, gl_CooperativeMatrixLayoutColumnMajor);
    P_C c = P_C(float16_t(0.0));
    c = coopMatMulAdd(a, b, c);
    coopMatStore(c, outbuf, 0u, 32u, gl_CooperativeMatrixLayoutRowMajor);
}
