        float ya = max(max(nr_i8_amax(y0), nr_i8_amax(y1)),
                       max(nr_i8_amax(y2), nr_i8_amax(y3)));
        float ysum = nr_i8_sgmax(ya);
        float sY = max(ysum, 1e-12) / 127.0;
