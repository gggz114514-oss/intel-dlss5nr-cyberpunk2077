            a0 = I8C(0);
            coopMatLoad(wa, wb8, C32I8B_WK + 0u, 32u, LCOL);
            a0 = coopMatMulAdd(wa, yq8, a0);
            zk0 = nr_i8_deq2(a0, C32I8B_SK + 0u, sY);
            a0 = I8C(0);
            coopMatLoad(wa, wb8, C32I8B_WK + 1024u, 32u, LCOL);
