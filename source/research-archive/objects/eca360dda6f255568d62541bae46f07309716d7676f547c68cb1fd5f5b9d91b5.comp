            p4[0] = p4[0] * r;
        }
        {
            float16_t r=inv;
            p4[1] = p4[1] * r;
        }
        {
            float16_t r=inv;
            p4[2] = p4[2] * r;
        }
        {
            float16_t r=inv;
            p4[3] = p4[3] * r;
        }
        if (debug) coopMatStore(p4, dbg, 14336u+t0*64u+32u, 64u, LCOL);
        {
            float16_t r=inv;
            p5[0] = p5[0] * r;
        }
        {
            float16_t r=inv;
            p5[1] = p5[1] * r;
        }
        {
            float16_t r=inv;
            p5[2] = p5[2] * r;
        }
        {
            float16_t r=inv;
            p5[3] = p5[3] * r;
        }
        if (debug) coopMatStore(p5, dbg, 14336u+t0*64u+40u, 64u, LCOL);
        {
            float16_t r=inv;
            p6[0] = p6[0] * r;
        }
        {
            float16_t r=inv;
            p6[1] = p6[1] * r;
        }
        {
            float16_t r=inv;
            p6[2] = p6[2] * r;
        }
        {
            float16_t r=inv;
            p6[3] = p6[3] * r;
        }
        if (debug) coopMatStore(p6, dbg, 14336u+t0*64u+48u, 64u, LCOL);
        {
            float16_t r=inv;
            p7[0] = p7[0] * r;
        }
        {
            float16_t r=inv;
            p7[1] = p7[1] * r;
        }
        {
            float16_t r=inv;
            p7[2] = p7[2] * r;
        }
        {
            float16_t r=inv;
            p7[3] = p7[3] * r;
        }
        if (debug) coopMatStore(p7, dbg, 14336u+t0*64u+56u, 64u, LCOL);
        // ---- C32-I8 P tile: one scalar per subgroup over 64 keys x 16
        // tokens; the PV accumulator spans all 64 keys, so it must be one.
        float sP;
        {
            float pa = max(max(nr_i8_amax(p0), nr_i8_amax(p1)), max(nr_i8_amax(p2), nr_i8_amax(p3)));
            pa = max(pa, max(max(nr_i8_amax(p4), nr_i8_amax(p5)), max(nr_i8_amax(p6), nr_i8_amax(p7))));
            float ps = nr_i8_sgmax(pa);
            sP = max(ps, 1e-12) / 127.0;
            float invP = 127.0 / max(ps, 1e-12);
            nr_i8_put_p(p0, 0u, 0u, sg * 1024u, invP);
            nr_i8_put_p(p1, 8u, 0u, sg * 1024u, invP);
            nr_i8_put_p(p2, 16u, 0u, sg * 1024u, invP);
            nr_i8_put_p(p3, 24u, 0u, sg * 1024u, invP);
            nr_i8_put_p(p4, 0u, 512u, sg * 1024u, invP);
            nr_i8_put_p(p5, 8u, 512u, sg * 1024u, invP);
            nr_i8_put_p(p6, 16u, 512u, sg * 1024u, invP);
            nr_i8_put_p(p7, 24u, 512u, sg * 1024u, invP);
            subgroupMemoryBarrierShared();
            subgroupBarrier();
        }
        // Ctx^T = V^T * P^T; reciprocal and per-entry H already applied.
        // INT8: 4 channel fragments x 2 key chunks of 32 (was 16 FP16 MMA).
        I8C tc0 = I8C(0);
        I8C tc1 = I8C(0);
        I8C tc2 = I8C(0);
        I8C tc3 = I8C(0);
        {
            I8A a; I8B pb;
            coopMatLoad(pb, sE8, C32I8B_P8 + sg * 1024u + 0u, 32u, LCOL);
            coopMatLoad(a, shV8, 0u, 32u, LCOL);
            tc0 = coopMatMulAdd(a, pb, tc0);
            coopMatLoad(a, shV8, 8u, 32u, LCOL);
            tc1 = coopMatMulAdd(a, pb, tc1);
            coopMatLoad(a, shV8, 16u, 32u, LCOL);
            tc2 = coopMatMulAdd(a, pb, tc2);
            coopMatLoad(a, shV8, 24u, 32u, LCOL);
            tc3 = coopMatMulAdd(a, pb, tc3);
            coopMatLoad(pb, sE8, C32I8B_P8 + sg * 1024u + 512u, 32u, LCOL);
            coopMatLoad(a, shV8, 1024u, 32u, LCOL);
            tc0 = coopMatMulAdd(a, pb, tc0);
            coopMatLoad(a, shV8, 1032u, 32u, LCOL);
            tc1 = coopMatMulAdd(a, pb, tc1);
            coopMatLoad(a, shV8, 1040u, 32u, LCOL);
            tc2 = coopMatMulAdd(a, pb, tc2);
            coopMatLoad(a, shV8, 1048u, 32u, LCOL);
            tc3 = coopMatMulAdd(a, pb, tc3);
        }
        NRH_C tcd0 = nr_i8_deq_s(tc0, sV * sP);
        NRH_C tcd1 = nr_i8_deq_s(tc1, sV * sP);
        NRH_C tcd2 = nr_i8_deq_s(tc2, sV * sP);
        NRH_C tcd3 = nr_i8_deq_s(tc3, sV * sP);
        NRH_CH ctx0 = nrh_narrow(tcd0);
        if (debug) coopMatStore(ctx0, dbg, 18432u+t0*32u+0u, 32u, LCOL);
        NRH_CH ctx1 = nrh_narrow(tcd1);
        if (debug) coopMatStore(ctx1, dbg, 18432u+t0*32u+8u, 32u, LCOL);
        NRH_CH ctx2 = nrh_narrow(tcd2);
        if (debug) coopMatStore(ctx2, dbg, 18432u+t0*32u+16u, 32u, LCOL);
        NRH_CH ctx3 = nrh_narrow(tcd3);
        if (debug) coopMatStore(ctx3, dbg, 18432u+t0*32u+24u, 32u, LCOL);
        // ---- C32-I8 Ctx tile for the output projection ----------
        float sC;
        {
            float ca = max(max(nr_i8_amax(ctx0), nr_i8_amax(ctx1)), max(nr_i8_amax(ctx2), nr_i8_amax(ctx3)));
            float cs = nr_i8_sgmax(ca);
            sC = max(cs, 1e-12) / 127.0;
            float invC = 127.0 / max(cs, 1e-12);
            nr_i8_put_ys(ctx0, 0u, sg * 512u, invC);
            nr_i8_put_ys(ctx1, 8u, sg * 512u, invC);
            nr_i8_put_ys(ctx2, 16u, sg * 512u, invC);
            nr_i8_put_ys(ctx3, 24u, sg * 512u, invC);
            subgroupMemoryBarrierShared();
            subgroupBarrier();
        }
        I8B cb8;
        coopMatLoad(cb8, sX8, sg * 512u, 32u, LCOL);
        // Projection residual is H(Y*ars) BEFORE original K0,16.
        NRH_C oc0;
        {
            NRH_CH scale;
            coopMatLoad(scale,wb,uint(pc.p2.y)+0u,0u,LCOL);
            NRH_CH seed = y0 * scale;
            oc0 = nrh_widen_exact(seed);
        }
        NRH_C oc1;
        {
            NRH_CH scale;
            coopMatLoad(scale,wb,uint(pc.p2.y)+8u,0u,LCOL);
            NRH_CH seed = y1 * scale;
            oc1 = nrh_widen_exact(seed);
        }
        NRH_C oc2;
        {
            NRH_CH scale;
            coopMatLoad(scale,wb,uint(pc.p2.y)+16u,0u,LCOL);
            NRH_CH seed = y2 * scale;
            oc2 = nrh_widen_exact(seed);
        }
        NRH_C oc3;
        {
            NRH_CH scale;
            coopMatLoad(scale,wb,uint(pc.p2.y)+24u,0u,LCOL);
            NRH_CH seed = y3 * scale;
            oc3 = nrh_widen_exact(seed);
        }
        {
            I8A wa; I8C a0;
            a0 = I8C(0);
            coopMatLoad(wa, wb8, C32I8B_WO + 0u, 32u, LCOL);
            a0 = coopMatMulAdd(wa, cb8, a0);
            oc0 = nr_i8_deq2_add(a0, C32I8B_SO + 0u, sC, oc0);
            a0 = I8C(0);
            coopMatLoad(wa, wb8, C32I8B_WO + 1024u, 32u, LCOL);
            a0 = coopMatMulAdd(wa, cb8, a0);
            oc1 = nr_i8_deq2_add(a0, C32I8B_SO + 8u, sC, oc1);
            a0 = I8C(0);
            coopMatLoad(wa, wb8, C32I8B_WO + 2048u, 32u, LCOL);
            a0 = coopMatMulAdd(wa, cb8, a0);
            oc2 = nr_i8_deq2_add(a0, C32I8B_SO + 16u, sC, oc2);
            a0 = I8C(0);
            coopMatLoad(wa, wb8, C32I8B_WO + 3072u, 32u, LCOL);
            a0 = coopMatMulAdd(wa, cb8, a0);
            oc3 = nr_i8_deq2_add(a0, C32I8B_SO + 24u, sC, oc3);
        }
        NRH_CH o0 = nrh_narrow(oc0);
        if (debug) coopMatStore(o0,dbg,20480u+t0*32u+0u,32u,LCOL);
        bool o_oob0;
        uint o_base0=nr_tok_addr(t0,0u,wx,wy,shift,tiles_x,o_oob0);
        if (!o_oob0) coopMatStore(o0,imgout,o_base0,16u,LCOL);
        NRH_CH o1 = nrh_narrow(oc1);
        if (debug) coopMatStore(o1,dbg,20480u+t0*32u+8u,32u,LCOL);
        bool o_oob1;
        uint o_base1=nr_tok_addr(t0,8u,wx,wy,shift,tiles_x,o_oob1);
        if (!o_oob1) coopMatStore(o1,imgout,o_base1,16u,LCOL);
        NRH_CH o2 = nrh_narrow(oc2);
        if (debug) coopMatStore(o2,dbg,20480u+t0*32u+16u,32u,LCOL);
        bool o_oob2;
        uint o_base2=nr_tok_addr(t0,16u,wx,wy,shift,tiles_x,o_oob2);
        if (!o_oob2) coopMatStore(o2,imgout,o_base2,16u,LCOL);
        NRH_CH o3 = nrh_narrow(oc3);
        if (debug) coopMatStore(o3,dbg,20480u+t0*32u+24u,32u,LCOL);
        bool o_oob3;
        uint o_base3=nr_tok_addr(t0,24u,wx,wy,shift,tiles_x,o_oob3);
        if (!o_oob3) coopMatStore(o3,imgout,o_base3,16u,LCOL);
    }
}

void main() {
    nrf2_project_and_blend();
    nr_body_stage();
}

// ---- T3 transport: identity subgroup round-trips removed -----------------
// nrh_unpack2(p) performed subgroupShuffle(p, lane^1) twice; the two shuffles
// are exact inverses for every lane, so the helper equals unpackFloat2x16(p)
// for every input.  nrh_materialize(h) is the same pack/unpack round trip on
// both component pairs (identity), nrh_narrow's extra materialize and the
// nrh_widen_exact pack/unpack round trips are identities too.  No arithmetic,
// conversion, cooperative-matrix or memory-access instruction changes.
