                e0[0] = nr_act_h(e0[0]);
                e0[1] = nr_act_h(e0[1]);
                e0[2] = nr_act_h(e0[2]);
                e0[3] = nr_act_h(e0[3]);
                if (debug) coopMatStore(e0, dbg, t0*128u+0u, 128u, LCOL);
