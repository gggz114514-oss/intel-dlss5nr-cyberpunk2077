// r19_pre_c64_i8mma.comp -- R19 card candidate for PASS 143 "c3x_pre_c64"
// (C64 block62-class "pre": 16x64 projection + four-corner blend, canonical
// publication only).  THIS IS THE PASS WITH THE STRIDE-16 TRAP.
//
// Parent (unchanged everywhere else): candidates/amd-netorg-t3d-20261018/
// c64-canonical-only-v1/source/c3x_pre_c64.comp, deployed as
// .../c3x_pre_c64.spv sha256
// c690b9aa292b875a492a798e13f1c28197d136763f93f727f828dd2a045040a0 (14,308 B),
// which is what plan-g3-production.txt PASS 143 binds.  Reproduced byte-identically
// from the parent source by this card (spv/parent_r19_repro.spv).
//
// THE TRAP (why this pass is not a copy of R18)
//   The parent's A operand is NOT a [row][channel] gather tile: it is read
//   straight out of GLOBAL binding 11 (x65) with a CONSTANT row stride of 16
//   halves and a k16-block stride of 256 halves:
//       coopMatLoad(a, x65, abase + (kc/16)*256 + rh*128, 16, LROW)
//   i.e. the global tensor is [tile][k16][row][16] (tile = 2048 halves).  A K32
//   int8 fragment needs 32 CONSECUTIVE k per row, which that layout cannot
//   provide: k=0..15 and k=16..31 of the same row are 256 halves apart.  Reading
//   "K32 across a stride-16 layout" would silently mix 16 different rows into the
//   K dimension.  This candidate therefore implements an EXPLICIT CONVERSION
//   BRIDGE inside the dispatch (option "bridge" of the card; the producer-side
//   layout change is left as a later optimisation, see REPORT G-R19-1):
//       bridge_half_index(tile, row, k) = abase + row*16 + (k/16)*256 + (k%16)
//       abase = pc.p4.x + tile*(K/16)*256,  tile = wy*pc.p1.x + wx
//   PROOF that this is the parent's own element mapping (not a re-interpretation):
//   the parent's fragment element (i,j) of the kc block sits at
//       abase + rh*128 + (kc/16)*256 + i*16 + j,   row = rh*8+i, k = kc+j
//   and since kc is a multiple of 16 and j < 16, (k/16) = kc/16 and (k%16) = j,
//   so the bridge index equals the parent index for every (row, k).
//   The proof is executed element-wise (all 1008 tiles x 16 rows x 128 k) by
//   build/r16-r18-r19-proj/prove_r19_bridge.py -> evidence/R19-BRIDGE-PROOF.json.
//   TAIL/COVERAGE: K = 128 = 4 x 32 (no K tail, every K32 step is full), rows are
//   exactly 16 = 2 row groups x 8 (no row tail), channels 64 = 2 output groups x
//   32; every tile of the dispatch grid exists in the producer tensor
//   (42*24 = 1008 tiles = the whole 168x96x128 layout), so there is no
//   out-of-bounds row to mask -- the parent has no guard here and neither does
//   the bridge.
//
// WHAT CHANGES
//   1. the two FP16 M8N16K16 MMAs -> two INT8 M8N16K32 MMAs (int32 accumulator);
//      the K16 loop over pc.p5.x is paired into K32 steps, B fragment pairing
//      (n0 group, n0+16 group) unchanged;
//   2. the A operand now arrives through the bridge above into a shared INT8 tile
//      with a PER-ROW absmax and the R17-fixed quantiser:
//          inv3  = (m3 > 0) ? 127.0 / m3 : 0.0
//          code  = int8_t(clamp(roundEven(float(h) * inv3), -127, 127))
//          rowF  = 1.0 / inv3          <-- R17-FIX-A (dequant = amax/127)
//   3. the weights come from the NEW binding 13 offline INT8 pack (r07 tile
//      convention + per-output-channel f32 scale) instead of the FP16 matrix at
//      pw[p4.y ...]; binding 8 stays bound for the two half gain records only;
//   4. the epilogue dequantises INT32 -> f32 with ONE product (rowF*colF), then
//      narrows with MAT_H where the parent narrowed and stores into the parent's
//      own `nr3_proj` at the parent's own addresses (rh*8*64 + cg*32 [+16],
//      stride 64).
//
// WHAT DOES NOT CHANGE
//   * the `if (sg < 4u)` projection ownership (4 subgroups project, 4 idle) --
//     the bridge/quantise step uses all 256 threads, the MMA still uses 4 SGs;
//   * the blend loop verbatim (skip read, half gains, `precise` statements,
//     canonical io_at0 store to binding 10);
//   * the retained-descriptor bindings (11, 12) and all 32 push words;
//   * the global layout of binding 11: this candidate writes NO new tensor, so
//     no other reader of block61_out is affected (readers enumerated in
//     evidence/R19-READERS.json).
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_8bit_storage : require

layout(local_size_x = 256) in;
#include "nb05_swin_c64_common.glsl"

layout(set = 0, binding = 8) buffer Nr3Pack { float16_t pw[]; };
layout(set = 0, binding = 9) buffer Nr3Skip { float16_t sk[]; };
layout(set = 0, binding = 10) buffer Nr3BlendOut { float16_t blout[]; };
layout(set = 0, binding = 11) buffer Nr3ProjIn { float16_t x65[]; };
// Retained descriptor only, exactly as the parent.
layout(set = 0, binding = 12) buffer C3X { float16_t xg[]; };

shared float16_t nr3_proj[1024u];

// ---- candidate shared additions -------------------------------------------
// nr3_a   : the bridge output, [16 rows][K=128] int8 = 2048 B
// nr3_abs : per-row |A| partial maxima (16 lanes per row)
// nr3_srow: per-row DEQUANT scale (amax/127), consumed by rowF
shared int8_t nr3_a[2048u];
shared float  nr3_abs[256u];
shared float  nr3_srow[16u];

// ---- NEW binding 13: offline INT8 weight pack ------------------------------
//   0      int8  W[N=64][K=128]  idx = (n/16)*(K/32)*512 + (k/32)*512 + (n%16)*32 + (k%32)
//   8,192  f32   sW[n] = amax_k|W[n][k]| / 127
layout(set = 0, binding = 13) buffer Nr3PreW8 {
    int8_t wq[8192];
    float  wsc[64];
};

#define MAT_H coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>
#define I8_A  coopmat<int8_t,   gl_ScopeSubgroup, 8, 32, gl_MatrixUseA>
#define I8_B  coopmat<int8_t,   gl_ScopeSubgroup, 32, 16, gl_MatrixUseB>
#define I32_C coopmat<int,      gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>
#define F32_C coopmat<float,    gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>

// ioport_common.glsl io_at, layout 0 (spatial 4x4 tiles, 16 channels).
uint nr3_io_at0(uint px, uint py, uint c, uint W, uint C) {
    uint t = ((py / 4u) * (W / 4u) + px / 4u) * 16u + 4u * (py % 4u) + px % 4u;
    return ((t / 16u) * (C / 16u) + c / 16u) * 256u + (t % 16u) * 16u + c % 16u;
}

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint sg = tid / 32u;
    const uint wx = (pc.p1.z != 0) ? uint(pc.p2.x) : gl_WorkGroupID.x;
    const uint wy = (pc.p1.z != 0) ? uint(pc.p2.y) : gl_WorkGroupID.y;
    const uint K3 = uint(pc.p5.x);              // 128
    const uint tile = wy * uint(pc.p1.x) + wx;  // parent's tile index
    const uint abase = pc.p4.x + tile * (K3 / 16u) * 256u;

    // ---- BRIDGE: [tile][k16][row][16] half  ->  [row][k] int8 + per-row scale --
    // 256 threads / 16 rows = 16 lanes per row, K3/16 contiguous k per lane.
    {
        const uint br = tid / 16u;              // row 0..15
        const uint bl = tid % 16u;              // k block within the row
        const uint kb = bl * (K3 / 16u);
        const uint rb = abase + br * 16u;       // row base inside the tile
        float amax = 0.0;
        for (uint i = 0u; i < K3 / 16u; ++i) {
            const uint k = kb + i;
            amax = max(amax, abs(float(x65[rb + (k / 16u) * 256u + (k % 16u)])));
        }
        nr3_abs[br * 16u + bl] = amax;
        barrier();
        float m3 = 0.0;
        for (uint j = 0u; j < 16u; ++j) m3 = max(m3, nr3_abs[br * 16u + j]);
        const float inv3 = (m3 > 0.0) ? 127.0 / m3 : 0.0;
        for (uint i = 0u; i < K3 / 16u; ++i) {
            const uint k = kb + i;
            precise float c3v =
                float(x65[rb + (k / 16u) * 256u + (k % 16u)]) * inv3;
            nr3_a[br * K3 + k] =
                int8_t(clamp(roundEven(c3v), -127.0, 127.0));
        }
        // R17-FIX-A: the DEQUANT scale, never the quantiser step.
        if (bl == 0u) nr3_srow[br] = (inv3 > 0.0) ? (1.0 / inv3) : 0.0;
        barrier();
    }

    // ---- projection: INT8 M8N16K32, int32 accumulate (4 subgroups, as parent) --
    if (sg < 4u) {
        const uint rh = sg >> 1u, cg = sg & 1u;
        const uint kst = K3 / 32u;              // 4 K32 steps
        const uint n16s = kst * 512u;           // per-n16 tile stride (= K*16 bytes)
        const uint wbase = (cg * 32u / 16u) * n16s;
        I32_C acc0 = I32_C(0), acc1 = I32_C(0);
        for (uint ki = 0u; ki < kst; ++ki) {
            I8_A a; I8_B b0, b1;
            coopMatLoad(a, nr3_a, rh * 8u * K3 + ki * 32u, K3, LROW);
            coopMatLoad(b0, wq, wbase + ki * 512u, 32u, LCOL);
            coopMatLoad(b1, wq, wbase + n16s + ki * 512u, 32u, LCOL);
            acc0 = coopMatMulAdd(a, b0, acc0);
            acc1 = coopMatMulAdd(a, b1, acc1);
        }
        // NB: no barrier inside this `if` -- the parent has none either, and a
        // workgroup barrier under `if (sg < 4u)` would be divergent control flow.
        // The barrier that orders the bridge codes (written by all 256 threads)
        // against these A loads is the one just above, outside the `if`.
        F32_C rowF;
        coopMatLoad(rowF, nr3_srow, rh * 8u, 0u, LCOL);   // per-row, stride 0
        {
            F32_C colF;
            coopMatLoad(colF, wsc, cg * 32u, 0u, LROW);   // per-column, stride 0
            F32_C f = F32_C(acc0);
            for (uint c = 0u; c < f.length(); ++c)
                f[c] = f[c] * (rowF[c] * colF[c]);
            MAT_H h = MAT_H(f);
            coopMatStore(h, nr3_proj, rh * 8u * 64u + cg * 32u, 64u, LROW);
        }
        {
            F32_C colF;
            coopMatLoad(colF, wsc, cg * 32u + 16u, 0u, LROW);
            F32_C f = F32_C(acc1);
            for (uint c = 0u; c < f.length(); ++c)
                f[c] = f[c] * (rowF[c] * colF[c]);
            MAT_H h = MAT_H(f);
            coopMatStore(h, nr3_proj, rh * 8u * 64u + cg * 32u + 16u, 64u, LROW);
        }
    }
    barrier();

    // ---- blend: one value per token/channel, published once (canonical only) ----
    // The parent's loop, unmodified.
    for (uint i = tid; i < 2048u; i += 256u) {
        const uint t3 = i / 32u, cp3 = i % 32u, c3 = cp3 * 2u;
        const uint tg3 = t3, q3 = tg3 >> 4u, s3 = tg3 & 15u;
        const int tx3 = 2 * int(wx) + pc.p0.z + int(q3 & 1u);
        const int ty3 = 2 * int(wy) + pc.p0.w + int(q3 >> 1u);
        const bool oob3 = (tx3 < 0 || ty3 < 0 || tx3 >= int(pc.p0.x) || ty3 >= int(pc.p0.y));
        if (oob3) continue;   // canonical copy holds no out-of-bounds tiles
        const uint px3 = uint(4 * tx3 + int(s3 % 4u)), py3 = uint(4 * ty3 + int(s3 / 4u));
        const uint cx3 = px3 >> 1u, cy3 = py3 >> 1u;
        const uint ps3 = (cy3 - 4u * wy) * 4u + (cx3 - 4u * wx);
        precise f16vec2 main_scaled = f16vec2(nr3_proj[ps3 * 64u + c3], nr3_proj[ps3 * 64u + c3 + 1u]);
        if (pc.p5.w == 1u) main_scaled = main_scaled * f16vec2(pw[pc.p5.z + pc.p5.y + c3], pw[pc.p5.z + pc.p5.y + c3 + 1u]);
        const f16vec2 skip_gain = f16vec2(pw[pc.p5.z + c3], pw[pc.p5.z + c3 + 1u]);
        const uint sa3 = pc.p4.z + nr3_io_at0(px3, py3, c3, pc.p6.x, pc.p5.y);
        const f16vec2 skip_input = f16vec2(sk[sa3], sk[sa3 + 1u]);
        precise f16vec2 skip_v = skip_input * skip_gain;
        precise f16vec2 value = main_scaled + skip_v;
        // The canonical store is the parent's statement, byte for byte: the
        // contract seed reader's input is unchanged.
        const uint ba3 = nr3_io_at0(px3, py3, c3, pc.p0.x * 4u, pc.p5.y);
        blout[ba3] = value.x; blout[ba3 + 1u] = value.y;
    }
}
