#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x = 32) in;
layout(set = 0, binding = 0) buffer B { float16_t g[]; };
#define MAT_H coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>
#define LROW gl_CooperativeMatrixLayoutRowMajor
void main() {
    uint base = gl_WorkGroupID.x * 128u;
    MAT_H v = MAT_H(float16_t(0.0));
    coopMatStore(v, g, base, 16u, LROW);
    MAT_H r;
    coopMatLoad(r, g, base, 16u, LROW);
}
