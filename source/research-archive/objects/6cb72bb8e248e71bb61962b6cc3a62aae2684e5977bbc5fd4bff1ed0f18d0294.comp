// c3x_pre_c256.comp — R07 dispatch A (C256): one projection per tile-half plus
// the blend, published to global memory for the body dispatch.
//
// T3d C256 direction B (T3b's C128 result applied to this width): the
// blended activation is published ONCE, in the canonical io_at layout 0
// over the 84x48 image (binding 10, resource 148).  The tiled
// per-workgroup staging (binding 12, resource 486,
// xbase + tg3*256 + c) is no longer written: its only consumer, the
// body's expand A load, now reads this canonical copy with row stride 16
// halves.  Out-of-bounds tiles are not written here; the body skips
// those tokens with its own oob guard and the contract zeroes them.
//
// The fused kernel rebuilt the identical 8-row × 256-channel projection and the
// identical blend in all eight head groups of a half (16 z slices in total).
// Here the grid carries only the half split (z = 2), so blout has a single
// writer per address by construction.
//
// Grid 11×6×2.  Shared: gather/projection scratch 4,096 half = 8,192 B.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;
#include "nb05_swin_c256_common.glsl"

layout(set = 0, binding = 8) buffer Nr3Pack { float16_t pw[]; };
layout(set = 0, binding = 9) buffer Nr3Skip { float16_t sk[]; };
layout(set = 0, binding = 10) buffer Nr3BlendOut { float16_t blout[]; };
layout(set = 0, binding = 11) buffer Nr3ProjIn { float16_t x47[]; };
// Retained descriptor only: the plan keeps 13 bindings and resource 486
// is still allocated for this pass, but direction B leaves this tiled
// staging unwritten (and therefore unread: the body's binding-12
// reference is gone as well).
layout(set = 0, binding = 12) buffer C3X { float16_t xg[]; };

shared float16_t nr3_gbuf[4096u];

#define MAT_H coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>

// ioport_common.glsl io_at, layout 0 (spatial 4x4 tiles, 16 channels).
uint nr3_io_at0(uint px, uint py, uint c, uint W, uint C) {
    uint t = ((py / 4u) * (W / 4u) + px / 4u) * 16u + 4u * (py % 4u) + px % 4u;
    return ((t / 16u) * (C / 16u) + c / 16u) * 256u + (t % 16u) * 16u + c % 16u;
}

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint sg = tid / 32u;
    const uint wx = (pc.p1.z != 0) ? uint(pc.p2.x) : gl_WorkGroupID.x;
    const uint wy = (pc.p1.z != 0) ? uint(pc.p2.y) : gl_WorkGroupID.y;
    // z is the 32-token half only; the head index is gone because this dispatch
    // always produces all 256 projection channels.
    const uint half3 = gl_WorkGroupID.z % 2u;
    const uint t0 = half3 * 32u;

    // ---- gather 8 rows × 512 channels, then the same projection ----
    {
        for (uint e = tid; e < 4096u; e += 256u) {
            const uint s3 = e / pc.p5.x, k3 = e % pc.p5.x;
            const int px3 = 4 * int(wx) + int(s3 % 4u);
            const int py3 = 4 * int(wy) + 2 * int(half3) + int(s3 / 4u);
            // combo-v2 conflict resolution: C2 layout0-unify-l2-v4 re-anchors the
            // block47_out edge to layout0 (writer = C2 chain, reader push p2.x 1->0
            // in the 275 graph); the fused reader follows the writer.
            nr3_gbuf[e] = x47[nr3_io_at0(uint(px3), uint(py3), k3, uint(pc.p6.z), pc.p5.x)];
        }
        barrier();
        const uint n0 = sg * 32u;
        const uint wbase = pc.p4.y + (n0 / 16u) * (pc.p5.x / 16u) * 256u;
        MAT_C acc0 = MAT_C(0.0), acc1 = MAT_C(0.0);
        for (uint kc = 0u; kc < pc.p5.x; kc += 16u) {
            MAT_A a; MAT_B b0, b1;
            coopMatLoad(a, nr3_gbuf, kc, pc.p5.x, LROW);
            coopMatLoad(b0, pw, wbase + (kc / 16u) * 256u, 16u, LCOL);
            coopMatLoad(b1, pw, wbase + (pc.p5.x / 16u) * 256u + (kc / 16u) * 256u, 16u, LCOL);
            acc0 = coopMatMulAdd(a, b0, acc0);
            acc1 = coopMatMulAdd(a, b1, acc1);
        }
        barrier();
        { MAT_H h = MAT_H(acc0); coopMatStore(h, nr3_gbuf, sg * 32u, 256u, LROW); }
        { MAT_H h = MAT_H(acc1); coopMatStore(h, nr3_gbuf, sg * 32u + 16u, 256u, LROW); }
    }
    barrier();

    // One projection/channel-pair owner consumes once and emits its 2x2 pixels.
    for(uint j=tid;j<1024u;j+=256u) {
        uint pr=j/128u,c3=(j%128u)*2u;
        int px0=8*int(wx)+4*pc.p0.z+2*int(pr%4u);
        int py0=8*int(wy)+4*pc.p0.w+4*int(half3)+2*int(pr/4u);
        if(px0<0 || py0<0 || px0>=int(pc.p0.x*4u) || py0>=int(pc.p0.y*4u)) continue;
        precise f16vec2 main_scaled=f16vec2(nr3_gbuf[pr*256u+c3],nr3_gbuf[pr*256u+c3+1u]);
        if(pc.p5.w==1u) main_scaled=main_scaled*f16vec2(pw[pc.p5.z+pc.p5.y+c3],pw[pc.p5.z+pc.p5.y+c3+1u]);
        const f16vec2 skip_gain=f16vec2(pw[pc.p5.z+c3],pw[pc.p5.z+c3+1u]);
        for(uint k=0u;k<4u;++k) {
            uint px3=uint(px0)+(k&1u),py3=uint(py0)+(k>>1u);
            uint sa3=pc.p4.z+nr3_io_at0(px3,py3,c3,pc.p6.x,pc.p5.y);
            f16vec2 skip_input=f16vec2(sk[sa3],sk[sa3+1u]);
            precise f16vec2 skip_v=skip_input*skip_gain;
            precise f16vec2 value=main_scaled+skip_v;
            uint ba3=nr3_io_at0(px3,py3,c3,pc.p0.x*4u,pc.p5.y);
            blout[ba3]=value.x;blout[ba3+1u]=value.y;
        }
    }
}
