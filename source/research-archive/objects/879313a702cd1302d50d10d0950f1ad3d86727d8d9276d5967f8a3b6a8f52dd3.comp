// n23-f05-shape probe P4: the card's "or 16x32" alternative -- 16 rows x 32 columns
// FP32 accumulator (M=16 merge instead of N=32 merge), A 16x16, B 16x32.
#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require

layout(local_size_x = 32) in;
layout(set = 0, binding = 0) buffer InBuf  { float16_t inbuf[]; };
layout(set = 0, binding = 1) buffer OutBuf { float16_t outbuf[]; };

#define P_A16 coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA>
#define P_B coopmat<float16_t, gl_ScopeSubgroup, 16, 32, gl_MatrixUseB>
#define P_C coopmat<float, gl_ScopeSubgroup, 16, 32, gl_MatrixUseAccumulator>
#define P_H coopmat<float16_t, gl_ScopeSubgroup, 16, 32, gl_MatrixUseAccumulator>

void main() {
    P_A16 a; coopMatLoad(a, inbuf, 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
    P_B b; coopMatLoad(b, inbuf, 0u, 16u, gl_CooperativeMatrixLayoutColumnMajor);
    P_C c = P_C(0.0);
    c = coopMatMulAdd(a, b, c);
    P_H h = P_H(c);
    coopMatStore(h, outbuf, 0u, 32u, gl_CooperativeMatrixLayoutRowMajor);
}
