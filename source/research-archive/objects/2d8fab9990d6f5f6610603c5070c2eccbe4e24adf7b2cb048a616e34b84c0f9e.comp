// r08_d2_contract_half_residual.comp
// R08 C128 WFFN contract (body_2), INT8 MMA on an INT8 M produced by body_1,
// with the parent's HALF residual seed restored.
//
// Derived from the sealed batch implementation
//   candidates/codex-sol-int8-long-008-20261019/c128-diffusion-batch-v1/source/pilot_d2.comp
// (reproduces byte-exactly to d2-*.spv sha256 ea7d4e2be53f11d8aeef6b79db0f63d315c8cc1bdd0af259bc7dcf82d42a1188
//  with glslang-16.5.0 -V --target-env vulkan1.3 -DNATIVE=1).
//
// The ONLY arithmetic change vs that sealed kernel is the residual seed:
//   sealed : seed = dequant(qX)            = qX * sX        (int8 -> f32), residual = seed*rs
//   here   : seed = H(X) * rs              = the PARENT's own half expression
//            MAT_H load from imgin at c128_img_half_index(m,n) (stride 16, LROW)
//            * coopMatLoad(scale, pack, rs+n, 0, LROW) in half
// i.e. qX*sX is no longer substituted for H(X*rs); the half residual survives
// because the R08 producer (c128_d4_qx) keeps the original half store.
//
// Everything else is preserved from the sealed kernel:
//   * local_size 256, the wx/wy/w derivation, the 32-word push ABI
//   * the int8 weight pack layout of c128-diffusion-batch-v1/tools/build_batch.py
//     (we 0..65535, wm 65536..81919, wc 81920..98303; [n][k] row-major, stride 128)
//   * the INT8 A load from the int8 M buffer at (w*64+m)*128+k, stride 128, ROW
//     (written by the sealed pilot_d1 expansion kernel, now fed by qX)
//   * the f32 dequant multiplier sc[656+n] (sM*sWc) and the gY store address
//     ((w*64+m)*128+n, stride 128) plus the p7.x-gated integer diagnostic
// Binding adaptation (documented in evidence/PLAN-DELTA.json):
//   b0 = the FP16 weight pack (parent's, only for the residual scale vector pack[rs+n])
//   b1 = the C128 int8 scale table (3648 B, layout of the sealed builder)
//   b8 = the int8 weight pack      (new binding; the sealed kernel used b0 for it)
//   b2 = the half input buffer     (new type: the sealed kernel read int8 qX here)
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_8bit_storage : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer PackBuf { float16_t pack[]; };
layout(set = 0, binding = 1) readonly buffer ScTab { float sc[]; };
layout(set = 0, binding = 2) readonly buffer ImageIn { float16_t imgin[]; };
layout(set = 0, binding = 3) buffer ImageOut { float16_t imgout[]; };   // unused (kept bound)
layout(set = 0, binding = 4) buffer DotDump { float dd[]; };             // sealed kernel's b4
layout(set = 0, binding = 5) buffer MidBuf { int8_t gm[]; };
layout(set = 0, binding = 6) buffer OutBuf { float16_t gy[]; };
layout(set = 0, binding = 7) buffer TBuf { float16_t gT[]; };           // unused (kept bound)
layout(set = 0, binding = 8) readonly buffer Weights8 { int8_t qw[]; };

layout(push_constant) uniform PC { ivec4 p0; ivec4 p1; ivec4 p2; ivec4 p3;
    ivec4 p4; ivec4 p5; ivec4 p6; ivec4 p7; } pc;

#define KS 32u
#define MA coopmat<int8_t, gl_ScopeSubgroup, 8, 32, gl_MatrixUseA>
#define MB coopmat<int8_t, gl_ScopeSubgroup, 32, 16, gl_MatrixUseB>
#define ACC coopmat<int, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>
#define MF coopmat<float, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>
#define MH coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>
#define LROW gl_CooperativeMatrixLayoutRowMajor
#define LCOL gl_CooperativeMatrixLayoutColumnMajor

// parent geometry, copied verbatim from
// candidates/.../c128-diffusion-batch-v1/source/c64_c128_common.glsl (shared with
// expand-c128-mid-direct / contract-c128-full / output-c128-full)
uint c128_img_half_index(uint t, uint c, uint wx, uint wy, out bool oob) {
    uint q = t >> 4u, s = t & 15u;
    int tx = 2 * int(wx) + pc.p0.z + int(q & 1u);
    int ty = 2 * int(wy) + pc.p0.w + int(q >> 1u);
    oob = (tx < 0 || ty < 0 || tx >= pc.p0.x || ty >= pc.p0.y);
    uint stx = uint(clamp(tx, 0, pc.p0.x - 1));
    uint sty = uint(clamp(ty, 0, pc.p0.y - 1));
    return (((sty * uint(pc.p0.x) + stx) * 8u + c / 16u) * 256u
            + s * 16u + c % 16u);
}

void dumpdot(ACC a, uint off, uint row, uint col, uint stride) {
    // sealed kernel's gated integer diagnostic; production p7.x = 0
    if (pc.p7.x != 0 && gl_WorkGroupID.x == 1u && gl_WorkGroupID.y == 1u) {
        MF f = MF(a);
        coopMatStore(f, dd, off + row * stride + col, stride, LROW);
    }
}

// residual seed = the PARENT contract's half expression (c128_contract_full.comp:38-46)
MH parent_seed(uint trow, uint ncol, uint wx, uint wy, uint rs) {
    bool oob;
    uint addr = c128_img_half_index(trow, ncol, wx, wy, oob);
    MH seed;
    if (oob) seed = MH(float16_t(0.0));
    else coopMatLoad(seed, imgin, addr, 16u, LROW);
    MH scale;
    coopMatLoad(scale, pack, rs + ncol, 0u, LROW);
    seed = seed * scale;
    return seed;
}

void finish(ACC a, uint m, uint n, uint wx, uint wy, uint w, MF s, uint rs) {
    dumpdot(a, 40960u, m, n, 128u);
    MF f = MF(a);
    MH seed = parent_seed(m, n, wx, wy, rs);
    for (int i = 0; i < f.length(); ++i) {
        precise float realv = f[i] * s[i];
        precise float residual = float(seed[i]);
        precise float result = realv + residual;
        f[i] = result;
    }
    // Existing D3 attention consumes this same FP16 ABI.
    MH h = MH(f);
    coopMatStore(h, gy, (w * 64u + m) * 128u + n, 128u, LROW);
}

void main() {
    uint sg = gl_LocalInvocationID.x / 32u, wx = gl_WorkGroupID.x, wy = gl_WorkGroupID.y;
    uint w = wy * uint(pc.p1.x) + wx;
    const uint n0 = (sg % 4u) * 32u;
    const uint rs = uint(pc.p4.y);
    MF cScale0, cScale1;
    coopMatLoad(cScale0, sc, 656u + n0, 0u, LROW);
    coopMatLoad(cScale1, sc, 656u + n0 + 16u, 0u, LROW);
    for (uint r = 0u; r < 2u; ++r) {
        uint m0 = (sg / 4u + 4u * r) * 8u, m1 = m0 + 16u, n = (sg % 4u) * 32u;
        ACC a0 = ACC(0), a1 = ACC(0), b0 = ACC(0), b1 = ACC(0);
        for (uint k = 0u; k < 128u; k += KS) {
            MA x; MB v0, v1;
            coopMatLoad(v0, qw, 81920u + n * 128u + k, 128u, LCOL);
            coopMatLoad(v1, qw, 81920u + (n + 16u) * 128u + k, 128u, LCOL);
            coopMatLoad(x, gm, (w * 64u + m0) * 128u + k, 128u, LROW);
            a0 = coopMatMulAdd(x, v0, a0); a1 = coopMatMulAdd(x, v1, a1);
            coopMatLoad(x, gm, (w * 64u + m1) * 128u + k, 128u, LROW);
            b0 = coopMatMulAdd(x, v0, b0); b1 = coopMatMulAdd(x, v1, b1);
        }
        finish(a0, m0, n, wx, wy, w, cScale0, rs); finish(a1, m0, n + 16u, wx, wy, w, cScale1, rs);
        finish(b0, m1, n, wx, wy, w, cScale0, rs); finish(b1, m1, n + 16u, wx, wy, w, cScale1, rs);
    }
}
