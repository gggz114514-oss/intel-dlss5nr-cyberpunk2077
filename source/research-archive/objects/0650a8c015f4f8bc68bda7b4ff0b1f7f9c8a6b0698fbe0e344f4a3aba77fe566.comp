#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x=32) in;
layout(set=0,binding=0,std430) readonly buffer AB {float16_t av[];};
layout(set=0,binding=1,std430) readonly buffer BB {float16_t bv[];};
layout(set=0,binding=2,std430) buffer OB {float result[];};
#define MA coopmat<float16_t,gl_ScopeSubgroup,8,16,gl_MatrixUseA>
#define MB coopmat<float16_t,gl_ScopeSubgroup,16,16,gl_MatrixUseB>
#define MC coopmat<float,gl_ScopeSubgroup,8,16,gl_MatrixUseAccumulator>
void main(){
 uint test=gl_WorkGroupID.x,ab=test*256u,bb=test*512u,ob=test*256u;
 MC acc=MC(0.0);
 for(uint k=0;k<32u;k+=16u){
  MA a;MB b;
  coopMatLoad(a,av,ab+k,32u,gl_CooperativeMatrixLayoutRowMajor);
  coopMatLoad(b,bv,bb+k*16u,16u,gl_CooperativeMatrixLayoutRowMajor);
  acc=coopMatMulAdd(a,b,acc);
 }
 coopMatStore(acc,result,ob,16u,gl_CooperativeMatrixLayoutRowMajor);
 for(uint e=gl_LocalInvocationID.x;e<128u;e+=32u){
  uint row=e/16u,col=e%16u;
  precise float sum=0.0;
  for(uint k=0;k<32u;++k){
   precise float product=float(av[ab+row*32u+k])*float(bv[bb+k*16u+col]);
   sum=sum+product;
  }
  result[ob+128u+e]=sum;
 }
}
