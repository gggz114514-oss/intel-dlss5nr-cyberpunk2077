// Block30 l4 INT8 (B line).  Independent contract: B30-L4-CONTRACT.json.
// A = qPool (pool quantised once in the l3 pool producer), B = W8 finalhead
// weights, INT8xINT8 -> INT32, dequant f32*(sPool*sW4[n]), one half narrowing,
// then the parent's canonical-raster gh_store (24-wide, 1024 channels).
// The parent KIND3 has no seed; none is added.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_8bit_storage : require
layout(local_size_x=256) in;
#include "b30_l34_common.glsl"
shared int8_t sx8[8192];
uint token_at(uint s) { return gl_WorkGroupID.x*16u+s; }
void gh_store(uint t,uint c,float16_t v) {
    uint tile=t/16u,slot=t%16u;
    uint Px=(tile%uint(pc.p7.x/4u))*4u+slot%4u;
    uint Py=(tile/uint(pc.p7.x/4u))*4u+slot/4u;
    gh[(Py*pc.p7.x+Px)*1024u+c]=v;
}
void main() {
    uint lid=gl_LocalInvocationID.x,sg=lid/32u,lane=lid%32u,ng=gl_WorkGroupID.y;
    for(uint e=lid;e<8192u;e+=256u) {
        uint t=token_at(e/512u),c=e%512u;
        sx8[e]=qp[tiled(t,c,512u)];
    }
    barrier();
    uint m0=sg/4u*8u,n0=(sg%4u)*32u,base=ng*128u+n0;
    CA acc0=CA(0),acc1=CA(0);
    for(uint k=0u;k<512u;k+=32u) {
        CIA a;CIB b0,b1;
        coopMatLoad(a,sx8,m0*512u+k,512u,ROW);
        coopMatLoad(b0,w4,w8_tile(base,k),32u,COL);
        coopMatLoad(b1,w4,w8_tile(base+16u,k),32u,COL);
        acc0=coopMatMulAdd(a,b0,acc0);acc1=coopMatMulAdd(a,b1,acc1);
    }
    for(uint side=0u;side<2u;side++) {
        CF f; if(side==0u) f=CF(acc0); else f=CF(acc1);
        precise CF s; coopMatLoad(s,wsc4,base+16u*side,0u,ROW);
        f=f*s;
        MH h=MH(f);
        uint lv=gl_SubgroupInvocationID;
        uint rp=lv>>4u;
        uint c=base+16u*side+(lv&15u);
        gh_store(token_at(m0+0u+rp),c,h[0]);
        gh_store(token_at(m0+2u+rp),c,h[1]);
        gh_store(token_at(m0+4u+rp),c,h[2]);
        gh_store(token_at(m0+6u+rp),c,h[3]);
    }
}
