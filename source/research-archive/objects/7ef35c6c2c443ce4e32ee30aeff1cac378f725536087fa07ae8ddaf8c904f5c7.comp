// F1 image-pre fusion candidate (f1-c32-image-pre-fused-v3, 2026-10-16).
// Base: the bound pass-2 body c32_register.comp (sha256 7c78f4f3d443675a) byte-identical except the
// four replaced lift loads; the bound pass-0 features, pass-1 lift weight
// contract and pass-3 pool statement order are inlined as nrf_* helpers.
// Complete transpose/register C32 handoff, CPU-generated literal fragments.
// AMD purpose: fswin_t.comp167-205: feature rows are the next contraction K.
// Intel coordinates come ONLY from the independently sealed measured helper.
// K/V cross-SG shared is required and explicitly retained; all other intermediates stay registers.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_8bit_storage : require
#include "register_handoff.glsl"
layout(local_size_x=128, local_size_y=1, local_size_z=1) in;
layout(set=0,binding=0) buffer HalfBuf { float16_t wb[]; };
layout(set=0,binding=1) buffer FloatBuf { float fb[]; };
// The block-0 image fixture (RGBA float32 raster + controls/history/motion/depth
// regions + the cold noise field) - the same buffer the bound features pass
// reads as `Floats`.
layout(set=0,binding=2) buffer ImageFloats { float f[]; };
layout(set=0,binding=3) buffer ImageOut { float16_t imgout[]; };
layout(set=0,binding=4) buffer DebugBuf { float16_t dbg[]; };
// block0_out, the 2x2 mean: half-element pairs, exactly the parent pool's own
// `OutputPairs { f16vec2 o2[]; }` view of the same allocation.
layout(set=0,binding=5) buffer PoolOut { f16vec2 pooled[]; };
layout(push_constant) uniform PC {
    ivec4 p0; ivec4 p1; ivec4 p2; ivec4 p3;
    // F1 fields.  p4  = IW, IH, image float base, cold noise float base;
    // p5 = source_W, source_H, seed, flags (the feedback words 22/23);
    // p6 = controls, history, motion, depth float bases; p7 = lift half offset.
    uvec4 p4; uvec4 p5; uvec4 p6; uvec4 p7;
} pc;

// ---- C32-I8 v1 declarations (generated) ----------------------------------
layout(set=0,binding=8) readonly buffer C32I8Weights { int8_t w8[]; };
layout(set=0,binding=9) readonly buffer C32I8Scales { float fsc[]; };
// c32-f1-f2: body-stage INT8 weight tiles and per-output-channel static scales.
// The module's real declared occupancy is {0,1,2,3,4,5,8,9}; 6 and 7 are bound in
// the plan to 4-byte placeholders, so the new slots are 10 and 11 (nbind 10 -> 12)
// and every existing BIND line stays untouched.
layout(set=0,binding=10) readonly buffer C32I8BodyWeights { int8_t wb8[]; };
layout(set=0,binding=11) readonly buffer C32I8BodyScales { float fsc2[]; };
shared int8_t sX8[2048];
shared int8_t sE8[8192];
#include "c32_i8_common.glsl"
// --------------------------------------------------------------------------
// int8 published K/V tiles replace the FP16 ones (same single reader each).
shared int8_t shK8[2048];
shared int8_t shV8[2048];
shared float shKV[8];

// ---- c32-f1-f2 diagnostics (this variant only) ----------------------------
layout(set=0,binding=12) buffer C32I8Diag { uint dg[]; };
// Nothing is written unless the pass runs with p0.z != 0 AND this is workgroup
// (0,0), so exactly one workgroup owns the payload and the identity words below
// say which one it was.
#define NR_DIAG (pc.p0.z != 0 && gl_WorkGroupID.x == 0u && gl_WorkGroupID.y == 0u)
#define NR_DG_X65 64u
#define NR_DG_Y   8256u
#define NR_DG_Q   10304u
#define NR_DG_K   12352u
#define NR_DG_V   14400u
#define NR_DG_P   16448u
#define NR_DG_CTX 20544u
#define NR_DG_SC  22592u
#define NR_DG_ACCQ 22624u
#define NR_DG_ACCS 28768u
#define NR_DG_ACCPV 32864u
#define NR_DG_ACCO 34912u
#define NR_DG_END 36960u
void nr_dg_header(uint wx,uint wy) {
    if (!NR_DIAG) return;
    if (gl_LocalInvocationID.x == 0u) {
        dg[0] = 0x43314632u;                    // 'C1F2'
        dg[1] = gl_WorkGroupID.x;
        dg[2] = gl_WorkGroupID.y;
        dg[3] = uint(gl_NumWorkGroups.x);
        dg[4] = uint(gl_NumWorkGroups.y);
        dg[5] = wx;
        dg[6] = wy;
        dg[7] = uint(pc.p0.z) | (uint(pc.p3.y) << 8u);
        dg[8] = 57440u;                            // payload words
        dg[9] = 1u;                              // layout revision
        dg[10] = 0u; dg[11] = 0u;
    }
}
void nr_dg_codes(uint base,uint o,uint n) {
    for (uint e = o + (gl_LocalInvocationID.x & 31u); e < n; e += 32u)
        dg[base + e] = uint(int(sE8[e]));
}
void nr_dg_scale(uint slot,float s) {
    if ((gl_LocalInvocationID.x & 31u) == 0u) dg[NR_DG_SC + slot] = floatBitsToUint(s);
}
void nr_dg_acc(I8C a,uint base,uint idx) {
    for (int i = 0; i < 4; ++i) {
        uvec2 rc = nrh_coord_C(uint(i));
        dg[base + idx * 128u + rc.y * 8u + rc.x] = uint(a[i]);
    }
}
// --------------------------------------------------------------------------

// ---- C32-I8 body helpers (c32-f1-f2) --------------------------------------
// Weight tile bases inside C32I8BodyWeights (bytes).  An 8x32 I8A tile occupies
// 1024 bytes of address space with 256 live codes (stride 32, LCOL), exactly the
// convention the deployed FFN pack already uses.
#define C32I8B_WQ 32768u
#define C32I8B_WK 36864u
#define C32I8B_WV 40960u
#define C32I8B_WO 45056u
#define C32I8B_WP 49152u
// Static per-output-channel weight scales inside C32I8BodyScales.
#define C32I8B_SQ 0u
#define C32I8B_SK 32u
#define C32I8B_SV 64u
#define C32I8B_SO 96u
#define C32I8B_SP 128u
// Shared int8 staging carved out of sE8, which is dead once the contract has
// consumed E: Q8[sg] is [tok][dim] stride 32 (512 B), P8[sg] is two [tok][key]
// tiles of 512 B.  Total 2048 + 4096 = 6144 of sE8's 8192 bytes.
#define C32I8B_Q8 0u
#define C32I8B_P8 2048u

// Largest |component| a lane holds in one 8x16 half fragment.
float nr_i8_amax(NRH_CH a) {
    float m = 0.0;
    for (int i = 0; i < 4; ++i) m = max(m, abs(float(a[i])));
    return m;
}
// Subgroup max by shuffle-xor (the module only enables the shuffle extension,
// so subgroupMax/subgroupAdd are deliberately not used).
float nr_i8_sgmax(float v) {
    for (uint m = 16u; m > 0u; m >>= 1u) v = max(v, subgroupShuffleXor(v, uint(m)));
    return v;
}
// sX8 staging with a caller-supplied inverse scale: element (row, col) of the
// fragment lands at base + col*32 + rowoff + row, i.e. the [token][channel]
// stride-32 I8B tile that coopMatLoad(...,32,LCOL) reads.
void nr_i8_put_ys(NRH_CH a, uint rowoff, uint base, float inv) {
    for (int i = 0; i < 4; ++i) {
        uvec2 rc = nrh_coord_CH(uint(i));
        sX8[base + rc.y * 32u + rowoff + rc.x] = int8_t(nr_i8_code(a[i], inv));
    }
}
// sE8 Q8 tile: [sg][token][dim] stride 32.
void nr_i8_put_q(NRH_CH a, uint rowoff, uint base, float inv) {
    for (int i = 0; i < 4; ++i) {
        uvec2 rc = nrh_coord_CH(uint(i));
        sE8[C32I8B_Q8 + base + rc.y * 32u + rowoff + rc.x] = int8_t(nr_i8_code(a[i], inv));
    }
}
// Published K/V tiles: [key 0..63][lane 0..31] stride 32, key = keybase + token.
void nr_i8_put_k(NRH_CH a, uint rowoff, uint keybase, float inv) {
    for (int i = 0; i < 4; ++i) {
        uvec2 rc = nrh_coord_CH(uint(i));
        shK8[(keybase + rc.y) * 32u + rowoff + rc.x] = int8_t(nr_i8_code(a[i], inv));
    }
}
void nr_i8_put_v(NRH_CH a, uint rowoff, uint keybase, float inv) {
    for (int i = 0; i < 4; ++i) {
        uvec2 rc = nrh_coord_CH(uint(i));
        shV8[(keybase + rc.y) * 32u + rowoff + rc.x] = int8_t(nr_i8_code(a[i], inv));
    }
}
// sE8 P tile: [sg][key tile 32][token][key%32] stride 32.
void nr_i8_put_p(NRH_CH a, uint keyrow, uint tileoff, uint base, float inv) {
    for (int i = 0; i < 4; ++i) {
        uvec2 rc = nrh_coord_CH(uint(i));
        sE8[C32I8B_P8 + base + tileoff + rc.y * 32u + keyrow + rc.x] =
            int8_t(nr_i8_code(a[i], inv));
    }
}
// Dequantisation, folded exactly once: static per-output-channel weight scale
// times the activation scale that was used to build the int8 operand.
NRH_C nr_i8_deq2(I8C a, uint sbase, float sAct) {
    I8F f = I8F(a);
    NRH_C o = NRH_C(0.0);
    for (int i = 0; i < 4; ++i) {
        uvec2 rc = nrh_coord_C(uint(i));
        o[i] = f[i] * (fsc2[sbase + rc.x] * sAct);
    }
    return o;
}
NRH_C nr_i8_deq2_add(I8C a, uint sbase, float sAct, NRH_C seed) {
    I8F f = I8F(a);
    NRH_C o = NRH_C(0.0);
    for (int i = 0; i < 4; ++i) {
        uvec2 rc = nrh_coord_C(uint(i));
        o[i] = f[i] * (fsc2[sbase + rc.x] * sAct) + seed[i];
    }
    return o;
}
// Pure dynamic-operand dequantisation (no static weight column): score and PV
// both sit between two self-calibrated activations.
NRH_C nr_i8_deq_s(I8C a, float s) {
    I8F f = I8F(a);
    NRH_C o = NRH_C(0.0);
    for (int i = 0; i < 4; ++i) o[i] = f[i] * s;
    return o;
}
// --------------------------------------------------------------------------

#define C32I8B_WLIFT 49152u
#define C32I8B_SL 128u
// F1 fusion scratch.  nrf_feat is [token][feature] (the AMD input_features
// array), nrf_stage keeps one 8x16 fragment per (subgroup, channel group) for
// the in-kernel 2x2 mean.
shared float16_t nrf_feat[1024];
// defined with the fusion helpers at the end of this file; the body stage calls
// it in place of the four materialised-lift loads.
NRH_CH nrf_lift(uint base,uint g,float invF,float sF);
void nrf_lift_stage(uint q,out float sF,out float invF);
#define LROW gl_CooperativeMatrixLayoutRowMajor
#define LCOL gl_CooperativeMatrixLayoutColumnMajor
// half MpCubicSilu (guide §2.1): one rounding per half op
float16_t nr_act_h(float16_t x) {
    float16_t t = clamp(x, float16_t(-4.0), float16_t(4.0));
    float16_t u = fma(float16_t(-0.055908203125), abs(t), float16_t(0.447265625));
    return x * fma(t, u, float16_t(0.89453125));
}

// half swin exp (guide §2.3). M05 paired form, adopted from C5
// (c32_register.comp): the former scalar packHalf2x16/unpackHalf2x16 transform
// runs on two packed halves at once.  Bit-identical per channel: the mantissa
// is bits 0..9, so (h & 0x03ff03ff) << 5 keeps each lane's shift inside bits
// 5..14 of that lane for any input; the clamp keeps exactly the scalar value
// domain, so fma/clamp/exception behaviour is unchanged.
f16vec2 nr_exp_h2(f16vec2 xy) {
    f16vec2 y = clamp(fma(xy, f16vec2(float16_t(0.044921875)), f16vec2(float16_t(1.30078125))),
                      f16vec2(float16_t(1.03125)), f16vec2(float16_t(1.5693359375)));
    uint h = packFloat2x16(y);
    return unpackFloat2x16((h & 0x03ff03ffu) << 5u);
}

// token coordinates recomputed per element (B0 v3 base, no private tables)
uint nr_tok_addr(uint t, uint c, uint wx, uint wy, int shift, uint tiles_x, out bool oob) {
    uint q = t >> 4u, s = t & 15u;
    int tx = 2 * int(wx) + shift + int(q & 1u);
    int ty = 2 * int(wy) + pc.p3.w + int(q >> 1u);
    oob = (tx < 0 || ty < 0 || tx >= int(tiles_x) || ty >= pc.p3.z);
    uint safe_tx = uint(clamp(tx, 0, int(tiles_x) - 1));
    uint safe_ty = uint(clamp(ty, 0, pc.p3.z-1));
    return (((safe_ty * tiles_x + safe_tx) * 2u + c / 16u) * 256u
            + s * 16u + c % 16u);   // slot = s (4*(y%4)+(x%4), y-major)
}

// Measured CH ownership proved in CPU-local-reduction-proof.json.
// Each lane owns one parity of16 features for its query column.
f16vec2 nr_norm32_pair(NRH_CH q0,NRH_CH q1,NRH_CH q2,NRH_CH q3,
                       NRH_CH k0,NRH_CH k1,NRH_CH k2,NRH_CH k3) {
    float16_t qsq0_0=q0[0]*q0[0];
    float16_t qsq0_1=q0[1]*q0[1];
    float16_t qsq0_2=q0[2]*q0[2];
    float16_t qsq0_3=q0[3]*q0[3];
    float16_t qsq1_0=q1[0]*q1[0];
    float16_t qsq1_1=q1[1]*q1[1];
    float16_t qsq1_2=q1[2]*q1[2];
    float16_t qsq1_3=q1[3]*q1[3];
    float16_t qsq2_0=q2[0]*q2[0];
    float16_t qsq2_1=q2[1]*q2[1];
    float16_t qsq2_2=q2[2]*q2[2];
    float16_t qsq2_3=q2[3]*q2[3];
    float16_t qsq3_0=q3[0]*q3[0];
    float16_t qsq3_1=q3[1]*q3[1];
    float16_t qsq3_2=q3[2]*q3[2];
    float16_t qa0=qsq0_0+qsq2_0;
    float16_t qb0=qsq1_0+qsq3_0;
    float16_t qs0=qa0+qb0;
    float16_t qa1=qsq0_1+qsq2_1;
    float16_t qb1=qsq1_1+qsq3_1;
    float16_t qs1=qa1+qb1;
    float16_t qa2=qsq0_2+qsq2_2;
    float16_t qb2=qsq1_2+qsq3_2;
    float16_t qs2=qa2+qb2;
    float16_t qa3=qsq0_3+qsq2_3;
    float16_t qb3;
    // Measured map: lastcomponent is feature30 on evenparity and31 on oddparity.
    // No subgroup helper appears inside this scalar parity branch.
    if ((gl_SubgroupInvocationID&16u)==0u) {
        float16_t qsq30_material=q3[3]*q3[3];
        qb3=qsq1_3+qsq30_material;
    } else {
        qb3=fma(q3[3],q3[3],qsq1_3);
    }
    float16_t qs3=qa3+qb3;
    float16_t qt4lo=qs0+qs2;
    float16_t qt4hi=qs1+qs3;
    float16_t qpartial=qt4lo+qt4hi;
    float16_t ksq0_0=k0[0]*k0[0];
    float16_t ksq0_1=k0[1]*k0[1];
    float16_t ksq0_2=k0[2]*k0[2];
    float16_t ksq0_3=k0[3]*k0[3];
    float16_t ksq1_0=k1[0]*k1[0];
    float16_t ksq1_1=k1[1]*k1[1];
    float16_t ksq1_2=k1[2]*k1[2];
    float16_t ksq1_3=k1[3]*k1[3];
    float16_t ksq2_0=k2[0]*k2[0];
    float16_t ksq2_1=k2[1]*k2[1];
    float16_t ksq2_2=k2[2]*k2[2];
    float16_t ksq2_3=k2[3]*k2[3];
    float16_t ksq3_0=k3[0]*k3[0];
    float16_t ksq3_1=k3[1]*k3[1];
    float16_t ksq3_2=k3[2]*k3[2];
    float16_t ka0=ksq0_0+ksq2_0;
    float16_t kb0=ksq1_0+ksq3_0;
    float16_t ks0=ka0+kb0;
    float16_t ka1=ksq0_1+ksq2_1;
    float16_t kb1=ksq1_1+ksq3_1;
    float16_t ks1=ka1+kb1;
    float16_t ka2=ksq0_2+ksq2_2;
    float16_t kb2=ksq1_2+ksq3_2;
    float16_t ks2=ka2+kb2;
    float16_t ka3=ksq0_3+ksq2_3;
    float16_t kb3;
    // Measured map: lastcomponent is feature30 on evenparity and31 on oddparity.
    // No subgroup helper appears inside this scalar parity branch.
    if ((gl_SubgroupInvocationID&16u)==0u) {
        float16_t ksq30_material=k3[3]*k3[3];
        kb3=ksq1_3+ksq30_material;
    } else {
        kb3=fma(k3[3],k3[3],ksq1_3);
    }
    float16_t ks3=ka3+kb3;
    float16_t kt4lo=ks0+ks2;
    float16_t kt4hi=ks1+ks3;
    float16_t kpartial=kt4lo+kt4hi;
    uint partial_bits=nrh_pack2(qpartial,kpartial);
    f16vec2 peer=nrh_unpack2(subgroupShuffleXor(partial_bits,16u));
    bool even=(gl_SubgroupInvocationID&16u)==0u;
    float16_t qeven=even?qpartial:peer.x, qodd=even?peer.x:qpartial;
    float16_t keven=even?kpartial:peer.y, kodd=even?peer.y:kpartial;
    float16_t qsum=qeven+qodd, ksum=keven+kodd;
    float qmx=max(float(qsum),float(float16_t(0.000062)));
    float kmx=max(float(ksum),float(float16_t(0.000062)));
    float16_t nq=float16_t(inversesqrt(qmx)), nk=float16_t(inversesqrt(kmx));
return f16vec2(nq,nk);
}

void nr_body_stage() {
    const uint tid = gl_LocalInvocationID.x;
    const uint sg = tid / 32u;
    const uint lane = tid % 32u;
    const uint t0 = sg * 16u;
    const uint wx = (pc.p3.y != 0) ? uint(pc.p0.w) : gl_WorkGroupID.x;
    const uint wy = (pc.p3.y != 0) ? uint(pc.p3.x) : gl_WorkGroupID.y;
    const int shift = pc.p0.y;
    const uint tiles_x = uint(pc.p0.x);
    const bool debug = pc.p0.z != 0;
    nr_dg_header(wx, wy);
    NRH_CH y0 = NRH_CH(float16_t(0.0));
    NRH_CH y1 = NRH_CH(float16_t(0.0));
    NRH_CH y2 = NRH_CH(float16_t(0.0));
    NRH_CH y3 = NRH_CH(float16_t(0.0));
    NRH_CH q0 = NRH_CH(float16_t(0.0));
    NRH_CH q1 = NRH_CH(float16_t(0.0));
    NRH_CH q2 = NRH_CH(float16_t(0.0));
    NRH_CH q3 = NRH_CH(float16_t(0.0));
    if (sg < 4u) {
        // Each active subgroup owns16 tokens and all32 channels.
        // X^T is loaded directly from the original tiled input as COL16.
        float sFeat, invFeat;
        nrf_lift_stage(sg, sFeat, invFeat);
        NRH_CH x0 = nrf_lift(sg * 512u, 0u, invFeat, sFeat);
        if (debug) coopMatStore(x0, dbg, 22528u+t0*32u+0u, 32u, LCOL);
        NRH_CH x1 = nrf_lift(sg * 512u, 1u, invFeat, sFeat);
        if (debug) coopMatStore(x1, dbg, 22528u+t0*32u+8u, 32u, LCOL);
        NRH_CH x2 = nrf_lift(sg * 512u, 2u, invFeat, sFeat);
        if (debug) coopMatStore(x2, dbg, 22528u+t0*32u+16u, 32u, LCOL);
        NRH_CH x3 = nrf_lift(sg * 512u, 3u, invFeat, sFeat);
        if (debug) coopMatStore(x3, dbg, 22528u+t0*32u+24u, 32u, LCOL);
        if (debug && tid == 0u) {
            dbg[24576u]=float16_t(float(wx)); dbg[24577u]=float16_t(float(wy));
            dbg[24578u]=float16_t(float(pc.p3.y)); dbg[24579u]=float16_t(float(pc.p0.w));
            dbg[24580u]=float16_t(float(pc.p3.x));
        }
        // ---- C32-I8: one int8 copy of the body input per subgroup.
        // The seed blocks below still consume the original FP16 x0..x3.
        nr_i8_put_x(x0, 0u, sg * 512u);
        nr_i8_put_x(x1, 8u, sg * 512u);
        nr_i8_put_x(x2, 16u, sg * 512u);
        nr_i8_put_x(x3, 24u, sg * 512u);
        // workgroup scope: retires the staged lift tile in sE8[0..2048) as well
        memoryBarrierShared();
        barrier();
        if (NR_DIAG) for(uint e=lane;e<512u;e+=32u) dg[36960u+sg*512u+e]=uint(int(sX8[sg*512u+e]));
        // Contract seed H(X*rs[8+feature]) is widened BEFORE K0.
        NRH_C yc0;
        {
            NRH_CH scale;
            coopMatLoad(scale, wb, uint(pc.p2.x)+8u, 0u, LCOL);
            NRH_CH seed = x0 * scale;
            yc0 = nrh_widen_exact(seed);
        }
        NRH_C yc1;
        {
            NRH_CH scale;
            coopMatLoad(scale, wb, uint(pc.p2.x)+16u, 0u, LCOL);
            NRH_CH seed = x1 * scale;
            yc1 = nrh_widen_exact(seed);
        }
        NRH_C yc2;
        {
            NRH_CH scale;
            coopMatLoad(scale, wb, uint(pc.p2.x)+24u, 0u, LCOL);
            NRH_CH seed = x2 * scale;
            yc2 = nrh_widen_exact(seed);
        }
        NRH_C yc3;
        {
            NRH_CH scale;
            coopMatLoad(scale, wb, uint(pc.p2.x)+32u, 0u, LCOL);
            NRH_CH seed = x3 * scale;
            yc3 = nrh_widen_exact(seed);
        }
        // ---- C32-I8 expand: 8 feature groups x 16 features, K=32 single step.
        NRH_C seed0 = yc0;
        NRH_C seed1 = yc1;
        NRH_C seed2 = yc2;
        NRH_C seed3 = yc3;
        {
            I8B xb8;
            coopMatLoad(xb8, sX8, sg * 512u, 32u, LCOL);
            I8A wa;
            I8C a0;
            I8C a1;
            // feature group 0: features 0..15
            a0 = I8C(0);
            a1 = I8C(0);
            coopMatLoad(wa, w8, 0u, 32u, LCOL);
