        if (!o_oob3) coopMatStore(o3,imgout,o_base3,16u,LCOL);
    }
}

// ---------------------------------------------------------------------------
// F1 image-pre fusion (AMD nr_graph.cpp:2539-2591, fswinimagepreds32).
//
//  * nrf_prepare_features : the bound io-f26-features statements, per pixel of
//    this workgroup's 8x8 patch, into workgroup memory in the AMD
//    `input_features[token][feature]` order.
//  * nrf_lift             : the bound project-k16 product (K = 16, fp32
//    accumulate, one fp16 rounding) with the operand roles exchanged, so the
//    fragment is already the block B operand - the AMD first-MMA fold.
//  * nrf_pool             : the bound io-f30-pool statement order over the
//    staged fragments, writing the identical block0_out addresses.
// ---------------------------------------------------------------------------

uint nrf_pcg(uint v) { v=(v>>((v>>28u)+4u))^v; return v*0x108EF2D9u; }
float nrf_uniform01(uint stream) {
    uint v=nrf_pcg(stream);
    return float(((v>>30u)^(v>>8u))+1u)*5.9604644775390625e-08;
}
float nrf_ctl(uint i) { return f[pc.p6.x+i]; }
int nrf_mirror(int i,int size) {
    int period=2*size;
    int j=i%period;
    if(j<0)j+=period;
    return j<size?j:period-1-j;
}
vec4 nrf_rgba(uint base,uint W,uint H,ivec2 xy) {
    uint a=base+uint(nrf_mirror(xy.y,int(H)))*W*4u+uint(nrf_mirror(xy.x,int(W)))*4u;
    return vec4(f[a],f[a+1u],f[a+2u],f[a+3u]);
}
vec3 nrf_hist_linear(vec2 pos) {
    uint W=uint(nrf_ctl(9)),H=uint(nrf_ctl(10));
    vec2 q=pos-0.5,fr=fract(q);
    ivec2 ij=ivec2(floor(q));
    ivec2 hi=ivec2(int(W)-1,int(H)-1);
    vec3 a=nrf_rgba(pc.p6.y,W,H,clamp(ij,ivec2(0),hi)).rgb;
    vec3 b=nrf_rgba(pc.p6.y,W,H,clamp(ij+ivec2(1,0),ivec2(0),hi)).rgb;
    vec3 c=nrf_rgba(pc.p6.y,W,H,clamp(ij+ivec2(0,1),ivec2(0),hi)).rgb;
    vec3 e=nrf_rgba(pc.p6.y,W,H,clamp(ij+ivec2(1),ivec2(0),hi)).rgb;
    return mix(mix(a,b,fr.x),mix(c,e,fr.x),fr.y);
}
vec3 nrf_history5(vec2 pos) {
    vec2 lo=vec2(0.5),hi=vec2(nrf_ctl(9),nrf_ctl(10))-0.5;
    vec2 c=floor(pos-0.5)+0.5,t=clamp(pos-c,vec2(0),vec2(1));
    vec2 t2=t*t,t3=t2*t;
    vec2 w0=(t+t3)*(-0.5)+t2;
    vec2 w1=1.5*t3-2.5*t2+1.0,w3=0.5*(t3-t2),w2=1.0-w0-w1-w3,wc=w1+w2;
    vec2 p0=clamp(c-1.0,lo,hi),pm=clamp(c+w2/wc,lo,hi),p2=clamp(c+2.0,lo,hi);
    float kl=w0.x*wc.y,ku=w0.y*wc.x,kc=wc.x*wc.y,kd=w3.y*wc.x,kr=w3.x*wc.y;
    return (kl*nrf_hist_linear(vec2(p0.x,pm.y))+ku*nrf_hist_linear(vec2(pm.x,p0.y))
        +kc*nrf_hist_linear(pm)+kd*nrf_hist_linear(vec2(pm.x,p2.y))+kr*nrf_hist_linear(vec2(p2.x,pm.y)))
        /(kl+ku+kc+kd+kr);
}
float nrf_depth_at(ivec2 xy) {
    uint W=pc.p5.x,H=pc.p5.y;
    return f[pc.p6.w+uint(nrf_mirror(xy.y,int(H)))*W+uint(nrf_mirror(xy.x,int(W)))];
}
vec2 nrf_motion_uv(vec2 uv) {
    uint W=pc.p5.x,H=pc.p5.y;
    vec2 q=(uv*vec2(nrf_ctl(15),nrf_ctl(16))+vec2(nrf_ctl(17),nrf_ctl(18)))*vec2(W,H);
    ivec2 xy=ivec2(floor(q));
    uint a=pc.p6.z+(uint(nrf_mirror(xy.y,int(H)))*W+uint(nrf_mirror(xy.x,int(W))))*2u;
    return vec2(f[a]*nrf_ctl(13),f[a+1u]*nrf_ctl(14));
}

// One pixel of the 8x8 patch per invocation (64 of the 128 lanes), written to
// nrf_feat[token*16+j] in the order the bound features pass wrote NHWC.
void nrf_prepare_features() {
    const uint tid=gl_LocalInvocationID.x;
    for(uint i=tid;i<64u;i+=128u) {
        const uint xl=i%8u,yl=i/8u;
        const uint wgx=(pc.p3.y!=0)?uint(pc.p0.w):gl_WorkGroupID.x;
        const uint wgy=(pc.p3.y!=0)?uint(pc.p3.x):gl_WorkGroupID.y;
        const uint px=wgx*8u+xl,py=wgy*8u+yl;
        const uint W=pc.p5.x,H=pc.p5.y;
        const int sx=px<W?int(px):2*int(W)-int(px)-2;
        const int sy=py<H?int(py):2*int(H)-int(py)-2;
        const ivec2 xy=ivec2(sx,sy);
        const vec2 uv=(vec2(xy)+0.5)/vec2(W,H);
        const vec3 sampled=nrf_rgba(pc.p4.z,W,H,xy).rgb;
        const f16vec3 centered=f16vec3(sampled)-f16vec3(0.5);
        const f16vec3 cn=centered*float16_t(0.125);
        f16vec3 hn=cn;
        if(nrf_ctl(8)!=0.0) {
            ivec2 bestxy=xy;
            if(nrf_ctl(11)!=0.0) {
                float best=nrf_depth_at(xy);
                for(int dy=-1;dy<=1;dy+=2)for(int dx=-1;dx<=1;dx+=2) {
                    ivec2 q=xy+ivec2(dx,dy); float v=nrf_depth_at(q);
                    if(nrf_ctl(12)!=0.0?v>best:v<best) {best=v;bestxy=q;}
                }
            }
            vec2 muv=(vec2(bestxy)+0.5)/vec2(W,H);
            vec3 hv=nrf_history5((uv+nrf_motion_uv(muv))*vec2(nrf_ctl(9),nrf_ctl(10)));
            hn=(f16vec3(hv)-f16vec3(0.5))*float16_t(0.125);
        }
        vec3 noise;
        const uint g=py*pc.p4.x+px;   // the bound pass's gl_GlobalInvocationID.x
        if((pc.p5.w&4u)!=0u) {
            // Accepted seed0 cold field, bound to seed/noise/control provenance.
            uint ni=pc.p4.w+g*3u;
            noise=vec3(f[ni],f[ni+1u],f[ni+2u]);
        } else {
            uint base=(px*0x8DA6B343u)^(pc.p5.z*0x9E3779B9u)^(py*0xD8163841u)^0x243F6A88u;
            uint v=nrf_pcg(base),h=(v>>22u)^v;
            float uA=nrf_uniform01(h*0x2C9277B5u+0xAC564B05u),uB=nrf_uniform01(h*0xFA6DC5F9u+0x4712A88Eu);
            float uC=nrf_uniform01(h*0xCAA5B80Du+0x21DD796Bu),uD=nrf_uniform01(h*0x83232C31u+0x3463E0ACu);
            float rA=sqrt(-2.0*log(uA)),rC=sqrt(-2.0*log(uC));
            float a1=uB*6.28318530718,a2=uD*6.28318530718;
            noise=vec3(nrf_ctl(5)*rA*cos(a1),nrf_ctl(5)*rA*sin(a1),nrf_ctl(5)*rC*cos(a2));
        }
        float values[16]=float[16](noise.x,noise.y,noise.z,nrf_ctl(6),
            float(cn.x),float(cn.y),float(cn.z),float(hn.x),float(hn.y),float(hn.z),
            nrf_ctl(0),nrf_ctl(1),nrf_ctl(2),nrf_ctl(3),nrf_ctl(4),0.0);
        const uint token=((yl/4u)*2u+(xl/4u))*16u+(yl%4u)*4u+(xl%4u);
        for(uint j=0u;j<16u;++j)nrf_feat[token*16u+j]=float16_t(values[j]);
    }
}

// The lift of one 8-channel group over this subgroup's own 16 tokens.
// project-k16: acc[pixel][n] = sum_k features[pixel][k] * w[n][k] (fp32
// accumulate, one fp16 rounding).  Here A carries the 8 output channels and B
// the 16 tokens, so the product is the block's own B fragment.  The K terms and
// their order are identical; f16xf16 products are exact in fp32, so the
// accumulator is bit-identical.
// The lift of one 8-channel group over this subgroup's own 16 tokens.
// INT8 in this card: the 16 real features occupy K = 0..15 and K = 16..31 are
// written as code 0 in BOTH operands (the weight tile and the staged feature
// tile), so the integer dot is exactly sum_{k<16} and the zero padding cannot
// reach the residual.  One dequantisation per output channel produces the
// actual half lift result, which is then used unchanged by the contract seed
// H(X*rs) and by the expand code point.
void nrf_lift_stage(uint q,out float sF,out float invF) {
    const uint lane = gl_LocalInvocationID.x & 31u;
    float m = 0.0;
    for (uint i = lane; i < 256u; i += 32u) m = max(m, abs(float(nrf_feat[q * 256u + i])));
    const float ms = nr_i8_sgmax(m);
    sF = max(ms, 1e-12) / 127.0;
    nr_dg_scale(q, sF);
    invF = 127.0 / max(ms, 1e-12);
    for (uint i = lane; i < 512u; i += 32u) {
        const uint tk = i / 32u, kk = i % 32u;
        sE8[q * 512u + i] = (kk < 16u)
            ? int8_t(nr_i8_code(nrf_feat[q * 256u + tk * 16u + kk], invF))
            : int8_t(0);
    }
    subgroupMemoryBarrierShared();
    subgroupBarrier();
    if (NR_DIAG) {
        for (uint e = lane; e < 512u; e += 32u)
            dg[NR_DG_X65 + q * 512u + e] = uint(int(sE8[q * 512u + e]));
    }
}
NRH_CH nrf_lift(uint base,uint g,float invF,float sF) {
    I8B feats8;
    coopMatLoad(feats8,sE8,base,32u,LCOL);
    I8A lift;
    coopMatLoad(lift,wb8,C32I8B_WLIFT + g * 1024u,32u,LCOL);
    I8C acc=I8C(0);
    acc=coopMatMulAdd(lift,feats8,acc);
    I8F f=I8F(acc);
    NRH_C o = NRH_C(0.0);
    for (int i = 0; i < 4; ++i) {
        uvec2 rc = nrh_coord_C(uint(i));
        o[i] = f[i] * (fsc2[C32I8B_SL + 8u * g + rc.x] * sF);
    }
    return nrh_narrow(o);
}

void main() {
    nrf_prepare_features();
    barrier();
    nr_body_stage();
}

// ---- T3 transport: identity subgroup round-trips removed -----------------
// nrh_unpack2(p) performed subgroupShuffle(p, lane^1) twice; the two shuffles
// are exact inverses for every lane, so the helper equals unpackFloat2x16(p)
// for every input.  nrh_materialize(h) is the same pack/unpack round trip on
// both component pairs (identity), nrh_narrow's extra materialize and the
// nrh_widen_exact pack/unpack round trips are identities too.  No arithmetic,
// conversion, cooperative-matrix or memory-access instruction changes.
