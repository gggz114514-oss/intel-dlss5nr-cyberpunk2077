#version 450
#extension GL_ARB_shader_clock : require
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x=256) in;
#include "split16_ffwd_exec_opt_common.glsl"
#define MH coopmat<float16_t,gl_ScopeSubgroup,8,16,gl_MatrixUseAccumulator>
// Group2 and same-A/two-B retained. Direct global A replaces prior sx sharing.
// Normal MH activation retained. Debug uses original actual-half scalar reads.
// The failed MC(MH) debug-widening assumption is retired; sr/sa publication stays.
shared float16_t sr[2048],sa[8192];
uvec2 nrClockStart,nrClockEnd;
void nr_original_main() {
    uint lid=gl_LocalInvocationID.x,sg=lid/32u,lane=lid%32u;
    uint t0=gl_WorkGroupID.x*16u,gBase=gl_WorkGroupID.y*2u;
    uint sgLocal=sg%4u,localGroup=sg/4u,g=gBase+localGroup;
    uint srBase=localGroup*1024u,saBase=localGroup*4096u;
    {
        uint m0=(sgLocal/2u)*8u,n0=(sgLocal%2u)*32u;
        const uint xBase=tiled(t0+m0,0u,512u);
        const uint bBase=uint(pc.p2.x)+((g*64u+n0)/16u)*8192u;
        MC c0=MC(0.0),c1=MC(0.0);
        for(uint k=0u;k<512u;k+=16u) {
            MA a;MB b0,b1;
            coopMatLoad(a,gx,xBase+(k/16u)*256u,16u,ROW);
            coopMatLoad(b0,weights,bBase+(k/16u)*256u,16u,COL);
            coopMatLoad(b1,weights,bBase+8192u+(k/16u)*256u,16u,COL);
            c0=coopMatMulAdd(a,b0,c0);c1=coopMatMulAdd(a,b1,c1);
        }
        for(uint side=0u;side<2u;side++) {
            MH value;
            if(side==0u) value=MH(c0);else value=MH(c1);
            coopMatStore(value,sr,srBase+m0*64u+n0+side*16u,64u,ROW);
            if(pc.p5.x!=0) {
                subgroupMemoryBarrierShared();subgroupBarrier();
                for(uint e=lane;e<128u;e+=32u) {
                    uint t=m0+e/16u,c=n0+side*16u+e%16u;
                    dbg[uint(pc.p5.y)+(t0+t)*512u+g*64u+c]=float(sr[srBase+t*64u+c]);
                }
                subgroupMemoryBarrierShared();subgroupBarrier();
            }
        }
    }
    barrier();
    // T1: stage-2 A reuse.  j and j+2 of the parent's loop share m0 (only n0
    // differs by 128), so the 8-token A fragment from sr was loaded twice per k
    // step.  mm = 0/1 selects m0 = 8*mm and both n0 halves accumulate in the same
    // k loop: one A load feeds four products, each accumulator still takes its own
    // B fragments in ascending k order (identical value graph per element).
    // sr/sa staging, the two-B reuse, the activation position, the debug dump and
    // the stage-3 direct store are unchanged.
#define STAGE2_EMIT(ACC,N) { \
        MH value=MH(ACC); \
        if(pc.p5.x!=0) { \
            coopMatStore(value,sa,saBase+m0*256u+(N),256u,ROW); \
            subgroupMemoryBarrierShared();subgroupBarrier(); \
            for(uint e=lane;e<128u;e+=32u) { \
                uint t=m0+e/16u,c=(N)+e%16u; \
                float16_t raw=sa[saBase+t*256u+c]; \
                sa[saBase+t*256u+c]=activation(raw); \
                uint ix=(t0+t)*2048u+g*256u+c; \
                dbg[uint(pc.p5.z)+ix]=float(raw);dbg[uint(pc.p5.w)+ix]=float(sa[saBase+t*256u+c]); \
            } \
            subgroupMemoryBarrierShared();subgroupBarrier(); \
        } else { \
            for(int ci=0;ci<value.length();++ci) value[ci]=activation(value[ci]); \
            coopMatStore(value,sa,saBase+m0*256u+(N),256u,ROW); \
        } }
    for(uint mm=0u;mm<2u;mm++) {
        const uint m0=mm*8u;
        const uint n0a=(sgLocal%8u)*32u,n0b=n0a+128u;
        const uint bBaseA=uint(pc.p2.y)+((g*256u+n0a)/16u)*1024u;
        const uint bBaseB=uint(pc.p2.y)+((g*256u+n0b)/16u)*1024u;
        MC c0=MC(0.0),c1=MC(0.0),d0=MC(0.0),d1=MC(0.0);
        for(uint k=0u;k<64u;k+=16u) {
            MA a;
            coopMatLoad(a,sr,srBase+m0*64u+k,64u,ROW);
            { MB b; coopMatLoad(b,weights,bBaseA+(k/16u)*256u,16u,COL);
              c0=coopMatMulAdd(a,b,c0); }
            { MB b; coopMatLoad(b,weights,bBaseA+1024u+(k/16u)*256u,16u,COL);
              c1=coopMatMulAdd(a,b,c1); }
            { MB b; coopMatLoad(b,weights,bBaseB+(k/16u)*256u,16u,COL);
              d0=coopMatMulAdd(a,b,d0); }
            { MB b; coopMatLoad(b,weights,bBaseB+1024u+(k/16u)*256u,16u,COL);
              d1=coopMatMulAdd(a,b,d1); }
        }
        STAGE2_EMIT(c0,n0a)
        STAGE2_EMIT(c1,n0a+16u)
        STAGE2_EMIT(d0,n0b)
        STAGE2_EMIT(d1,n0b+16u)
    }
#undef STAGE2_EMIT
    barrier();
    {
        uint m0=sgLocal/2u*8u,n0=sgLocal%2u*32u;
        const uint bBase=uint(pc.p2.z)+((g*64u+n0)/16u)*4096u;
        MC c0=MC(0.0),c1=MC(0.0);
        for(uint k=0u;k<256u;k+=16u) {
            MA a;MB b0,b1;
            coopMatLoad(a,sa,saBase+m0*256u+k,256u,ROW);
            coopMatLoad(b0,weights,bBase+(k/16u)*256u,16u,COL);
            coopMatLoad(b1,weights,bBase+4096u+(k/16u)*256u,16u,COL);
            c0=coopMatMulAdd(a,b0,c0);c1=coopMatMulAdd(a,b1,c1);
        }
        for(uint side=0u;side<2u;side++) {
            MH value;
            if(side==0u) value=MH(c0);else value=MH(c1);
            // t0 is a multiple of 16; m0=0/8 and this 16-column fragment
            // never crosses a token/channel tile. Stride is 16 halfs.
            coopMatStore(value,gf,tiled(t0+m0,g*64u+n0+side*16u,512u),16u,ROW);
        }
    }
}

layout(set=0,binding=15,std430) buffer ClockProbe { uint clockWords[]; };
void main(){nrClockStart=clock2x32ARB();nr_original_main();nrClockEnd=clock2x32ARB();uint wi=(gl_WorkGroupID.z*gl_NumWorkGroups.y+gl_WorkGroupID.y)*gl_NumWorkGroups.x+gl_WorkGroupID.x;
if((wi%16u)==0u && gl_SubgroupInvocationID==0u){uint r=(wi*8u+gl_SubgroupID)*4u;clockWords[r]=nrClockStart.x;clockWords[r+1u]=nrClockStart.y;clockWords[r+2u]=nrClockEnd.x;clockWords[r+3u]=nrClockEnd.y;}}
