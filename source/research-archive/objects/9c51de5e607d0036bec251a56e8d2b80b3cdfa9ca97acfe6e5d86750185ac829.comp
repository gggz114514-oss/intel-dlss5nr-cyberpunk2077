// F3-C128 fused candidate (f3-c128-fused-half-patch-v1, netorg acceleration 2026-10-16).
// Base: the bound pass-49 body c128_d4_full.comp (sha256 66435c26161b9008, byte-identical raw compile)
// verbatim, plus the pass-50 downsample epilogue inlined at the end.
// Body geometry 22x13x1, shift (-1,-1), token geometry, global stores and
// push words 0..20/27/30/31 are preserved; the DS fields use words
// 21..26/28..29, which the bound body SPV never reads.
// Weight contract: the bound pass-50 kernel ds-f19-paired.spv loads the 16x16
// blocked form woff = whalf + ((n/16)*(K/16) + k/16)*256, stride 16.
// C128 D4 directA+WOtileB+cooperative seed/output: original seed-before-K math and two-accumulator ownership.
//
// ===========================================================================
// DSH R10 (F3-C128 `f3c128_body_ds`): BOTH matrix stages become INT8.
//
//   * **WO** = the front-end output projection of `nr_body_stage`
//     (`acc = gT_window x W_wo^T`, K = 128 = context channels, 2 static MulAdd
//     sites, 8x16x16 fp16 -> f32 in four j iterations).  A = `gT`, the
//     pre-pool context tile of this window; B = the module's own `pack`
//     (binding 0) at `wo + (n0/16)*2048 + (k0/16)*256`, stride 16, LCOL.
//   * **DS** = the post-pool down-sample projection in `main`
//     (`acc = mean tile x W_ds^T`, K = 128, N = 256, 4 static MulAdd sites).
//     A = `nrf_mean`, the pooled 2x2 tile; B = `nrf_w` (binding 8) at
//     `whalf + ((n/16)*(K/16) + k/16)*256`, stride 16, LCOL.
//
// Both become signed int8 A/B with an INT32 accumulator.  Everything else the
// parent computes is kept: the half pooling tree, the half residual seed, the
// `precise` qualifiers, the single half narrowing per output element and all
// four store streams.
//
// ACTI VATION DOMAINS (this is the choice the GUIDE demands be explicit):
//   * WO activation domain = **pre-pool**: `gT[w*8192 .. +8192]`, i.e. the 64
//     tokens x 128 channels of context this workgroup multiplies.  Quantised
//     once per workgroup with the amax of that same tile, computed in-kernel
//     from the same half values the fp16 arm multiplies.  No capture, no
//     cross-frame calibration, no borrowed constant.
//   * DS activation domain = **post-pool**: `nrf_mean`, the pooled 2x2 tile,
//     written by the parent's unique pooling writer and quantised exactly
//     once afterwards (see the block comment at the quantiser).  The pooling
//     itself stays fp16: `nrf_pair` (the WO output staging) and the whole
//     pooling tree are the parent's text, unchanged.
//
// WEIGHT PACKS (new, binding 10..13; the fp16 packs stay bound and unread):
//   * `gWo8`   int8 128x128 = 16384 B, I8B K32 layout
//     idx(n,k) = (n/16)*(K/32)*512 + (k/32)*512 + (n%16)*32 + (k%32)
//   * `gWosc`  f32 128 per-output-channel scales, W code = round(W/s)
//   * `gDs8`   int8 256x128 = 32768 B, same formula (ds_whalf is folded into
//     the pack, so the kernel no longer adds pc.p6.y)
//   * `gDssc`  f32 256 per-output-channel scales
// Dequantisation is folded once per output element: value =
// int32_acc * (s_act * s_w[n]) + seed, then one half narrowing.
//
// DIAGNOSTIC SWITCH.  NR_D4_MODE is kept exactly as the parent defines it
// (0 full / 1 seed only / 2 mma only).  In this INT8 module mode 1 leaves the
// accumulator at zero and mode 2 zeroes the widened seed, i.e. the same two
// ablations the parent offers, applied to the INT8 epilogue.
//
// DSH R10, CPU-only evidence.  No GPU was used to produce this file.
// ===========================================================================
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_8bit_storage : require

layout(local_size_x = 256) in;
// diagnostics: NR_D4_SEED_ONLY / NR_D4_MMA_ONLY isolate the two O components
#ifndef NR_D4_MODE
#define NR_D4_MODE 0   // 0 = full, 1 = seed only, 2 = mma only
#endif
// The K this module is built for: PASS 14 pushes p6.x = 128 (K) and
// p5.w = 256 (N).  K is a compile-time constant here only because the staging
// layout below is indexed by it; it is cross-checked against p6.x at the first
// use (the DS loop runs k < uint(pc.p6.x)).
#define K_THIS 128u
#define N_THIS 256u

shared float16_t nrf_pair[2048u];
// The pooled tile keeps the parent's type and its parent-text writer: it is the
// *staging* for the single post-pool quantisation, and its 2048 half values are
// exactly the values the fp16 DS would have multiplied.
shared float16_t nrf_mean[2048u];
shared float16_t nrf_stage[1024u];
// R10 post-pool INT8 operand: element (slot s, channel k) at k*32 + s
// (column-major stride 32, the measured I8A layout of this family), 128*32 B.
shared int8_t nrf_mean8[K_THIS * 32u];
#include "c64_c128_common.glsl"

layout(set = 0, binding = 6) buffer YBuf { float16_t gY[]; };
layout(set = 0, binding = 7) buffer TBuf { float16_t gT[]; };
// kept verbatim: still declared, no longer read by the INT8 DS
layout(set = 0, binding = 8) buffer DsWeightBuf { float16_t nrf_w[]; };
layout(set = 0, binding = 9) buffer DsOutBuf { float16_t nrf_o[]; };
// R10: INT8 WO tiles, K32 blocked (128 out x 128 in = 16384 B)
layout(set = 0, binding = 10) readonly buffer Wo8Buf { int8_t gWo8[]; };
// R10: WO per-output-channel scales (128 f32)
layout(set = 0, binding = 11) readonly buffer WoScaleBuf { float gWosc[]; };
// R10: INT8 DS tiles, K32 blocked (256 out x 128 in = 32768 B), whalf folded out
layout(set = 0, binding = 12) readonly buffer Ds8Buf { int8_t gDs8[]; };
// R10: DS per-output-channel scales (256 f32)
layout(set = 0, binding = 13) readonly buffer DsScaleBuf { float gDssc[]; };

#define MAT_H coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>
// R10 operand types: the same measured SG32 I8A/I8B/I8C combination the C64
// sibling uses for its DS path (8x32 A, 32x16 B, 8x16 i32 accumulator).
#define I8A coopmat<int8_t, gl_ScopeSubgroup, 8, 32, gl_MatrixUseA>
#define I8B coopmat<int8_t, gl_ScopeSubgroup, 32, 16, gl_MatrixUseB>
#define I8C coopmat<int, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>

// WO activation staging: element (token t, channel k) of this window sits at
//   ((t / 32) * 128 + k) * 32 + (t % 32)
// so an 8-token x 32-channel K32 A fragment is a column-major stride-32 view
// (byte k*32 + m) -- the measured I8A layout. 8 KiB, workgroup-private.
shared int8_t sT8[8192];
// One amax partial per invocation, then a single serial reduction and a
// two-slot publication (inv scale, fwd scale).
shared float shMax[256];
shared float shScale[2];

void nr_body_stage() {
    const uint t_local = gl_LocalInvocationID.x;
    const uint sg = t_local / 32u;
    const uint lane = t_local % 32u;
    const uint wx = (pc.p1.z != 0) ? uint(pc.p2.x) : gl_WorkGroupID.x;
    const uint wy = (pc.p1.z != 0) ? uint(pc.p2.y) : gl_WorkGroupID.y;
    const uint w = wy * uint(pc.p1.x) + wx;
    const bool debug = pc.p1.w != 0;
    const uint wo = uint(pc.p4.x);
    const uint ars = uint(pc.p4.z);   // p4.y is rs (used by D2) — ars is p4.z

    if (debug) {
        for (uint e = t_local; e < 8192u; e += 256u) {
            dbg[212992u + e] = gT[w * 8192u + e];
            dbg[81920u + e] = gY[w * 8192u + e];
        }
        barrier();
    }

    // ---- R10 WO activation quantiser (PRE-POOL domain) --------------------
    // Pass 1: this window's context amax, read from the same gT half values the
    // fp16 arm multiplies. Per tensor per workgroup.
    {
        float amax = 0.0;
        for (uint e = t_local; e < 8192u; e += 256u)
            amax = max(amax, abs(float(gT[w * 8192u + e])));
        shMax[t_local] = amax;
    }
    barrier();
    if (t_local == 0u) {
        float m = 0.0;
        for (uint i = 0u; i < 256u; ++i) m = max(m, shMax[i]);
        precise float inv = (m > 0.0) ? 127.0 / m : 0.0;
        precise float sC  = (m > 0.0) ? m / 127.0 : 0.0;
        shScale[0] = inv;
        shScale[1] = sC;
    }
    barrier();
    const float invC = shScale[0];
    const float sC = shScale[1];
    // Pass 2: one code point per (token, channel), same roundEven + clamp to
    // +-127 the C64 INT8 template uses.
    for (uint e = t_local; e < 8192u; e += 256u) {
        const uint t = e >> 7u;
        const uint k = e & 127u;
        sT8[((t >> 5u) * 128u + k) * 32u + (t & 31u)] =
            int8_t(clamp(roundEven(float(gT[w * 8192u + e]) * invC), -127.0, 127.0));
    }
    barrier();

    for (uint j = 0u; j < 4u; ++j) {
        uint m0 = (sg / 4u + 2u * j) * 8u;
        uint n0 = (sg % 4u) * 32u;
        I8C acc0, acc1;
        acc0 = I8C(0);
        acc1 = I8C(0);
        MAT_H scale0, scale1;
        coopMatLoad(scale0, pack, ars + n0, 0u, LROW);
        coopMatLoad(scale1, pack, ars + (n0 + 16u), 0u, LROW);
        for (uint ki = 0u; ki < 4u; ++ki) {
            const uint k0 = ki * 32u;
            I8B b0, b1;
            coopMatLoad(b0, gWo8, (n0 / 16u) * 2048u + ki * 512u, 32u, LCOL);
            coopMatLoad(b1, gWo8, ((n0 + 16u) / 16u) * 2048u + ki * 512u, 32u, LCOL);
            I8A a;
            coopMatLoad(a, sT8, (m0 / 32u) * 4096u + k0 * 32u + (m0 % 32u), 32u, LCOL);
#if NR_D4_MODE != 1
            acc0 = coopMatMulAdd(a, b0, acc0);
            acc1 = coopMatMulAdd(a, b1, acc1);
#endif
        }
        // ---- R10 INT8 WO epilogue ----------------------------------------
        // seed = widen(H(gY * pack[ars+n])) exactly as the parent, then one
        // dequant multiply (acc * sC * sWo[n]), one add, one narrow.
        {
            MAT_H seed;
            coopMatLoad(seed, gY, (w * 64u + m0) * 128u + n0, 128u, LROW);
            seed = seed * scale0;
#if NR_D4_MODE == 2
            MAT_C seedc = MAT_C(0.0);
#else
            MAT_C seedc = MAT_C(seed);
#endif
            MAT_C fsc;
            coopMatLoad(fsc, gWosc, n0, 0u, LROW);
            fsc = fsc * MAT_C(sC);
            precise MAT_C prod = MAT_C(acc0) * fsc;
            precise MAT_C sumv = prod + seedc;
            MAT_H narrowed = MAT_H(sumv);
            if (debug)
                coopMatStore(narrowed, dbg, 221184u + m0 * 128u + n0, 128u, LROW);
            bool oob;
            uint addr = c128_img_half_index(m0, n0, wx, wy, oob);
            if (!oob)
                coopMatStore(narrowed, imgout, addr, 16u, LROW);
            coopMatStore(narrowed, nrf_pair, (sg * 2u + 0u) * 128u, 16u, LROW);
        }
        {
            MAT_H seed;
            coopMatLoad(seed, gY, (w * 64u + m0) * 128u + (n0 + 16u), 128u, LROW);
            seed = seed * scale1;
#if NR_D4_MODE == 2
            MAT_C seedc = MAT_C(0.0);
#else
            MAT_C seedc = MAT_C(seed);
#endif
            MAT_C fsc;
            coopMatLoad(fsc, gWosc, n0 + 16u, 0u, LROW);
            fsc = fsc * MAT_C(sC);
            precise MAT_C prod = MAT_C(acc1) * fsc;
            precise MAT_C sumv = prod + seedc;
            MAT_H narrowed = MAT_H(sumv);
            if (debug)
                coopMatStore(narrowed, dbg, 221184u + m0 * 128u + (n0 + 16u), 128u, LROW);
            bool oob;
            uint addr = c128_img_half_index(m0, (n0 + 16u), wx, wy, oob);
            if (!oob)
                coopMatStore(narrowed, imgout, addr, 16u, LROW);
            coopMatStore(narrowed, nrf_pair, (sg * 2u + 1u) * 128u, 16u, LROW);
        }

        // ---- F3-C128 fused epilogue: this j's 2x2 mean --------------------
        // subgroup (R = sg>>2, n0 = (sg%4)*32) owns 32 channels of the fragment
        // whose eight rows are the tile slots 8R + r; j fixes the tile
        // (sx1, sy1) = (j&1, j>>1), so dy = R and the pooled pixel reads rows
        // 2dx + {0,1,4,5} of the fragment pair.
        subgroupBarrier();
        {
            const uint ch  = lane & 15u;
            const uint acc = lane >> 4u;          // fragment channels n0/n0+16
            const uint R   = sg >> 2u;            // slot half == pooled row in tile
            const uint sx1 = j & 1u;
            const uint sy1 = j >> 1u;
            const uint kk  = (sg % 4u) * 32u + acc * 16u + ch;
            const uint base = (sg * 2u + acc) * 128u;
            const int  tx = 2 * int(wx) + pc.p0.z + int(sx1);
            const int  ty = 2 * int(wy) + pc.p0.w + int(sy1);
            const bool tile_ok = (tx >= 0) && (ty >= 0) &&
                                 (tx < pc.p0.x) && (ty < pc.p0.y);
            for (uint dx = 0u; dx < 2u; ++dx) {
                const uint r0 = 2u * dx;
                const uint px = 4u * wx - 2u + 2u * sx1 + dx;
                const int  py = 4 * int(wy) - 2 + 2 * int(sy1) + int(R);
                const uint ly = 2u * sy1 + R;
                const uint lx = 2u * sx1 + dx;
                precise float16_t v = float16_t(0);
                if (tile_ok && px < uint(pc.p7.x) && py >= 0 &&
                    uint(py) < uint(pc.p7.y) && uint(py) < uint(pc.p5.z)) {
                    precise float16_t a  = nrf_pair[base + r0 * 16u + ch];
                    precise float16_t b  = nrf_pair[base + (r0 + 1u) * 16u + ch];
                    precise float16_t cc = nrf_pair[base + (r0 + 4u) * 16u + ch];
                    precise float16_t dd = nrf_pair[base + (r0 + 5u) * 16u + ch];
                    precise float16_t top = a + b;
                    precise float16_t bottom = cc + dd;
                    precise float16_t sum = top + bottom;
                    v = sum * float16_t(0.25);
                }
                nrf_mean[(4u * ly + lx) * uint(pc.p6.x) + kk] = v;
            }
        }
        subgroupBarrier();
    }

    // ---- R10 POST-POOL quantisation (the one and only) --------------------
    // All 16 slots x K channels of this workgroup's pooled tile are in
    // nrf_mean now (every (slot, channel) pair has exactly one owner above).
    // The parent's DS would multiply those half values directly; this arm
    // multiplies their int8 codes with one per-workgroup scale, so the pooled
    // value is quantised here and nowhere else.
    barrier();
    {
        float amax = 0.0;
        for (uint e = t_local; e < 2048u; e += 256u)
            amax = max(amax, abs(float(nrf_mean[e])));
        shMax[t_local] = amax;
    }
    barrier();
    if (t_local == 0u) {
        float m = 0.0;
        for (uint i = 0u; i < 256u; ++i) m = max(m, shMax[i]);
        precise float inv = (m > 0.0) ? 127.0 / m : 0.0;
        precise float sD  = (m > 0.0) ? m / 127.0 : 0.0;
        shScale[0] = inv;
        shScale[1] = sD;
    }
    barrier();
    const float invD = shScale[0];
    for (uint e = t_local; e < 2048u; e += 256u) {
        const uint slot = e >> 7u;      // e = slot*K + k, K = 128
        const uint k    = e & 127u;
        nrf_mean8[k * 32u + slot] =
            int8_t(clamp(roundEven(float(nrf_mean[e]) * invD), -127.0, 127.0));
    }
    barrier();
}

// ---------------------------------------------------------------------------
// F3-C128 fusion scratch.
//   nrf_pair  : this iteration's two body fragments per subgroup (2 x 128 halfs).
//   nrf_mean  : the pooled tile, [16 slots][K] with stride K.
//   nrf_stage : the projection fragment staging (one 8x16 fragment per subgroup).
// The address helper is a verbatim copy of ioport_common.glsl io_at().
// ---------------------------------------------------------------------------

uint nrf_ds_at(uint px,uint py,uint c,uint W,uint H,uint C,uint layout_id) {
    if(layout_id==2u)return (py*W+px)*C+c;
    if(layout_id==3u) {
        uint sub=(c&1u)|((c>>3u&1u)<<1u)|((c>>1u&1u)<<2u)|((c>>2u&1u)<<3u);
        return (c/16u)*(W*H*16u)+(py*W+px)*16u+sub;
    }
    uint t=layout_id==1u?py*W+px:((py/4u)*(W/4u)+px/4u)*16u+4u*(py%4u)+px%4u;
    return ((t/16u)*(C/16u)+c/16u)*256u+(t%16u)*16u+c%16u;
}

// the parent DS's own output write pattern (lane%16 = channel, lane/16 = pixel),
// with the address computed per element: the fused workgroup owns a 4x4 pooled
// patch, so the parent's eight-raster-token M8 fragment is not reproducible, and
// the elements outside the 84x48 view are skipped exactly as the parent DS
// writes only that view.
void nrf_write_group(uint group, int px0i, int py0i, uint OW, uint OH, uint N,
                     uint obase, uint sg, uint lane) {
    for (uint i = lane; i < 128u; i += 32u) {
        uint m = i >> 4u, c = i & 15u;
        int px = px0i + int(m & 3u);
        int py = py0i + int(m >> 2u);
        if (px < 0 || py < 0 || uint(px) >= OW || uint(py) >= OH) continue;
        nrf_o[obase + nrf_ds_at(uint(px), uint(py), group * 16u + c, OW, OH, N, 0u)] =
            nrf_stage[sg * 128u + i];
    }
}

void main() {
    nr_body_stage();
    barrier();
    const uint tid  = gl_LocalInvocationID.x;
    const uint sg   = tid / 32u;
    const uint lane = tid % 32u;
    const uint wx = (pc.p1.z != 0u) ? uint(pc.p2.x) : gl_WorkGroupID.x;
    const uint wy = (pc.p1.z != 0u) ? uint(pc.p2.y) : gl_WorkGroupID.y;
    const uint OW = uint(pc.p5.y), OH = uint(pc.p5.z), N = uint(pc.p5.w), K = uint(pc.p6.x);
    const uint obase = uint(pc.p6.z);      // pc.p6.y (whalf) is folded into gDs8
    const uint sy = sg & 1u;                 // pooled row half
    const uint cb = sg >> 1u;                // 64-output-channel group (4 groups)
    const uint rowbase = 8u * sy;
    const int  px0 = 4 * int(wx) - 2;
    const int  py0 = 4 * int(wy) - 2 + 2 * int(sy);
    // post-pool activation scale, published by the quantiser above
    const float sD = shScale[1];
    {
        const uint nb0 = cb * 4u;                 // four output-channel blocks of 16
        I8C acc0 = I8C(0);
        I8C acc1 = I8C(0);
        I8C acc2 = I8C(0);
        I8C acc3 = I8C(0);
        for (uint k = 0u; k < K; k += 32u) {
            I8A aa;
            coopMatLoad(aa, nrf_mean8, rowbase + k * 32u, 32u, LCOL);
            I8B bb;
            coopMatLoad(bb, gDs8, ((nb0 + 0u) * (K / 32u) + k / 32u) * 512u, 32u, LCOL);
            acc0 = coopMatMulAdd(aa, bb, acc0);
            coopMatLoad(bb, gDs8, ((nb0 + 1u) * (K / 32u) + k / 32u) * 512u, 32u, LCOL);
            acc1 = coopMatMulAdd(aa, bb, acc1);
            coopMatLoad(bb, gDs8, ((nb0 + 2u) * (K / 32u) + k / 32u) * 512u, 32u, LCOL);
            acc2 = coopMatMulAdd(aa, bb, acc2);
            coopMatLoad(bb, gDs8, ((nb0 + 3u) * (K / 32u) + k / 32u) * 512u, 32u, LCOL);
            acc3 = coopMatMulAdd(aa, bb, acc3);
        }
        // one dequant per fragment: int32 acc * (sD * sDs[n]), then the parent's
        // single half narrowing and its shared staging store.
        {
            MAT_C fsc;
            coopMatLoad(fsc, gDssc, nb0 * 16u, 0u, LROW);
            fsc = fsc * MAT_C(sD);
            precise MAT_C prod = MAT_C(acc0) * fsc;
            MAT_H h = MAT_H(prod);
            coopMatStore(h, nrf_stage, sg * 128u, 16u, gl_CooperativeMatrixLayoutRowMajor);
        }
        subgroupBarrier();
        nrf_write_group(nb0 + 0u, px0, py0, OW, OH, N, obase, sg, lane);
        subgroupBarrier();
        {
            MAT_C fsc;
            coopMatLoad(fsc, gDssc, (nb0 + 1u) * 16u, 0u, LROW);
            fsc = fsc * MAT_C(sD);
            precise MAT_C prod = MAT_C(acc1) * fsc;
            MAT_H h = MAT_H(prod);
            coopMatStore(h, nrf_stage, sg * 128u, 16u, gl_CooperativeMatrixLayoutRowMajor);
        }
        subgroupBarrier();
        nrf_write_group(nb0 + 1u, px0, py0, OW, OH, N, obase, sg, lane);
        subgroupBarrier();
        {
            MAT_C fsc;
            coopMatLoad(fsc, gDssc, (nb0 + 2u) * 16u, 0u, LROW);
            fsc = fsc * MAT_C(sD);
            precise MAT_C prod = MAT_C(acc2) * fsc;
            MAT_H h = MAT_H(prod);
            coopMatStore(h, nrf_stage, sg * 128u, 16u, gl_CooperativeMatrixLayoutRowMajor);
        }
        subgroupBarrier();
        nrf_write_group(nb0 + 2u, px0, py0, OW, OH, N, obase, sg, lane);
        subgroupBarrier();
        {
            MAT_C fsc;
            coopMatLoad(fsc, gDssc, (nb0 + 3u) * 16u, 0u, LROW);
            fsc = fsc * MAT_C(sD);
            precise MAT_C prod = MAT_C(acc3) * fsc;
            MAT_H h = MAT_H(prod);
            coopMatStore(h, nrf_stage, sg * 128u, 16u, gl_CooperativeMatrixLayoutRowMajor);
        }
        subgroupBarrier();
        nrf_write_group(nb0 + 3u, px0, py0, OW, OH, N, obase, sg, lane);
        subgroupBarrier();
    }
}
