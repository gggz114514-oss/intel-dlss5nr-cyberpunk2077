#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x=32) in;
layout(set=0,binding=0) readonly buffer I { float16_t gx[]; };
layout(set=0,binding=1) buffer O { float16_t gf[]; };
layout(set=0,binding=2) readonly buffer W { float16_t wt[]; };
#define MA coopmat<float16_t,gl_ScopeSubgroup,8,16,gl_MatrixUseA>
#define MB coopmat<float16_t,gl_ScopeSubgroup,16,16,gl_MatrixUseB>
#define MC coopmat<float,gl_ScopeSubgroup,8,16,gl_MatrixUseAccumulator>
void main(){
    MA a; MB b; MC c = MC(0.0);
    coopMatLoad(a, gx, 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(b, wt, 0u, 16u, gl_CooperativeMatrixLayoutColumnMajor);
    c = coopMatMulAdd(a, b, c);
    coopMatStore(c, gf, 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
}
