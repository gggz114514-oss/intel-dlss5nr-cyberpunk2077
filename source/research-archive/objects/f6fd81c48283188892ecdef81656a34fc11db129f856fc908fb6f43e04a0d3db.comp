#version 450
layout(local_size_x=256) in;
layout(set=0,binding=0,std430) readonly buffer Input { uint words[]; };
layout(set=0,binding=1,std430) writeonly buffer Output { uint digest[]; };
layout(push_constant) uniform Push { uint count; uint base; } pc;
shared uvec4 partial[256];
uint mix32(uint x) { x^=x>>16; x*=0x7feb352du; x^=x>>15; x*=0x846ca68bu; return x^(x>>16); }
void main() {
 uint l=gl_LocalInvocationID.x,chunk=gl_WorkGroupID.x;
 uvec4 h=uvec4(0u);
 for(uint j=0u;j<4u;++j) {
  uint localWord=l+256u*j, i=chunk*1024u+localWord;
  if(i<pc.count) { uint v=words[i],u=mix32(v^(i*0x9e3779b9u)); h.x^=u;h.y+=u;h.z+=mix32(v+0x85ebca6bu);h.w+=v*(localWord+1u); }
 }
 partial[l]=h;barrier();
 for(uint stride=128u;stride>0u;stride>>=1u) {
  if(l<stride) { uvec4 p=partial[l+stride]; partial[l].x^=p.x;partial[l].yzw+=p.yzw; } barrier();
 }
 if(l==0u) { for(uint c=0u;c<4u;++c) digest[pc.base+chunk*4u+c]=partial[0][c]; }
}
