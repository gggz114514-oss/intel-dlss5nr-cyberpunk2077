// Complete transpose/register C32 handoff, CPU-generated literal fragments.
// AMD purpose: fswin_t.comp167-205: feature rows are the next contraction K.
// Intel coordinates come ONLY from the independently sealed measured helper.
// K/V cross-SG shared is required and explicitly retained; all other intermediates stay registers.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#include "register_handoff.glsl"

// ---- T3 transport variant: identity shuffle round-trips removed ----------
// nrh_unpack2(p) was:
//   uint moved = subgroupShuffle(p, lane ^ 1);
//   uint back  = subgroupShuffle(moved, lane ^ 1);
//   return unpackFloat2x16(back);
// The two shuffles are exact inverses for every lane (id is lane^1 both
// times), so back == p and the helper is unpackFloat2x16(p).  The value is
// unchanged for every input; only the lane-transport instructions disappear.

layout(local_size_x=128, local_size_y=1, local_size_z=1) in;
layout(set=0,binding=0) buffer HalfBuf { float16_t wb[]; };
layout(set=0,binding=1) buffer FloatBuf { float fb[]; };
layout(set=0,binding=2) buffer ImageFloats { float f[]; };
layout(set=0,binding=3) buffer ImageOut { float16_t imgout[]; };
layout(set=0,binding=4) buffer DebugBuf { float16_t dbg[]; };
// block0_out, the 2x2 mean: half-element pairs, exactly the parent pool's own
// `OutputPairs { f16vec2 o2[]; }` view of the same allocation.
layout(set=0,binding=5) buffer PoolOut { f16vec2 pooled[]; };
layout(push_constant) uniform PC {
    ivec4 p0; ivec4 p1; ivec4 p2; ivec4 p3;
    // F1 fields.  p4  = IW, IH, image float base, cold noise float base;
    // p5 = source_W, source_H, seed, flags (the feedback words 22/23);
    // p6 = controls, history, motion, depth float bases; p7 = lift half offset.
    uvec4 p4; uvec4 p5; uvec4 p6; uvec4 p7;
} pc;
shared float16_t shK[2048];
shared float16_t shV[2048];
shared float16_t shResidual[512];
#define LROW gl_CooperativeMatrixLayoutRowMajor
#define LCOL gl_CooperativeMatrixLayoutColumnMajor
// half MpCubicSilu (guide §2.1): one rounding per half op
float16_t nr_act_h(float16_t x) {
    float16_t t = clamp(x, float16_t(-4.0), float16_t(4.0));
    float16_t u = fma(float16_t(-0.055908203125), abs(t), float16_t(0.447265625));
    return x * fma(t, u, float16_t(0.89453125));
}

// half swin exp (guide §2.3). M05 paired form: the former scalar
// packHalf2x16/unpackHalf2x16 transform runs on two packed halves at once.
// Bit-identical proof (CHANGES.md): the mantissa is bits 0..9, so
// (h & 0x03ff03ff) << 5 sets only bits 5..14 of each 16-bit lane and can never
// cross into the other half, for any input; the clamp keeps exactly the scalar
// form's value domain, so fma/clamp/exception behaviour is unchanged.
f16vec2 nr_exp_h2(f16vec2 xy) {
    f16vec2 y = clamp(fma(xy, f16vec2(float16_t(0.044921875)), f16vec2(float16_t(1.30078125))),
                      f16vec2(float16_t(1.03125)), f16vec2(float16_t(1.5693359375)));
    uint h = packFloat2x16(y);
    return unpackFloat2x16((h & 0x03ff03ffu) << 5u);
}

// M01: every call site uses t = t0 = sg*16 (so q = sg, s = 0) and c in
// {0,8,16,24}; the tile base and oob are SG/WG-uniform and the four addresses
// differ only by (c/16)*256 + c%16 in {0,8,256,264}. The base is formed once
// per SG and broadcast — the AMD NR_WAVE_UNIFORM analog, applied only to
// genuinely SG-uniform values, not a global macro.
uint nr_tok_base(uint q, uint wx, uint wy, int shift, uint tiles_x, out bool oob) {
    int tx = 2 * int(wx) + shift + int(q & 1u);
    int ty = 2 * int(wy) + pc.p3.w + int(q >> 1u);
    oob = (tx < 0 || ty < 0 || tx >= int(tiles_x) || ty >= pc.p3.z);
    uint safe_tx = uint(clamp(tx, 0, int(tiles_x) - 1));
    uint safe_ty = uint(clamp(ty, 0, pc.p3.z-1));
    return (safe_ty * tiles_x + safe_tx) * 512u;   // s = 0, c = 0
}


f16vec2 full_norm(float16_t qlo,float16_t qhi,float16_t klo,float16_t khi) {
 uint col=gl_SubgroupInvocationID&15u;
 precise float16_t qs=qlo*qlo, ks=klo*klo;
 precise float16_t qh=qhi*qhi, kh=khi*khi;
 precise float16_t q=qs+qh, k=ks+kh;
 if(col==15u) {q=fma(qhi,qhi,qs);k=fma(khi,khi,ks);}
{f16vec2 peer=unpackFloat2x16(subgroupShuffleXor(packFloat2x16(f16vec2(q,k)),8u)); bool lower=(col&8u)==0u; q=(lower?q:peer.x)+(lower?peer.x:q); k=(lower?k:peer.y)+(lower?peer.y:k);}
{f16vec2 peer=unpackFloat2x16(subgroupShuffleXor(packFloat2x16(f16vec2(q,k)),4u)); bool lower=(col&4u)==0u; q=(lower?q:peer.x)+(lower?peer.x:q); k=(lower?k:peer.y)+(lower?peer.y:k);}
{f16vec2 peer=unpackFloat2x16(subgroupShuffleXor(packFloat2x16(f16vec2(q,k)),2u)); bool lower=(col&2u)==0u; q=(lower?q:peer.x)+(lower?peer.x:q); k=(lower?k:peer.y)+(lower?peer.y:k);}
{f16vec2 peer=unpackFloat2x16(subgroupShuffleXor(packFloat2x16(f16vec2(q,k)),1u)); bool lower=(col&1u)==0u; q=(lower?q:peer.x)+(lower?peer.x:q); k=(lower?k:peer.y)+(lower?peer.y:k);}
return f16vec2(float16_t(inversesqrt(max(float(q),float(float16_t(0.000062))))),float16_t(inversesqrt(max(float(k),float(float16_t(0.000062))))));}

void nr_transpose16(NRH_CH lo, NRH_CH hi, out NRH_CH o0, out NRH_CH o1) {
uint lane=gl_SubgroupInvocationID;
float16_t v0=lo[0];
float16_t v1=lo[1];
float16_t v2=lo[2];
float16_t v3=lo[3];
float16_t v4=hi[0];
float16_t v5=hi[1];
float16_t v6=hi[2];
float16_t v7=hi[3];
{
bool s=(lane & 2u)!=0u;
f16vec2 r=unpackFloat2x16(subgroupShuffleXor(packFloat2x16(f16vec2(s?v0:v1,s?v2:v3)),2u));
v0=s?r.x:v0; v1=s?v1:r.x;
v2=s?r.y:v2; v3=s?v3:r.y;
}
{
bool s=(lane & 2u)!=0u;
f16vec2 r=unpackFloat2x16(subgroupShuffleXor(packFloat2x16(f16vec2(s?v4:v5,s?v6:v7)),2u));
v4=s?r.x:v4; v5=s?v5:r.x;
v6=s?r.y:v6; v7=s?v7:r.y;
}
{
bool s=(lane & 4u)!=0u;
f16vec2 r=unpackFloat2x16(subgroupShuffleXor(packFloat2x16(f16vec2(s?v0:v2,s?v1:v3)),4u));
v0=s?r.x:v0; v2=s?v2:r.x;
v1=s?r.y:v1; v3=s?v3:r.y;
}
{
bool s=(lane & 4u)!=0u;
f16vec2 r=unpackFloat2x16(subgroupShuffleXor(packFloat2x16(f16vec2(s?v4:v6,s?v5:v7)),4u));
v4=s?r.x:v4; v6=s?v6:r.x;
v5=s?r.y:v5; v7=s?v7:r.y;
}
{
bool s=(lane & 8u)!=0u;
f16vec2 r=unpackFloat2x16(subgroupShuffleXor(packFloat2x16(f16vec2(s?v0:v4,s?v1:v5)),8u));
v0=s?r.x:v0; v4=s?v4:r.x;
v1=s?r.y:v1; v5=s?v5:r.y;
}
{
bool s=(lane & 8u)!=0u;
f16vec2 r=unpackFloat2x16(subgroupShuffleXor(packFloat2x16(f16vec2(s?v2:v6,s?v3:v7)),8u));
v2=s?r.x:v2; v6=s?v6:r.x;
v3=s?r.y:v3; v7=s?v7:r.y;
}
uint sl=(lane&14u)|((lane&1u)<<4u)|(lane>>4u);
o0=NRH_CH(float16_t(0)); o1=NRH_CH(float16_t(0));
{ f16vec2 r=unpackFloat2x16(subgroupShuffle(packFloat2x16(f16vec2(v0,v1)),sl)); o0[0]=r.x; o0[1]=r.y; }
{ f16vec2 r=unpackFloat2x16(subgroupShuffle(packFloat2x16(f16vec2(v2,v3)),sl)); o0[2]=r.x; o0[3]=r.y; }
{ f16vec2 r=unpackFloat2x16(subgroupShuffle(packFloat2x16(f16vec2(v4,v5)),sl)); o1[0]=r.x; o1[1]=r.y; }
{ f16vec2 r=unpackFloat2x16(subgroupShuffle(packFloat2x16(f16vec2(v6,v7)),sl)); o1[2]=r.x; o1[3]=r.y; }
}

