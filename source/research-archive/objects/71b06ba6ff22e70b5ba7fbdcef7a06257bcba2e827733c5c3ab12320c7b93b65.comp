void nr_pool_natural(NRH_CH x,uint t,uint fgroup,uint sg){
 uint lane=gl_SubgroupInvocationID;
 f16vec2 a=f16vec2(x[0],x[1]),b=f16vec2(x[2],x[3]);
 f16vec2 ap=unpackFloat2x16(subgroupShuffleXor(packFloat2x16(a),16u));
 f16vec2 bp=unpackFloat2x16(subgroupShuffleXor(packFloat2x16(b),16u));
 bool lower=(lane&16u)==0u;
 precise f16vec2 sx0=(lower?a:ap)+(lower?ap:a);
 precise f16vec2 sx1=(lower?b:bp)+(lower?bp:b);
 precise f16vec2 sum=sx0+sx1;
 precise f16vec2 mean=sum*f16vec2(float16_t(0.25));
 f16vec2 peer=unpackFloat2x16(subgroupShuffleXor(packFloat2x16(mean),1u));
 if((lane&17u)==0u){
  uint ch=fgroup*16u+(lane&15u);
  uint py=gl_WorkGroupID.y*4u+2u*(sg>>1u)+t;
  for(uint j=0u;j<2u;++j){
   uint px=gl_WorkGroupID.x*4u+2u*(sg&1u)+j;
   uint tile=(py/4u)*(uint(pc.p0.x)/2u)+(px/4u);
   uint slot=4u*(py&3u)+(px&3u);
   f16vec2 v=j==0u?f16vec2(mean.x,peer.x):f16vec2(mean.y,peer.y);
   pooled[((tile*2u+ch/16u)*256u+slot*16u+(ch&15u))/2u]=v;
  }
 }
}

