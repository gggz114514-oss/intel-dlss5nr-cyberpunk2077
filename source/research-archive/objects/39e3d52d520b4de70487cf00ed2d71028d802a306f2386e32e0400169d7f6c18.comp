// T03 isolated paired DS.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_memory_scope_semantics : require
#include "ioport_common.glsl"
layout(local_size_x=32) in;
// One subgroup computes eight spatial pixels and sixteen output channels.
// Largest DS K=256: 4096+512 bytes shared, no occupancy padding.
shared float16_t a_half[8*32];
shared float tile_f[128];
void main() {
    uint lane=gl_LocalInvocationID.x,m0=gl_WorkGroupID.x*8u,n0=gl_WorkGroupID.y*32u;
    for(uint i=lane;i<8u*pc.p1.x;i+=32u) {
        uint m=i/pc.p1.x,k=i%pc.p1.x,t=m0+m,px=t%pc.p0.z,py=t/pc.p0.z;
        precise float16_t v=float16_t(0);
        if(py<pc.p0.w&&px<pc.p3.z&&py<pc.p3.w) {
            precise float16_t top=io_read(2u*px,2u*py,k)+io_read(2u*px+1u,2u*py,k);
            precise float16_t bottom=io_read(2u*px,2u*py+1u,k)+io_read(2u*px+1u,2u*py+1u,k);
            precise float16_t sum=top+bottom;
            v=sum*float16_t(0.25);
        }
        a_half[i]=v;
    }
    barrier();
    coopmat<float,gl_ScopeSubgroup,8,16,gl_MatrixUseAccumulator> acc0=
        coopmat<float,gl_ScopeSubgroup,8,16,gl_MatrixUseAccumulator>(0.0);
    coopmat<float,gl_ScopeSubgroup,8,16,gl_MatrixUseAccumulator> acc1=coopmat<float,gl_ScopeSubgroup,8,16,gl_MatrixUseAccumulator>(0.0);
    for(uint k=0u;k<pc.p1.x;k+=16u) {
        coopmat<float16_t,gl_ScopeSubgroup,8,16,gl_MatrixUseA> aa;
        coopmat<float16_t,gl_ScopeSubgroup,16,16,gl_MatrixUseB> bb;
        coopMatLoad(aa,a_half,k,pc.p1.x,gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(bb,w,pc.p1.z+n0*pc.p1.x+k,pc.p1.x,gl_CooperativeMatrixLayoutColumnMajor);
        acc0=coopMatMulAdd(aa,bb,acc0);
        coopmat<float16_t,gl_ScopeSubgroup,16,16,gl_MatrixUseB> bb1;
        coopMatLoad(bb1,w,pc.p1.z+(n0+16u)*pc.p1.x+k,pc.p1.x,gl_CooperativeMatrixLayoutColumnMajor);
        acc1=coopMatMulAdd(aa,bb1,acc1);
    }
    coopMatStore(acc0,tile_f,0u,16u,gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    for(uint i=lane;i<128u;i+=32u) {
        uint t=m0+i/16u,px=t%pc.p0.z,py=t/pc.p0.z;
        if(py<pc.p0.w)io_write(px,py,n0+i%16u,float16_t(tile_f[i]));
    }
    barrier(); // All acc0 scratch reads finish before the acc1 store.
    coopMatStore(acc1,tile_f,0u,16u,gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    for(uint i=lane;i<128u;i+=32u) {
        uint t=m0+i/16u,px=t%pc.p0.z,py=t/pc.p0.z;
        if(py<pc.p0.w)io_write(px,py,n0+16u+i%16u,float16_t(tile_f[i]));
    }
}
