// c3x_body_c128 - n24-s5-gm-fold CANDIDATE (producer side of the gM A-tile fold).
//
// Parent: candidates/amd-netorg-t3b-20261018/c128-canonical-only-v1/source/
//         c3x_body_c128_r09.comp  (spv 12569d767adf…, PASS ordinal 193)
// Only the two mid-epilogue gM stores changed; every other statement, the
// shared shA publication, the debug path, the push-constant ABI and all math
// are byte-identical to the parent.
//
// FOLDED gM LAYOUT (must match candidate-194.comp exactly):
//   element (w, t, c)   w<264 window, t<64 token, c<128 channel
//     ->  w*8192 + (t/8)*1024 + (c/16)*128 + (t%8)*16 + (c%16)
//   i.e. gM is a sequence of 8x16 half tiles (row-major, row stride 16 halves
//   = 32 B) so an (8 tokens x 16 channels) tile is one contiguous 256 B run.
//   Tile (w, tr, tc) base = w*8192 + tr*1024 + tc*128 halves.
//
//   Old parent form was plain row-major: (w*64 + t)*128 + c (row stride 128).
//   Because m0 = 8*sg and the write columns are 32*g (+0/+16), the parent base
//   (w*64 + m0)*128 is *also* the folded tile-row base ( (m0/8)*1024 == m0*128 ),
//   so only the column-tile term and the row stride change:
//       column tile  (32*g + 0 )/16 = 2g   ->  + 2g*128 = 256*g halves
//       column tile  (32*g + 16)/16 = 2g+1 ->  + 256*g + 128
// A 64x128 window is 8192 halves in both layouts -> gM size (4,325,376 B for
// 264 windows) is unchanged; the map (w,t,c) -> index is a bijection
// (PROOF.json §mapping, enumerate.py).
//
// Why the consumer is byte-equivalent: the consumer loads the same 8x16 tile
// (mA..mA+7 tokens, k0..k0+15 channels) with row stride 16 instead of 128, so
// fragment element (i,j) still receives gM element (w, mA+i, k0+j).
//
// c3x_body_c128.comp - R07 dispatch B (C128): expand + act + mid reading the
// blended X from the canonical io_at layout-0 copy (binding 2, resource 205).
//
// Differences from f3in_c128_owner_only_v1:
//   * no gather, no projection, no blend, and no shared nr3_x / nr3_gbuf
//     (a 16,384 B reduction in declared workgroup memory);
//   * the expand loads MAT_A from the global X with row stride 128.
//
// T3b C128 direction B: the expand A loads now come from the same canonical
// copy the contract seed reads (binding 2 `imgin`, resource 205), not from the
// retired tiled staging (binding 12).  Inside one 4x4-token tile the canonical
// layout stores token s at +s*16 halves, so an M8 x K16 fragment is
// base + ki*256 halves with row stride 16 (8 rows x 16 halves = 256 contiguous
// halves); the index helper c128_img_half_index already carries the oob clamp
// and the tile base and is the function the debug path used for this resource.
// The four z shards (g) all read the same X block: the g term stays only in the
// weight half (pack base) and in the mid/output channel half, exactly as before.
//
// Grid 22×12×4.  Shared: shA 8,192 half = 16,384 B; the mid epilogue is a
// direct fragment store into gM (R09), so there is no float staging.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;
#include "nb05_swin_c128_common.glsl"

layout(set = 0, binding = 5) buffer MBuf { float16_t gM[]; };

shared float16_t shA[8192];      // [64][128]

#define MAT_H coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>

layout(set = 0, binding = 8) buffer Nr3Pack { float16_t pw[]; };
layout(set = 0, binding = 9) buffer Nr3Skip { float16_t sk[]; };
layout(set = 0, binding = 10) buffer Nr3BlendOut { float16_t blout[]; };
layout(set = 0, binding = 11) buffer Nr3ProjIn { float16_t x55[]; };
// Retained descriptor only: the plan keeps 13 bindings and resource 485 is still
// allocated for this pass, but the tiled staging is no longer read here.
layout(set = 0, binding = 12) buffer C3X { float16_t xg[]; };

void main() {
    const uint t_local = gl_LocalInvocationID.x;
    const uint sg = t_local / 32u;
    const uint lane = t_local % 32u;
    const uint wx = (pc.p1.z != 0) ? uint(pc.p2.x) : gl_WorkGroupID.x;
    const uint wy = (pc.p1.z != 0) ? uint(pc.p2.y) : gl_WorkGroupID.y;
    const uint g = gl_WorkGroupID.z;
    const uint w = wy * uint(pc.p1.x) + wx;
    const bool debug = pc.p1.w != 0;

    // Same canonical X debug half bits; no shared publication/retirement.
    if (debug && g == 0u) {
        for (uint e = t_local; e < 8192u; e += 256u) {
            bool oob;
            uint addr = c128_img_half_index(e / 128u, e % 128u, wx, wy, oob);
            dbg[e] = oob ? float16_t(0.0) : imgin[addr];
        }
    }

    // ---- expand 64×128×128: Nc=8, Np=4; per pair A(X rows) from global canonical X ----
    const uint we = uint(pc.p3.x);
    for (uint r = 0u; r < 2u; ++r) {
        uint mA = (sg / 4u + 4u * r) * 8u;
        uint mB = mA + 16u;
        uint n0 = (sg % 4u) * 32u;
        // Actual M8 stays in one token16 tile. C128 token base includes its own z shard.
        // Hoist tile addresses; K16 steps advance one channel tile, with uniform OOB.
        // Canonical layout: within a 16-token tile tokens are 16 halves apart, so an
        // M8 x K16 fragment is one contiguous 256-half run and each K16 step is +256.
        bool oobA, oobB;
        uint xA = c128_img_half_index(mA, 0u, wx, wy, oobA);
        uint xB = c128_img_half_index(mB, 0u, wx, wy, oobB);
        MAT_C accA0 = MAT_C(float16_t(0.0));
        MAT_C accA1 = MAT_C(float16_t(0.0));
        MAT_C accB0 = MAT_C(float16_t(0.0));
        MAT_C accB1 = MAT_C(float16_t(0.0));
        for (uint ki = 0u; ki < 8u; ++ki) {
            MAT_B wb0; coopMatLoad(wb0, pack, we + ((128u * g + n0) / 16u) * 8u * 256u + ki * 256u, 16u, LCOL);
            MAT_B wb1; coopMatLoad(wb1, pack, we + ((128u * g + n0 + 16u) / 16u) * 8u * 256u + ki * 256u, 16u, LCOL);
            MAT_A a = MAT_A(float16_t(0.0));
            if (!oobA) coopMatLoad(a, imgin, xA + 256u * ki, 16u, LROW);
            accA0 = coopMatMulAdd(a, wb0, accA0);
            accA1 = coopMatMulAdd(a, wb1, accA1);
            a = MAT_A(float16_t(0.0));
            if (!oobB) coopMatLoad(a, imgin, xB + 256u * ki, 16u, LROW);
            accB0 = coopMatMulAdd(a, wb0, accB0);
            accB1 = coopMatMulAdd(a, wb1, accB1);
        }
        {
            MAT_H values = MAT_H(accA0);
            if (debug)
                coopMatStore(values, dbg, 8192u + (mA) * 512u + 128u * g + n0 + 0u, 512u, LROW);
            for (int ci = 0; ci < values.length(); ++ci)
                values[ci] = c128_act_h(values[ci]);
            coopMatStore(values, shA, mA * 128u + n0 + 0u, 128u, LROW);
            if (debug)
                coopMatStore(values, dbg, 40960u + (mA) * 512u + 128u * g + n0 + 0u, 512u, LROW);
        }
        {
            MAT_H values = MAT_H(accA1);
            if (debug)
                coopMatStore(values, dbg, 8192u + (mA) * 512u + 128u * g + n0 + 16u, 512u, LROW);
            for (int ci = 0; ci < values.length(); ++ci)
                values[ci] = c128_act_h(values[ci]);
            coopMatStore(values, shA, mA * 128u + n0 + 16u, 128u, LROW);
            if (debug)
                coopMatStore(values, dbg, 40960u + (mA) * 512u + 128u * g + n0 + 16u, 512u, LROW);
        }
        {
            MAT_H values = MAT_H(accB0);
            if (debug)
                coopMatStore(values, dbg, 8192u + (mB) * 512u + 128u * g + n0 + 0u, 512u, LROW);
            for (int ci = 0; ci < values.length(); ++ci)
                values[ci] = c128_act_h(values[ci]);
            coopMatStore(values, shA, mB * 128u + n0 + 0u, 128u, LROW);
            if (debug)
                coopMatStore(values, dbg, 40960u + (mB) * 512u + 128u * g + n0 + 0u, 512u, LROW);
        }
        {
            MAT_H values = MAT_H(accB1);
            if (debug)
                coopMatStore(values, dbg, 8192u + (mB) * 512u + 128u * g + n0 + 16u, 512u, LROW);
            for (int ci = 0; ci < values.length(); ++ci)
                values[ci] = c128_act_h(values[ci]);
            coopMatStore(values, shA, mB * 128u + n0 + 16u, 128u, LROW);
            if (debug)
                coopMatStore(values, dbg, 40960u + (mB) * 512u + 128u * g + n0 + 16u, 512u, LROW);
        }
    }
    barrier();   // expand complete for all SGs; A visible

    // ---- act already applied in epilogue (A lives in shA) ----

    // ---- mid 64×32×128: Nc=2, Np=1; m0=8*sg, n0=0/16; output -> global M ----
    const uint wm = uint(pc.p3.y);
    {
        uint m0 = sg * 8u;
        MAT_C acc0 = MAT_C(float16_t(0.0));
        MAT_C acc1 = MAT_C(float16_t(0.0));
        for (uint ki = 0u; ki < 8u; ++ki) {
            uint k0 = ki * 16u;
            MAT_A a;  coopMatLoad(a, shA, m0 * 128u + k0, 128u, LROW);
            MAT_B b0; coopMatLoad(b0, pack, wm + (32u * g) * 128u + k0,
                                  128u, LCOL);
            MAT_B b1; coopMatLoad(b1, pack, wm + (32u * g + 16u) * 128u + k0,
                                  128u, LCOL);
            acc0 = coopMatMulAdd(a, b0, acc0);
            acc1 = coopMatMulAdd(a, b1, acc1);
        }
        // R09: the completed fp16 accumulator goes straight to its global
        // position, exactly as C64 already does.  No float staging, no shared
        // round trip, no subgroup barrier pair per accumulator.
        // n24 fold: store each 8x16 tile contiguously (row stride 16 halves) at
        // the consumer's A-tile position; the debug mirrors keep the old stride.
        MAT_H narrowed = MAT_H(acc0);
        coopMatStore(narrowed, gM, (w * 64u + m0) * 128u + 256u * g, 16u, LROW);
        if (debug)
            coopMatStore(narrowed, dbg, 73728u + m0 * 128u + 32u * g, 128u, LROW);
        narrowed = MAT_H(acc1);
        coopMatStore(narrowed, gM, (w * 64u + m0) * 128u + 256u * g + 128u, 16u, LROW);
        if (debug)
            coopMatStore(narrowed, dbg, 73728u + m0 * 128u + 32u * g + 16u, 128u, LROW);
    }
}
