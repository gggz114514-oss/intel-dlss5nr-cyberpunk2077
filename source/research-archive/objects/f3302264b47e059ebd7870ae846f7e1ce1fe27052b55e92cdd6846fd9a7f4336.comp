// F3-C256 fused candidate (f3-c256-fused-half-patch-v1, layout/fusion resume-fix 2026-10-16).
// Base: the bound pass-82 body c256_d4_epi_only.comp (sha256 808d203638539fdf, byte-identical raw compile)
// verbatim, plus the pass-83 downsample epilogue inlined at the end.
// Weight contract (v2, audit reports/19 section 3): the bound pass-83 kernel
// ds-f19-paired.spv loads the 16x16 blocked form
//   woff = whalf + ((n/16)*(K/16) + k/16)*256, stride 16, ColumnMajor,
// not the baseline source's n*K + k with stride K.  The four B loads below use
// the bound form.  v1 used the baseline form (see build-receipt.json).
// Body window geometry, token geometry, global stores and push words
// 0..20/27/30/31 are preserved; the DS fields use words 21..26/28..29.
// C256 D4 cooperative seed/output;original A/B layout: original seed-before-K math and two-accumulator ownership.
//
// ===========================================================================
// DSH R11 (F3-C256 `c2_S19_fused_c256_body_ds`): BOTH matrix stages become INT8.
//
//   * **WO** = the front-end output projection of `nr_body_stage`
//     (K = 256 = context channels, N = 256, 2 static MulAdd sites, 8x16x16
//     fp16 -> f32, 8 j iterations).  A = `shT` (a workgroup-private half copy
//     of this window's 64 x 256 context tile), B = the module's own `pack`
//     (binding 0) at `wo + n0*256 + k0`, stride 256, LCOL -- i.e. the plain
//     `n*256 + k` form, unlike C64/C128's `(n/16)*(K/16)*256` blocked form.
//   * **DS** = the post-pool down-sample projection in `main`
//     (`acc = mean tile x W_ds^T`, K = 256, N = 512, 4 static sites, 2 rounds).
//     A = `nrf_mean`, the pooled 2x2 tile; B = `nrf_w` (binding 8) at
//     `whalf + ((n/16)*(K/16) + k/16)*256`, stride 16, LCOL.
//
// Both become signed int8 A/B with an INT32 accumulator; the pooling tree, the
// half residual seed, the `precise` qualifiers, the single half narrowing per
// output element and all store streams are the parent's.
//
// SHARED-MEMORY OBSTACLE AND HOW IT IS RESOLVED (declared SPIR-V bytes only).
// The parent declares 45056 B of shared: nrf_pair 4096 + nrf_mean 8192 +
// shT 32768, out of the 49152 B static ceiling.  A 64 x 256 int8 context tile
// (16384 B) cannot be *added*.  `shT` exists for exactly two reasons -- as the
// WO A operand and as the source of the debug echo -- so it is **re-declared as
// the int8 staging tile itself** (`sT8[16384]`, same element count, 1 byte per
// element instead of 2).  That frees 16384 B instead of consuming it, and the
// debug echo (the only other reader) now reads `gT` directly: identical values,
// because the parent fills shT from gT and never writes either.  Net declared
// shared: 16384 + 8192 (nrf_mean) + 8192 (nrf_mean8) + 4096 (nrf_pair)
// + 1024 (shMax) + 8 (shScale) = 37896 B, i.e. 7160 B *below* the parent.
//
// ACTIVATION DOMAINS (explicit, not implied):
//   * WO activation domain = **pre-pool**: `gT[w*16384 .. +16384]`, the 64
//     tokens x 256 channels this workgroup multiplies; quantised once per
//     workgroup from its own amax, in-kernel, no capture and no calibration.
//   * DS activation domain = **post-pool**: `nrf_mean`, the pooled tile, whose
//     parent-text writer is unchanged and whose values are quantised exactly
//     once afterwards.  Pooling stays fp16.
//
// WEIGHT PACKS (new, binding 10..13; the fp16 packs stay bound and unread):
//   * `gWo8`   int8 256x256 = 65536 B, I8B K32 layout
//     idx(n,k) = (n/16)*(K/32)*512 + (k/32)*512 + (n%16)*32 + (k%32)
//   * `gWosc`  f32 256 per-output-channel scales
//   * `gDs8`   int8 512x256 = 131072 B, same formula, whalf folded into the pack
//   * `gDssc`  f32 512 per-output-channel scales
// Dequantisation is folded once per output element:
// value = int32_acc * (s_act * s_w[n]), then one half narrowing.
//
// DSH R11, CPU-only evidence.  No GPU was used to produce this file.
// ===========================================================================
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_8bit_storage : require

layout(local_size_x = 256) in;
// diagnostics: NR_D4_SEED_ONLY / NR_D4_MMA_ONLY isolate the two O components
#ifndef NR_D4_MODE
#define NR_D4_MODE 0   // 0 = full, 1 = seed only, 2 = mma only
#endif
// The K this module is built for: PASS 22 pushes p6.x = 256 (K), p5.w = 512 (N).
#define K_THIS 256u
#define N_THIS 512u

shared float16_t nrf_pair[8*256];
// The pooled tile: parent type, parent writer, now the staging for the single
// post-pool quantisation.
shared float16_t nrf_mean[16*256];
#include "c256_common.glsl"

layout(set = 0, binding = 6) buffer YBuf { float16_t gY[]; };
layout(set = 0, binding = 7) buffer TBuf { float16_t gT[]; };
// kept verbatim: still declared, no longer read by the INT8 DS
layout(set = 0, binding = 8) buffer DsWeightBuf { float16_t nrf_w[]; };
layout(set = 0, binding = 9) buffer DsOutBuf { float16_t nrf_o[]; };
// R11: INT8 WO tiles, K32 blocked (256 out x 256 in = 65536 B)
layout(set = 0, binding = 10) readonly buffer Wo8Buf { int8_t gWo8[]; };
// R11: WO per-output-channel scales (256 f32)
layout(set = 0, binding = 11) readonly buffer WoScaleBuf { float gWosc[]; };
// R11: INT8 DS tiles, K32 blocked (512 out x 256 in = 131072 B), whalf folded out
layout(set = 0, binding = 12) readonly buffer Ds8Buf { int8_t gDs8[]; };
// R11: DS per-output-channel scales (512 f32)
layout(set = 0, binding = 13) readonly buffer DsScaleBuf { float gDssc[]; };

// The parent's `shT[16384]` (32768 B of half) is re-declared here as the int8
// WO staging tile: element (token t, channel k) at ((t/32)*256 + k)*32 + (t%32),
// the measured I8A column-major stride-32 layout.  16384 B instead of 32768 B.
shared int8_t sT8[16384];
// Post-pool INT8 operand: element (slot s, channel k) at k*32 + s, 256*32 B.
shared int8_t nrf_mean8[K_THIS * 32u];
shared float shMax[256];
shared float shScale[2];

#define MAT_H coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>
// R11 operand types: the measured SG32 I8A/I8B/I8C combination (8x32 A,
// 32x16 B, 8x16 i32 accumulator) the C64 sibling already ships.
#define I8A coopmat<int8_t, gl_ScopeSubgroup, 8, 32, gl_MatrixUseA>
#define I8B coopmat<int8_t, gl_ScopeSubgroup, 32, 16, gl_MatrixUseB>
#define I8C coopmat<int, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>

void nr_body_stage() {
    const uint t_local = gl_LocalInvocationID.x;
    const uint sg = t_local / 32u;
    const uint lane = t_local % 32u;
    const uint wx = (pc.p1.z != 0) ? uint(pc.p2.x) : gl_WorkGroupID.x;
    const uint wy = (pc.p1.z != 0) ? uint(pc.p2.y) : gl_WorkGroupID.y;
    const uint w = wy * uint(pc.p1.x) + wx;
    const bool debug = pc.p1.w != 0;
    const uint wo = uint(pc.p4.x);
    const uint ars = uint(pc.p4.z);   // p4.y is rs (used by D2) — ars is p4.z

    // ---- R11 WO activation quantiser (PRE-POOL domain) --------------------
    // The parent first copies all 16384 halfs of gT into shT; that copy is not
    // needed any more because the staging tile *is* the int8 tile.  Both passes
    // below read the same gT half values the fp16 arm multiplies.
    {
        float amax = 0.0;
        for (uint e = t_local; e < 16384u; e += 256u)
            amax = max(amax, abs(float(gT[w * 16384u + e])));
        shMax[t_local] = amax;
    }
    barrier();
    if (t_local == 0u) {
        float m = 0.0;
        for (uint i = 0u; i < 256u; ++i) m = max(m, shMax[i]);
        precise float inv = (m > 0.0) ? 127.0 / m : 0.0;
        precise float sC  = (m > 0.0) ? m / 127.0 : 0.0;
        shScale[0] = inv;
        shScale[1] = sC;
    }
    barrier();
    const float invC = shScale[0];
    const float sC = shScale[1];
    for (uint e = t_local; e < 16384u; e += 256u) {
        const uint t = e >> 8u;
        const uint k = e & 255u;
        sT8[((t >> 5u) * 256u + k) * 32u + (t & 31u)] =
            int8_t(clamp(roundEven(float(gT[w * 16384u + e]) * invC), -127.0, 127.0));
    }
    barrier();
    if (debug) {
        // The parent echoed shT here; shT is now sT8, so the echo reads the
        // source it was filled from.  Same bytes: gT is read-only in this
        // module and the parent's copy was verbatim.
        for (uint e = t_local; e < 16384u; e += 256u) {
            dbg[425984u + e] = gT[w * 16384u + e];
        }
        barrier();
    }

    for (uint j = 0u; j < 8u; ++j) {
        uint m0 = (sg / 8u + 1u * j) * 8u;
        uint n0 = (sg % 8u) * 32u;
        I8C acc0, acc1;
        acc0 = I8C(0);
        acc1 = I8C(0);
        MAT_H scale0, scale1;
        coopMatLoad(scale0, pack, ars + n0, 0u, LROW);
        coopMatLoad(scale1, pack, ars + (n0 + 16u), 0u, LROW);
        for (uint ki = 0u; ki < 8u; ++ki) {
            const uint k0 = ki * 32u;
            I8A a;
            coopMatLoad(a, sT8, (m0 / 32u) * 8192u + k0 * 32u + (m0 % 32u), 32u, LCOL);
            I8B b0, b1;
            coopMatLoad(b0, gWo8, (n0 / 16u) * 4096u + ki * 512u, 32u, LCOL);
            coopMatLoad(b1, gWo8, ((n0 + 16u) / 16u) * 4096u + ki * 512u, 32u, LCOL);
#if NR_D4_MODE != 1
            acc0 = coopMatMulAdd(a, b0, acc0);
            acc1 = coopMatMulAdd(a, b1, acc1);
#endif
        }
        // ---- R11 INT8 WO epilogue ----------------------------------------
        {
            MAT_H seed;
            coopMatLoad(seed, gY, (w * 64u + m0) * 256u + n0, 256u, LROW);
            seed = seed * scale0;
#if NR_D4_MODE == 2
            MAT_C seedc = MAT_C(0.0);
#else
            MAT_C seedc = MAT_C(seed);
#endif
            MAT_C fsc;
            coopMatLoad(fsc, gWosc, n0, 0u, LROW);
            fsc = fsc * MAT_C(sC);
            precise MAT_C prod = MAT_C(acc0) * fsc;
            precise MAT_C sumv = prod + seedc;
            MAT_H narrowed = MAT_H(sumv);
            if (debug)
                coopMatStore(narrowed, dbg, 442368u + m0 * 256u + n0, 256u, LROW);
            bool oob;
            uint addr = c256_img_half_index(m0, n0, wx, wy, oob);
            if (!oob)
                coopMatStore(narrowed, imgout, addr, 16u, LROW);
            coopMatStore(narrowed, nrf_pair, (sg * 2u + 0u) * 128u, 16u, LROW);
        }
        {
            MAT_H seed;
            coopMatLoad(seed, gY, (w * 64u + m0) * 256u + (n0 + 16u), 256u, LROW);
            seed = seed * scale1;
#if NR_D4_MODE == 2
            MAT_C seedc = MAT_C(0.0);
#else
            MAT_C seedc = MAT_C(seed);
#endif
            MAT_C fsc;
            coopMatLoad(fsc, gWosc, n0 + 16u, 0u, LROW);
            fsc = fsc * MAT_C(sC);
            precise MAT_C prod = MAT_C(acc1) * fsc;
            precise MAT_C sumv = prod + seedc;
            MAT_H narrowed = MAT_H(sumv);
            if (debug)
                coopMatStore(narrowed, dbg, 442368u + m0 * 256u + (n0 + 16u), 256u, LROW);
            bool oob;
            uint addr = c256_img_half_index(m0, (n0 + 16u), wx, wy, oob);
            if (!oob)
                coopMatStore(narrowed, imgout, addr, 16u, LROW);
            coopMatStore(narrowed, nrf_pair, (sg * 2u + 1u) * 128u, 16u, LROW);
        }

        // ---- F3-C256 fused epilogue: mean of this j's two 2x2 blocks -------
        // j covers body tile q = j/2 with token half s = (j&1)*8, so the two
        // 2x2 pooled blocks of this fragment pair are at (dx, dy = j&1).
        subgroupBarrier();
        {
            const uint ch   = lane & 15u;
            const uint acc  = lane >> 4u;          // 0 -> channels 0..15, 1 -> 16..31
            const uint q    = j >> 1u;
            const uint sx1  = q & 1u;              // body tile X offset
            const uint sy1  = q >> 1u;             // body tile Y offset
            const uint dy   = j & 1u;
            const uint kk   = (sg % 8u) * 32u + acc * 16u + ch;   // global K index
            const uint base = (sg * 2u + acc) * 128u;
            for (uint dx = 0u; dx < 2u; ++dx) {
                const uint r0 = 2u * dx;           // fragment rows of the 2x2 block
                const uint px = 4u * wx + 2u * sx1 + dx;
                const int  py = 4 * int(wy) - 2 + 2 * int(sy1) + int(dy);
                const uint ly = 2u * (1u - sy1) + dy;
                const uint lx = 2u * sx1 + dx;
                precise float16_t v = float16_t(0);
                if (px < uint(pc.p7.x) && px < uint(pc.p5.y) &&
                    py >= 0 && uint(py) < uint(pc.p7.y) && uint(py) < uint(pc.p5.z)) {
                    precise float16_t a = nrf_pair[base + r0 * 16u + ch];
                    precise float16_t b = nrf_pair[base + (r0 + 1u) * 16u + ch];
                    precise float16_t cc = nrf_pair[base + (r0 + 4u) * 16u + ch];
                    precise float16_t dd = nrf_pair[base + (r0 + 5u) * 16u + ch];
                    precise float16_t top = a + b;
                    precise float16_t bottom = cc + dd;
                    precise float16_t sum = top + bottom;
                    v = sum * float16_t(0.25);
                }
                nrf_mean[(4u * ly + lx) * uint(pc.p6.x) + kk] = v;
            }
        }
        subgroupBarrier();
    }

    // ---- R11 POST-POOL quantisation (the one and only) --------------------
    // 16 slots x 256 channels are complete: every (slot, channel) pair has
    // exactly one owner across the 8 subgroups and the 8 j iterations above.
    barrier();
    {
        float amax = 0.0;
        for (uint e = t_local; e < 4096u; e += 256u)
            amax = max(amax, abs(float(nrf_mean[e])));
        shMax[t_local] = amax;
    }
    barrier();
    if (t_local == 0u) {
        float m = 0.0;
        for (uint i = 0u; i < 256u; ++i) m = max(m, shMax[i]);
        precise float inv = (m > 0.0) ? 127.0 / m : 0.0;
        precise float sD  = (m > 0.0) ? m / 127.0 : 0.0;
        shScale[0] = inv;
        shScale[1] = sD;
    }
    barrier();
    const float invD = shScale[0];
    for (uint e = t_local; e < 4096u; e += 256u) {
        const uint slot = e >> 8u;      // e = slot*K + k, K = 256
        const uint k    = e & 255u;
        nrf_mean8[k * 32u + slot] =
            int8_t(clamp(roundEven(float(nrf_mean[e]) * invD), -127.0, 127.0));
    }
    barrier();
}

// ---------------------------------------------------------------------------
// F3-C256 fusion scratch.
//   nrf_pair : per-subgroup staging for the body's two output fragments of one
//              j iteration (2 x 128 halfs, the fragments' own row-major image),
//              reused after the body for the projection store staging.
//   nrf_mean : the pooled tile, [16 slots][K] with stride K, the same image the
//              parent DS stages in its `a_half` (there: [8 pixels][K]).
// The address helper is a verbatim copy of ioport_common.glsl io_at().
// ---------------------------------------------------------------------------

uint nrf_ds_at(uint px,uint py,uint c,uint W,uint H,uint C,uint layout_id) {
    if(layout_id==2u)return (py*W+px)*C+c;
    if(layout_id==3u) {
        uint sub=(c&1u)|((c>>3u&1u)<<1u)|((c>>1u&1u)<<2u)|((c>>2u&1u)<<3u);
        return (c/16u)*(W*H*16u)+(py*W+px)*16u+sub;
    }
    uint t=layout_id==1u?py*W+px:((py/4u)*(W/4u)+px/4u)*16u+4u*(py%4u)+px%4u;
    return ((t/16u)*(C/16u)+c/16u)*256u+(t%16u)*16u+c%16u;
}

// parent DS's own output write pattern: stage the fragment in workgroup memory,
// then write one 16-channel group per lane group (lane%16 = channel inside the
// group, lane/16 = pooled pixel), which is what io_write() does in the bound
// pass-83 kernel.  Here the pooled pixels are the four columns of one patch row
// (four consecutive raster tokens, contiguous in layout 1).
void nrf_write_group(uint group, int px0i, int py0i, bool half_ok, uint OW, uint OH,
                     uint N, uint obase, uint sg, uint lane) {
    if (!half_ok) return;
    for (uint i = lane; i < 128u; i += 32u) {
        uint m = i >> 4u, c = i & 15u;
        uint px = uint(px0i) + (m & 3u);
        uint py = uint(py0i) + (m >> 2u);
        // C2 common layout0: block22_out is consumed by split16 b23 (81/82)
        // with the same 4x4-block-major supertile decode; OW/OH (44/24) are
        // multiples of 4, so io_at layout 0 is well-defined on the live grid.
        nrf_o[obase + nrf_ds_at(px, py, group * 16u + c, OW, OH, N, 0u)] =
            nrf_pair[sg * 256u + 128u + i];
    }
}

void main() {
    nr_body_stage();
    barrier();
    const uint tid  = gl_LocalInvocationID.x;
    const uint sg   = tid / 32u;
    const uint lane = tid % 32u;
    const uint wx = (pc.p1.z != 0u) ? uint(pc.p2.x) : gl_WorkGroupID.x;
    const uint wy = (pc.p1.z != 0u) ? uint(pc.p2.y) : gl_WorkGroupID.y;
    // fused DS fields: words 21..26 and 28..29, which the bound body SPV never
    // reads (it references only p0, p1.x/z/w, p2.x/y, p4.x, p4.z).
    const uint OW = uint(pc.p5.y), OH = uint(pc.p5.z), N = uint(pc.p5.w), K = uint(pc.p6.x);
    const uint obase = uint(pc.p6.z);      // pc.p6.y (whalf) is folded into gDs8
    const uint sy = sg & 1u;                 // pooled row half
    const uint cb = sg >> 1u;                // 128-output-channel block
    const uint rowbase = (sy == 0u) ? 8u : 0u;
    const int  px0 = 4 * int(wx);
    const int  py0 = 4 * int(wy) - 2 + 2 * int(sy);
    const bool half_ok = (px0 >= 0) && (px0 + 3 < int(OW)) &&
                         (py0 >= 0) && (py0 + 1 < int(OH));
    // post-pool activation scale, published by the quantiser above
    const float sD = shScale[1];
    for (uint rnd = 0u; rnd < 2u; ++rnd) {
        const uint nb0 = cb * 8u + rnd * 4u;      // 4 output-channel blocks of 16
        I8C acc0 = I8C(0);
        I8C acc1 = I8C(0);
        I8C acc2 = I8C(0);
        I8C acc3 = I8C(0);
        for (uint k = 0u; k < K; k += 32u) {
            I8A aa;
            coopMatLoad(aa, nrf_mean8, rowbase + k * 32u, 32u, LCOL);
            I8B bb;
            coopMatLoad(bb, gDs8, ((nb0 + 0u) * (K / 32u) + k / 32u) * 512u, 32u, LCOL);
            acc0 = coopMatMulAdd(aa, bb, acc0);
            coopMatLoad(bb, gDs8, ((nb0 + 1u) * (K / 32u) + k / 32u) * 512u, 32u, LCOL);
            acc1 = coopMatMulAdd(aa, bb, acc1);
            coopMatLoad(bb, gDs8, ((nb0 + 2u) * (K / 32u) + k / 32u) * 512u, 32u, LCOL);
            acc2 = coopMatMulAdd(aa, bb, acc2);
            coopMatLoad(bb, gDs8, ((nb0 + 3u) * (K / 32u) + k / 32u) * 512u, 32u, LCOL);
            acc3 = coopMatMulAdd(aa, bb, acc3);
        }
        // store each fragment through the parent's own shared-staging pattern:
        // lane%16 = channel inside the group, lane/16 = pooled pixel of the half.
        // One dequant per fragment: int32 acc * (sD * sDs[n]), then the parent's
        // single half narrowing.
        {
            MAT_C fsc;
            coopMatLoad(fsc, gDssc, nb0 * 16u, 0u, LROW);
            fsc = fsc * MAT_C(sD);
            precise MAT_C prod = MAT_C(acc0) * fsc;
            MAT_H h = MAT_H(prod);
            coopMatStore(h, nrf_pair, sg * 256u + 128u, 16u, gl_CooperativeMatrixLayoutRowMajor);
        }
        subgroupBarrier();
        nrf_write_group(nb0 + 0u, px0, py0, half_ok, OW, OH, N, obase, sg, lane);
        subgroupBarrier();
        {
            MAT_C fsc;
            coopMatLoad(fsc, gDssc, (nb0 + 1u) * 16u, 0u, LROW);
            fsc = fsc * MAT_C(sD);
            precise MAT_C prod = MAT_C(acc1) * fsc;
            MAT_H h = MAT_H(prod);
            coopMatStore(h, nrf_pair, sg * 256u + 128u, 16u, gl_CooperativeMatrixLayoutRowMajor);
        }
        subgroupBarrier();
        nrf_write_group(nb0 + 1u, px0, py0, half_ok, OW, OH, N, obase, sg, lane);
        subgroupBarrier();
        {
            MAT_C fsc;
            coopMatLoad(fsc, gDssc, (nb0 + 2u) * 16u, 0u, LROW);
            fsc = fsc * MAT_C(sD);
            precise MAT_C prod = MAT_C(acc2) * fsc;
            MAT_H h = MAT_H(prod);
            coopMatStore(h, nrf_pair, sg * 256u + 128u, 16u, gl_CooperativeMatrixLayoutRowMajor);
        }
        subgroupBarrier();
        nrf_write_group(nb0 + 2u, px0, py0, half_ok, OW, OH, N, obase, sg, lane);
        subgroupBarrier();
        {
            MAT_C fsc;
            coopMatLoad(fsc, gDssc, (nb0 + 3u) * 16u, 0u, LROW);
            fsc = fsc * MAT_C(sD);
            precise MAT_C prod = MAT_C(acc3) * fsc;
            MAT_H h = MAT_H(prod);
            coopMatStore(h, nrf_pair, sg * 256u + 128u, 16u, gl_CooperativeMatrixLayoutRowMajor);
        }
        subgroupBarrier();
        nrf_write_group(nb0 + 3u, px0, py0, half_ok, OW, OH, N, obase, sg, lane);
        subgroupBarrier();
    }
}
