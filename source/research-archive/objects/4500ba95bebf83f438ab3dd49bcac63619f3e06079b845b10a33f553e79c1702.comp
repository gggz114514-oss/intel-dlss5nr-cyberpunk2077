#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_float_e4m3 : require
layout(local_size_x=32) in;
layout(set=0,binding=0) buffer A { float a[]; };
layout(set=0,binding=1) buffer S { float s[]; };
void main() {
  coopmat<floate4m3_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> ma;
  ma = coopmatLoad(ma, s, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
  a[gl_GlobalInvocationID.x] = float(ma[0]);
}
