// c64_qx_producer.comp — one-time qX for C64 body1.
//
// Private family copy for VK-INT8-ZCODE-COVERAGE-FIRST-EXECUTION-V2 工单 B2.
// Input : the C64 canonical FP16 image (84x48 tiles x 4 channel groups x 16
//         slots), ((tile*4 + c/16)*256 + slot*16 + c%16), tile = ty*84+tx.
//         Blocks 5-8 feed block{4..7}_out; blocks 62-65 feed ioport_block6x_blend.
// Output: int8 token-major (tile*16 + slot)*64 + c, read by c64_d1/d2.
//
// One element per thread; no head/N duplication (one evaluation per element).
// Scale is 1/sX at sc[1]; clamp/round are the family template's
// clamp(roundEven(v*inv),-127,127).
#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_8bit_storage : require

layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer In { float16_t gx[]; };
layout(set = 0, binding = 1) readonly buffer Scales { float sc[]; };
layout(set = 0, binding = 2) buffer Out { int8_t qx[]; };
layout(push_constant) uniform PC { ivec4 p0; } pc;   // p0.x = tiles_x = 84

void main() {
    uint tile = gl_WorkGroupID.y * uint(pc.p0.x) + gl_WorkGroupID.x;
    float inv = sc[1];
    for (uint i = 0u; i < 4u; ++i) {
        uint e = gl_LocalInvocationID.x + 256u * i;   // 0..1023
        uint s = e / 64u, c = e % 64u;
        uint in_idx = ((tile * 4u + c / 16u) * 256u) + s * 16u + c % 16u;
        uint out_idx = tile * 1024u + s * 64u + c;
        float v = float(gx[in_idx]);
        qx[out_idx] = int8_t(clamp(roundEven(v * sc[464u+c]), -127.0, 127.0));
    }
}
