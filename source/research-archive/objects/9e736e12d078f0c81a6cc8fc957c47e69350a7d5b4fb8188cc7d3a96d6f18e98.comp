                }
                {
                    I8A wa;
                    a0 = I8C(0);
                    a1 = I8C(0);
                    coopMatLoad(wa, w8, 14336u, 32u, LCOL);
                    a0 = coopMatMulAdd(wa, xb8, a0);
                    coopMatLoad(wa, w8, 15360u, 32u, LCOL);
                    a1 = coopMatMulAdd(wa, xb8, a1);
                }
                {
                    NRH_C ec0 = nr_i8_deq(a0, 112u, C32_I8_MULT_E);
                    e2 = nrh_narrow(ec0);
                    e2[0] = nr_act_h(e2[0]);
                    e2[1] = nr_act_h(e2[1]);
                    e2[2] = nr_act_h(e2[2]);
