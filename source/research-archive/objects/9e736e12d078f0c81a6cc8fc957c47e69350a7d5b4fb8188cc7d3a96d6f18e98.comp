        {
            float16_t qn=norm_pair.x, kn=norm_pair.y;
            float16_t qr = q0[2] * qn;
            qr = qr * scalar0;
            q0[2] = qr;
            k0[2] = k0[2] * kn;
        }
        {
            float16_t qn=norm_pair.x, kn=norm_pair.y;
            float16_t qr = q0[3] * qn;
            qr = qr * scalar0;
            q0[3] = qr;
            k0[3] = k0[3] * kn;
        }
// T3 transport: identity materialize removed: q0 = nrh_materialize(q0);
// T3 transport: identity materialize removed: k0 = nrh_materialize(k0);
        if (debug) coopMatStore(q0, dbg, 10240u+t0*32u+0u, 32u, LCOL);
        if (debug) coopMatStore(k0, dbg, 12288u+t0*32u+0u, 32u, LCOL);
        qmx = nr_abs4(q0);
        kmx = nr_abs4(k0);
        {
            vec4 mv = nr_dim_max16(v0);
            if ((lane & 15u) == 0u) {
                for (int i = 0; i < 4; ++i) {
                    uvec2 rc = nrh_coord_CH(uint(i));
                    sVpm[sg * 32u + 0u + rc.x] = mv[i];
                }
            }
        }
        {
            float16_t qn=norm_pair.x, kn=norm_pair.y;
            float16_t qr = q1[0] * qn;
            qr = qr * scalar0;
            q1[0] = qr;
            k1[0] = k1[0] * kn;
        }
        {
            float16_t qn=norm_pair.x, kn=norm_pair.y;
            float16_t qr = q1[1] * qn;
            qr = qr * scalar0;
            q1[1] = qr;
            k1[1] = k1[1] * kn;
        }
        {
            float16_t qn=norm_pair.x, kn=norm_pair.y;
            float16_t qr = q1[2] * qn;
            qr = qr * scalar0;
            q1[2] = qr;
            k1[2] = k1[2] * kn;
        }
        {
            float16_t qn=norm_pair.x, kn=norm_pair.y;
            float16_t qr = q1[3] * qn;
            qr = qr * scalar0;
            q1[3] = qr;
            k1[3] = k1[3] * kn;
        }
// T3 transport: identity materialize removed: q1 = nrh_materialize(q1);
// T3 transport: identity materialize removed: k1 = nrh_materialize(k1);
        if (debug) coopMatStore(q1, dbg, 10240u+t0*32u+8u, 32u, LCOL);
        if (debug) coopMatStore(k1, dbg, 12288u+t0*32u+8u, 32u, LCOL);
        qmx = max(qmx, nr_abs4(q1));
        kmx = max(kmx, nr_abs4(k1));
        {
            vec4 mv = nr_dim_max16(v1);
            if ((lane & 15u) == 0u) {
                for (int i = 0; i < 4; ++i) {
                    uvec2 rc = nrh_coord_CH(uint(i));
                    sVpm[sg * 32u + 8u + rc.x] = mv[i];
                }
            }
        }
        {
            float16_t qn=norm_pair.x, kn=norm_pair.y;
            float16_t qr = q2[0] * qn;
            qr = qr * scalar0;
            q2[0] = qr;
            k2[0] = k2[0] * kn;
        }
        {
            float16_t qn=norm_pair.x, kn=norm_pair.y;
            float16_t qr = q2[1] * qn;
            qr = qr * scalar0;
            q2[1] = qr;
            k2[1] = k2[1] * kn;
        }
        {
            float16_t qn=norm_pair.x, kn=norm_pair.y;
            float16_t qr = q2[2] * qn;
            qr = qr * scalar0;
            q2[2] = qr;
            k2[2] = k2[2] * kn;
        }
        {
            float16_t qn=norm_pair.x, kn=norm_pair.y;
            float16_t qr = q2[3] * qn;
            qr = qr * scalar0;
            q2[3] = qr;
            k2[3] = k2[3] * kn;
        }
// T3 transport: identity materialize removed: q2 = nrh_materialize(q2);
// T3 transport: identity materialize removed: k2 = nrh_materialize(k2);
        if (debug) coopMatStore(q2, dbg, 10240u+t0*32u+16u, 32u, LCOL);
        if (debug) coopMatStore(k2, dbg, 12288u+t0*32u+16u, 32u, LCOL);
        qmx = max(qmx, nr_abs4(q2));
        kmx = max(kmx, nr_abs4(k2));
        {
            vec4 mv = nr_dim_max16(v2);
            if ((lane & 15u) == 0u) {
                for (int i = 0; i < 4; ++i) {
                    uvec2 rc = nrh_coord_CH(uint(i));
                    sVpm[sg * 32u + 16u + rc.x] = mv[i];
                }
            }
        }
        {
            float16_t qn=norm_pair.x, kn=norm_pair.y;
            float16_t qr = q3[0] * qn;
            qr = qr * scalar0;
            q3[0] = qr;
            k3[0] = k3[0] * kn;
        }
        {
            float16_t qn=norm_pair.x, kn=norm_pair.y;
            float16_t qr = q3[1] * qn;
            qr = qr * scalar0;
            q3[1] = qr;
            k3[1] = k3[1] * kn;
        }
        {
            float16_t qn=norm_pair.x, kn=norm_pair.y;
            float16_t qr = q3[2] * qn;
            qr = qr * scalar0;
            q3[2] = qr;
            k3[2] = k3[2] * kn;
        }
        {
            float16_t qn=norm_pair.x, kn=norm_pair.y;
            float16_t qr = q3[3] * qn;
            qr = qr * scalar0;
            q3[3] = qr;
            k3[3] = k3[3] * kn;
        }
// T3 transport: identity materialize removed: q3 = nrh_materialize(q3);
// T3 transport: identity materialize removed: k3 = nrh_materialize(k3);
        if (debug) coopMatStore(q3, dbg, 10240u+t0*32u+24u, 32u, LCOL);
        if (debug) coopMatStore(k3, dbg, 12288u+t0*32u+24u, 32u, LCOL);
        qmx = max(qmx, nr_abs4(q3));
        kmx = max(kmx, nr_abs4(k3));
        {
            vec4 mv = nr_dim_max16(v3);
            if ((lane & 15u) == 0u) {
                for (int i = 0; i < 4; ++i) {
                    uvec2 rc = nrh_coord_CH(uint(i));
                    sVpm[sg * 32u + 24u + rc.x] = mv[i];
                }
            }
        }
