        nr_i8_put_p(p4, 32u, sg * 1024u, ipy);
        nr_i8_put_p(p5, 40u, sg * 1024u, ipy);
        nr_i8_put_p(p6, 48u, sg * 1024u, ipy);
        nr_i8_put_p(p7, 56u, sg * 1024u, ipy);
        // P is consumed by the owning subgroup only (its own 16 queries).
        subgroupMemoryBarrierShared();
        subgroupBarrier();
        // ---- PV: 8 int8 K32 steps (was 16 FP16 K16 steps) -------------------
        // Ctx^T[dim,query] = V^T[dim,key] * P^T[key,query]; the two 32-key slices
        // accumulate into the SAME int32 fragments, so this is one exact K64 dot
        // product and the dequant is a single rank-1 multiply per component:
        // sV[dim] * sP[query].
        NRH_C tc0 = NRH_C(0.0);
        NRH_C tc1 = NRH_C(0.0);
        NRH_C tc2 = NRH_C(0.0);
        NRH_C tc3 = NRH_C(0.0);
        {
            I8C i0 = I8C(0);
            I8C i1 = I8C(0);
            I8C i2 = I8C(0);
            I8C i3 = I8C(0);
            I8A va;
            I8B pb8;
            // key slice 0: keys 0..31 (parent K16 blocks 0 and 1)
            coopMatLoad(pb8, sP8, sg * 1024u + 0u, 64u, LCOL);
            coopMatLoad(va, sV8, 0u, 32u, LCOL);
            i0 = coopMatMulAdd(va, pb8, i0);
            coopMatLoad(va, sV8, 8u, 32u, LCOL);
            i1 = coopMatMulAdd(va, pb8, i1);
            coopMatLoad(va, sV8, 16u, 32u, LCOL);
            i2 = coopMatMulAdd(va, pb8, i2);
            coopMatLoad(va, sV8, 24u, 32u, LCOL);
            i3 = coopMatMulAdd(va, pb8, i3);
            // key slice 1: keys 32..63 (parent K16 blocks 2 and 3)
            coopMatLoad(pb8, sP8, sg * 1024u + 32u, 64u, LCOL);
            coopMatLoad(va, sV8, 1024u, 32u, LCOL);
            i0 = coopMatMulAdd(va, pb8, i0);
            coopMatLoad(va, sV8, 1032u, 32u, LCOL);
            i1 = coopMatMulAdd(va, pb8, i1);
            coopMatLoad(va, sV8, 1040u, 32u, LCOL);
            i2 = coopMatMulAdd(va, pb8, i2);
            coopMatLoad(va, sV8, 1048u, 32u, LCOL);
            i3 = coopMatMulAdd(va, pb8, i3);
            tc0 = nr_i8_deq_v(i0, nr_v_scale(0u), psy);
            tc1 = nr_i8_deq_v(i1, nr_v_scale(1u), psy);
            tc2 = nr_i8_deq_v(i2, nr_v_scale(2u), psy);
            tc3 = nr_i8_deq_v(i3, nr_v_scale(3u), psy);
        }
        NRH_CH ctx0 = nrh_narrow(tc0);
        if (debug) coopMatStore(ctx0, dbg, 18432u+t0*32u+0u, 32u, LCOL);
        NRH_CH ctx1 = nrh_narrow(tc1);
        if (debug) coopMatStore(ctx1, dbg, 18432u+t0*32u+8u, 32u, LCOL);
        NRH_CH ctx2 = nrh_narrow(tc2);
        if (debug) coopMatStore(ctx2, dbg, 18432u+t0*32u+16u, 32u, LCOL);
        NRH_CH ctx3 = nrh_narrow(tc3);
        if (debug) coopMatStore(ctx3, dbg, 18432u+t0*32u+24u, 32u, LCOL);
        // ---- Ctx quantised per query ---------------------------------------
        const float cmx = nr_col_max32(ctx0, ctx1, ctx2, ctx3);
        const float csy = (cmx > 0.0) ? (cmx * (1.0 / 127.0)) : 0.0;
        const float icy = (cmx > 0.0) ? (127.0 / cmx) : 0.0;
        nr_i8_put_y(ctx0, 0u, sg * 512u, icy);
        nr_i8_put_y(ctx1, 8u, sg * 512u, icy);
        nr_i8_put_y(ctx2, 16u, sg * 512u, icy);
        nr_i8_put_y(ctx3, 24u, sg * 512u, icy);
        // ---- output projection: 4 int8 K32 steps (was 8 FP16 K16 steps) ----
        // O^T[ch,query] = WO[ch,dim] * Ctx^T[dim,query]; the residual seed
        // H(Y*ars) is the parent's, added once in f32 after the integer dot.
        NRH_C oc0;
        {
            NRH_CH scale;
            coopMatLoad(scale,wb,uint(pc.p2.y)+0u,0u,LCOL);
            NRH_CH seed = y0 * scale;
            oc0 = nrh_widen_exact(seed);
        }
        NRH_C oc1;
        {
            NRH_CH scale;
            coopMatLoad(scale,wb,uint(pc.p2.y)+8u,0u,LCOL);
            NRH_CH seed = y1 * scale;
            oc1 = nrh_widen_exact(seed);
        }
        NRH_C oc2;
        {
            NRH_CH scale;
            coopMatLoad(scale,wb,uint(pc.p2.y)+16u,0u,LCOL);
            NRH_CH seed = y2 * scale;
            oc2 = nrh_widen_exact(seed);
        }
        NRH_C oc3;
        {
            NRH_CH scale;
            coopMatLoad(scale,wb,uint(pc.p2.y)+24u,0u,LCOL);
            NRH_CH seed = y3 * scale;
            oc3 = nrh_widen_exact(seed);
        }
        {
            I8B cb8;
            coopMatLoad(cb8, sT8, sg * 512u, 32u, LCOL);
            I8A wo;
            I8C oa;
            oa = I8C(0);
            coopMatLoad(wo, w8, C32_I8_WO + 0u*1024u, 32u, LCOL);
            oa = coopMatMulAdd(wo, cb8, oa);
            // M12: narrow o0 immediately; the accumulator dies here.
            NRH_CH o0 = nrh_narrow(nr_i8_deq_add_w(oa, 0u, C32_I8_DQ_O, csy, oc0));
            if (debug) coopMatStore(o0,dbg,20480u+t0*32u+0u,32u,LCOL);
            oa = I8C(0);
            coopMatLoad(wo, w8, C32_I8_WO + 1u*1024u, 32u, LCOL);
            oa = coopMatMulAdd(wo, cb8, oa);
            NRH_CH o1 = nrh_narrow(nr_i8_deq_add_w(oa, 8u, C32_I8_DQ_O, csy, oc1));
            if (debug) coopMatStore(o1,dbg,20480u+t0*32u+8u,32u,LCOL);
            oa = I8C(0);
            coopMatLoad(wo, w8, C32_I8_WO + 2u*1024u, 32u, LCOL);
            oa = coopMatMulAdd(wo, cb8, oa);
            NRH_CH o2 = nrh_narrow(nr_i8_deq_add_w(oa, 16u, C32_I8_DQ_O, csy, oc2));
            if (debug) coopMatStore(o2,dbg,20480u+t0*32u+16u,32u,LCOL);
            oa = I8C(0);
            coopMatLoad(wo, w8, C32_I8_WO + 3u*1024u, 32u, LCOL);
            oa = coopMatMulAdd(wo, cb8, oa);
            NRH_CH o3 = nrh_narrow(nr_i8_deq_add_w(oa, 24u, C32_I8_DQ_O, csy, oc3));
            if (debug) coopMatStore(o3,dbg,20480u+t0*32u+24u,32u,LCOL);
            uint o_base0=tok_base+0u;
            if (!tok_oob_u) coopMatStore(o0,imgout,o_base0,16u,LCOL);
            uint o_base1=tok_base+8u;
            if (!tok_oob_u) coopMatStore(o1,imgout,o_base1,16u,LCOL);
            uint o_base2=tok_base+256u;
            if (!tok_oob_u) coopMatStore(o2,imgout,o_base2,16u,LCOL);
            uint o_base3=tok_base+264u;
            if (!tok_oob_u) coopMatStore(o3,imgout,o_base3,16u,LCOL);
        }
    }
}
