                I8B eb8 = c2_i8_join_B(c2_i8_pack_c(e0, 96u), c2_i8_pack_c(e1, 104u),
                                       c2_i8_pack_c(e2, 112u), c2_i8_pack_c(e3, 120u));
                {
                    I8A wa;
                    coopMatLoad(wa, w8, 16384u + (0u*4u+3u)*1024u, 32u, LCOL);
                    ca0 = coopMatMulAdd(wa, eb8, ca0);
                    coopMatLoad(wa, w8, 16384u + (1u*4u+3u)*1024u, 32u, LCOL);
                    ca1 = coopMatMulAdd(wa, eb8, ca1);
                    coopMatLoad(wa, w8, 16384u + (2u*4u+3u)*1024u, 32u, LCOL);
                    ca2 = coopMatMulAdd(wa, eb8, ca2);
                    coopMatLoad(wa, w8, 16384u + (3u*4u+3u)*1024u, 32u, LCOL);
