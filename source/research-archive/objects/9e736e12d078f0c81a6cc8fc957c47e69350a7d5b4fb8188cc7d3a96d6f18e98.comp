                    e3[0] = nr_act_h(e3[0]);
                    e3[1] = nr_act_h(e3[1]);
                    e3[2] = nr_act_h(e3[2]);
                    e3[3] = nr_act_h(e3[3]);
                    if (debug) coopMatStore(e3, dbg, t0*128u+120u, 128u, LCOL);
                }
