        }
        yc0 = nr_i8_deq_add(ca0, 0u, C32_I8_MULT_C, seed0);
        yc1 = nr_i8_deq_add(ca1, 8u, C32_I8_MULT_C, seed1);
        yc2 = nr_i8_deq_add(ca2, 16u, C32_I8_MULT_C, seed2);
        yc3 = nr_i8_deq_add(ca3, 24u, C32_I8_MULT_C, seed3);
        y0 = nrh_narrow(yc0);
        if (debug) coopMatStore(y0, dbg, 8192u+t0*32u+0u, 32u, LCOL);
        y1 = nrh_narrow(yc1);
        if (debug) coopMatStore(y1, dbg, 8192u+t0*32u+8u, 32u, LCOL);
        y2 = nrh_narrow(yc2);
        if (debug) coopMatStore(y2, dbg, 8192u+t0*32u+16u, 32u, LCOL);
        y3 = nrh_narrow(yc3);
        if (debug) coopMatStore(y3, dbg, 8192u+t0*32u+24u, 32u, LCOL);
        // ==================== C32 body_1 unified INT8 tail ==================
        // This card's change.  Everything below the contract row Y is the
        // R02 segment contracts (QKV, QK, PV, output) implemented on C2's
        // register-staged K32 data path: 64 static FP16 matrix multiplies become
        // 12 + 8 + 8 + 4 = 32 static INT8 matrix multiplies.
        //   QKV 24 -> 12, QK 16 -> 8, PV 16 -> 8, output 8 -> 4.
        // Operands are signed int8 (A 8x32, B 32x16), accumulators int32, one
        // rank-1 f32 dequant per output element, one narrow per output fragment.
        NRH_CH k0;
        NRH_CH k1;
        NRH_CH k2;
        NRH_CH k3;
        {
            // ---- QKV: 12 int8 K32 steps (was 24 FP16 K16 steps) ------------
            // Y is the A-side activation of all three projections, so it is
            // quantised once per token from the rounded halves themselves; the
            // largest code of a token is therefore exactly 127 and the clamp
            // never removes information.
            const float ymx = nr_col_max32(y0, y1, y2, y3);
            const float sy = (ymx > 0.0) ? (ymx * (1.0 / 127.0)) : 0.0;
            const float iy = (ymx > 0.0) ? (127.0 / ymx) : 0.0;
            nr_i8_put_y(y0, 0u, sg * 512u, iy);
            nr_i8_put_y(y1, 8u, sg * 512u, iy);
            nr_i8_put_y(y2, 16u, sg * 512u, iy);
            nr_i8_put_y(y3, 24u, sg * 512u, iy);
            subgroupMemoryBarrierShared();
            subgroupBarrier();
            I8B yb8;
            coopMatLoad(yb8, sT8, sg * 512u, 32u, LCOL);
            I8A wa;
            I8C za;
            // Q: output channels 0..31 over the 32 contract channels, K=32 once.
            za = I8C(0);
            coopMatLoad(wa, w8, C32_I8_WQ + 0u*1024u, 32u, LCOL);
            za = coopMatMulAdd(wa, yb8, za);
            q0 = nrh_narrow(nr_i8_deq_w(za, 0u, C32_I8_DQ_Q, sy));
            za = I8C(0);
            coopMatLoad(wa, w8, C32_I8_WQ + 1u*1024u, 32u, LCOL);
            za = coopMatMulAdd(wa, yb8, za);
            q1 = nrh_narrow(nr_i8_deq_w(za, 8u, C32_I8_DQ_Q, sy));
            za = I8C(0);
            coopMatLoad(wa, w8, C32_I8_WQ + 2u*1024u, 32u, LCOL);
            za = coopMatMulAdd(wa, yb8, za);
            q2 = nrh_narrow(nr_i8_deq_w(za, 16u, C32_I8_DQ_Q, sy));
            za = I8C(0);
            coopMatLoad(wa, w8, C32_I8_WQ + 3u*1024u, 32u, LCOL);
            za = coopMatMulAdd(wa, yb8, za);
            q3 = nrh_narrow(nr_i8_deq_w(za, 24u, C32_I8_DQ_Q, sy));
            // K: identical shape, its own weight tiles and channel scales.
            za = I8C(0);
            coopMatLoad(wa, w8, C32_I8_WK + 0u*1024u, 32u, LCOL);
            za = coopMatMulAdd(wa, yb8, za);
            k0 = nrh_narrow(nr_i8_deq_w(za, 0u, C32_I8_DQ_K, sy));
            za = I8C(0);
            coopMatLoad(wa, w8, C32_I8_WK + 1u*1024u, 32u, LCOL);
            za = coopMatMulAdd(wa, yb8, za);
            k1 = nrh_narrow(nr_i8_deq_w(za, 8u, C32_I8_DQ_K, sy));
            za = I8C(0);
            coopMatLoad(wa, w8, C32_I8_WK + 2u*1024u, 32u, LCOL);
            za = coopMatMulAdd(wa, yb8, za);
            k2 = nrh_narrow(nr_i8_deq_w(za, 16u, C32_I8_DQ_K, sy));
            za = I8C(0);
            coopMatLoad(wa, w8, C32_I8_WK + 3u*1024u, 32u, LCOL);
            za = coopMatMulAdd(wa, yb8, za);
            k3 = nrh_narrow(nr_i8_deq_w(za, 24u, C32_I8_DQ_K, sy));
            // V: identical shape; V never passes through the norm below.
            za = I8C(0);
            coopMatLoad(wa, w8, C32_I8_WV + 0u*1024u, 32u, LCOL);
            za = coopMatMulAdd(wa, yb8, za);
            v0 = nrh_narrow(nr_i8_deq_w(za, 0u, C32_I8_DQ_V, sy));
            za = I8C(0);
            coopMatLoad(wa, w8, C32_I8_WV + 1u*1024u, 32u, LCOL);
            za = coopMatMulAdd(wa, yb8, za);
            v1 = nrh_narrow(nr_i8_deq_w(za, 8u, C32_I8_DQ_V, sy));
            za = I8C(0);
            coopMatLoad(wa, w8, C32_I8_WV + 2u*1024u, 32u, LCOL);
            za = coopMatMulAdd(wa, yb8, za);
            v2 = nrh_narrow(nr_i8_deq_w(za, 16u, C32_I8_DQ_V, sy));
            za = I8C(0);
            coopMatLoad(wa, w8, C32_I8_WV + 3u*1024u, 32u, LCOL);
            za = coopMatMulAdd(wa, yb8, za);
            v3 = nrh_narrow(nr_i8_deq_w(za, 24u, C32_I8_DQ_V, sy));
        }
        // Norm and reciprocal are per token; no subgroupAdd or alternate tree.
        f16vec2 norm_pair=nr_norm32_pair(q0,q1,q2,q3,k0,k1,k2,k3);
        float16_t scalar0 = float16_t(fb[uint(pc.p2.z)]);
        // Per-token |Q| and |K| maxima and the per-dimension |V| maxima are
        // accumulated as the four fragments pass through the parent's norm
        // scaling, so no second pass over the values is needed.
        float qmx = 0.0;
        float kmx = 0.0;
        {
            float16_t qn=norm_pair.x, kn=norm_pair.y;
            float16_t qr = q0[0] * qn;
            qr = qr * scalar0;
            q0[0] = qr;
            k0[0] = k0[0] * kn;
        }
        {
            float16_t qn=norm_pair.x, kn=norm_pair.y;
            float16_t qr = q0[1] * qn;
            qr = qr * scalar0;
            q0[1] = qr;
            k0[1] = k0[1] * kn;
